{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua"
  ],
  "workspace.library": [
    "${env:VIMRUNTIME}/lua",
    "${3rd}/luv/library",
    "${env:HOME}/.vim/vendor/git/worktrees/blink.cmp/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/conform.nvim/lua",
    "${env:HOME}/.vim/vendor/plugins/cybu.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/flash.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/fff/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/lazy.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/lean.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/nvim-ts-autotag/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/nvim-treesitter/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/plenary.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/snacks.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/treesj/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/which-key.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/zen-mode.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/nvim-lspconfig/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/none-ls.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/telescope.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/lualine.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/telescope-ui-select.nvim/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/neogen/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/nvim-gtd/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/vim-matchup/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/nvim-autopairs/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/mini.ai/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/mini.align/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/mini.base16/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/mini.bufremove/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/mini.hipatterns/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/mini.surround/lua",
    "${env:HOME}/.vim/vendor/git/worktrees/LuaSnip/lua",
    "${env:HOME}/.vim/vendor/plugins/Comment.nvim/lua",
    "${env:HOME}/.vim/vendor/plugins/nvim-ts-context-commentstring/lua"
  ],
  "workspace.ignoreDir": [
    ".firecrawl",
    ".git",
    ".venv",
    "tmp"
  ],
  "diagnostics.globals": [
    "vim",
    "describe",
    "it",
    "pending",
    "before_each",
    "after_each",
    "assert"
  ],
  "diagnostics.disable": [
    "deprecated"
  ],
  "telemetry.enable": false
}
