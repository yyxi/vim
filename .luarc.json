{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "runtime.path": ["lua/?.lua", "lua/?/init.lua"],
  "workspace.library": [
    "${env:VIMRUNTIME}/lua",
    "${3rd}/luv/library",
    "${env:HOME}/.vim/vendor/blink.cmp/lua",
    "${env:HOME}/.vim/vendor/Comment.nvim/lua",
    "${env:HOME}/.vim/vendor/conform.nvim/lua",
    "${env:HOME}/.vim/vendor/cybu.nvim/lua",
    "${env:HOME}/.vim/vendor/flash.nvim/lua",
    "${env:HOME}/.vim/vendor/lean.nvim/lua",
    "${env:HOME}/.vim/vendor/nvim-ts-autotag/lua",
    "${env:HOME}/.vim/vendor/plenary.nvim/lua",
    "${env:HOME}/.vim/vendor/snacks.nvim/lua",
    "${env:HOME}/.vim/vendor/treesj/lua",
    "${env:HOME}/.vim/vendor/which-key.nvim/lua",
    "${env:HOME}/.vim/vendor/zen-mode.nvim/lua"
  ],
  "workspace.ignoreDir": [".firecrawl", ".git", ".venv", "tmp"],
  "diagnostics.globals": ["vim", "describe", "it", "pending", "before_each", "after_each", "assert"],
  "diagnostics.disable": ["deprecated"],
  "telemetry.enable": false
}
