# Disabled: this heuristic flags valid qualified Lua method names as obfuscation.
# Renaming those methods would break plugin APIs; there is no practical
# source-code fix for these findings.
# The .disabled extension excludes this file from Semgrep's rules/ directory scan.
# Re-enable only after testing obfuscated names against valid method declarations.
rules:
  - id: lua-obfuscation-declarations
    patterns:
      - pattern-either:
          - patterns:
              - pattern: $VAR = ...
              - pattern-not: $X.$Y = ...
              - pattern-not: $X[...] = ...
              - pattern-not-inside: $X = ...
          - patterns:
              - pattern: local $VAR = ...
          - pattern: $TABLE.$VAR = ...
          - pattern: |
              function $VAR(...)
              ...
          - pattern: |
              local function $VAR(...)
              ...
          - pattern: |
              function $TABLE.$VAR(...)
              ...
          - pattern: for $VAR in ... do
      - metavariable-pattern:
          metavariable: $VAR
          pattern-regex: ^\d|(.)\1{3,}|.{128,}|^_0x|([^a-zA-Z0-9_.])
    message: Obfuscated declarations names.
    severity: ERROR
    languages:
      - lua
