# Disabled: this heuristic flags ordinary table fields and local aliases as
# builtin overwrites. Renaming those plugin APIs/bindings would change valid
# dependency behavior; there is no practical source-code fix for these findings.
# The .disabled extension excludes this file from Semgrep's rules/ directory scan.
# Re-enable only after testing genuine overwrites against these benign cases.
rules:
  - id: lua-obfuscation-override
    pattern-either:
      - patterns:
          - pattern: $IMPOSTOR = ...
          - metavariable-pattern:
              metavariable: $IMPOSTOR
              pattern-regex: ^(assert|error|getmetatable|ipairs|load|next|pairs|pcall|print|require|select|setmetatable|string|table|tonumber|tostring|type|package|io\.[a-zA-Z]+|math\.[a-zA-Z]+|os\.[a-zA-Z]+)$
    message: Obfuscation by overriding builtin constructs.
    severity: ERROR
    languages: 
      - lua
