def treesitter_released_source_metadata_path(
    repository: str, lock: JSONMapping, source_id: str
) -> Optional[str]:
    root = treesitter_released_source_root_path(repository, lock, source_id)
    if root is None:
        return None
    return os.path.join(root, "metadata.json")


def treesitter_source_root_by_id(
    repository: str, lock: JSONMapping, source_id: str
) -> Optional[str]:
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        return None
    source = sources.get(source_id)
    if not isinstance(source, dict):
        warn("unknown source id: {0}".format(source_id))
        return None
    if source_treesitter_released_source(cast(JSONMapping, source)):
        return treesitter_released_source_source_path(repository, lock, source_id)
    return source_worktree_path(repository, lock, source_id, cast(JSONMapping, source))


def copy_query_dir(source_dir: str, destination_dir: str) -> bool:
    if not os.path.isdir(source_dir):
        warn("query source not found: {0}".format(source_dir))
        return False
    try:
        if os.path.exists(destination_dir):
            shutil.rmtree(destination_dir)
        shutil.copytree(source_dir, destination_dir)
    except OSError as exc:
        warn(
            "unable to copy query directory {0} to {1}: {2}".format(
                source_dir, destination_dir, exc
            )
        )
        return False
    return True


# tree-sitter-sql v0.3.11 ships SQL highlights predicates in a form Neovim
# does not load as-is, so normalize only the installed SQL query copy.
def normalize_installed_query_dir(
    source_id: str, language: str, destination_dir: str
) -> bool:
    if source_id != "tree-sitter-sql" or language != "sql":
        return True

    highlights = os.path.join(destination_dir, "highlights.scm")
    try:
        with open(highlights, encoding="utf-8") as file:
            content = file.read()
    except OSError as exc:
        warn("unable to read {0}: {1}".format(highlights, exc))
        return False

    content = content.replace(
        '(#match? @number "^[-+]?%d+$")',
        '(#lua-match? @number "^[-+]?%d+$")',
    )
    content = content.replace(
        '(#match? @float "^[-+]?%d*\\.%d*$")',
        '(#lua-match? @float "^[-+]?%d*%.%d*$")',
    )

    try:
        with open(highlights, "w", encoding="utf-8") as file:
            file.write(content)
    except OSError as exc:
        warn("unable to write {0}: {1}".format(highlights, exc))
        return False

    return True


def query_source_path(
    repository: str,
    lock: JSONMapping,
    language: str,
    parser_data: JSONMapping,
) -> Optional[tuple[str, str]]:
    metadata = root_treesitter_metadata(lock)
    defaults = metadata.get("defaults", {})
    if not isinstance(defaults, dict):
        defaults = {}
    source_id = parser_data.get(
        "querySource", defaults.get("querySource", "nvim-treesitter")
    )
    if not isinstance(source_id, str):
        warn("querySource for {0} must be a string".format(language))
        return None
    query_path = parser_data.get("queryPath")
    if not isinstance(query_path, str):
        template = defaults.get("queryPathTemplate", "runtime/queries/{language}")
        if not isinstance(template, str):
            warn("treesitter.defaults.queryPathTemplate must be a string")
            return None
        query_path = template.replace("{language}", language)
    normalized_query_path = validated_relative_subpath(query_path)
    if normalized_query_path is None:
        warn("queryPath for {0} must be a non-empty relative path".format(language))
        return None
    source_root = treesitter_source_root_by_id(repository, lock, source_id)
    if source_root is None:
        return None
    return source_id, os.path.join(source_root, normalized_query_path)


def required_queries(lock: JSONMapping, parser_data: JSONMapping) -> Sequence[str]:
    value = parser_data.get("requiredQueries")
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return value
    metadata = root_treesitter_metadata(lock)
    defaults = metadata.get("defaults", {})
    if isinstance(defaults, dict):
        default_queries = defaults.get("requiredQueries", ["highlights"])
        if isinstance(default_queries, list) and all(
            isinstance(item, str) for item in default_queries
        ):
            return default_queries
    return ["highlights"]


def sequence_strings(value: object) -> Sequence[str]:
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return [str(item) for item in value]
    return []


def sequence_mappings(value: object) -> Sequence[JSONMapping]:
    if not isinstance(value, list):
        return []
    items: list[JSONMapping] = []
    for item in value:
        if not isinstance(item, dict):
            return []
        items.append(cast(JSONMapping, item))
    return items


def supplemental_query_groups(lock: JSONMapping) -> Sequence[JSONMapping]:
    metadata = root_treesitter_metadata(lock)
    defaults = metadata.get("defaults", {})
    if not isinstance(defaults, dict):
        return []
    return sequence_mappings(defaults.get("supplementalQueryGroups"))


def supplemental_query_languages(group: JSONMapping) -> Sequence[str]:
    return sequence_strings(group.get("languages"))


def supplemental_query_source_path(
    repository: str, lock: JSONMapping, group: JSONMapping, language: str
) -> Optional[tuple[str, str, str]]:
    group_name = group.get("name")
    source_id = group.get("source")
    if not isinstance(group_name, str) or not group_name:
        warn("supplemental query group name must be a non-empty string")
        return None
    if not isinstance(source_id, str) or not source_id:
        warn(
            "supplemental query group {0} source must be a non-empty string".format(
                group_name
            )
        )
        return None

    query_path = group.get("path")
    if not isinstance(query_path, str):
        template = group.get("pathTemplate", "queries/{language}/{group}.scm")
        if not isinstance(template, str):
            warn(
                "supplemental query group {0} pathTemplate must be a string".format(
                    group_name
                )
            )
            return None
        query_path = template.replace("{language}", language).replace(
            "{group}", group_name
        )
    normalized_query_path = validated_relative_subpath(query_path)
    if normalized_query_path is None:
        warn(
            "supplemental query group {0} path must be a non-empty relative path".format(
                group_name
            )
        )
        return None

    source_root = treesitter_source_root_by_id(repository, lock, source_id)
    if source_root is None:
        return None
    return source_id, group_name, os.path.join(source_root, normalized_query_path)


def install_supplemental_query_groups(
    repository: str, lock: JSONMapping, runtime_site: str
) -> bool:
    ok = True
    for group in supplemental_query_groups(lock):
        for language in supplemental_query_languages(group):
            resolved = supplemental_query_source_path(repository, lock, group, language)
            if resolved is None:
                ok = False
                continue
            source_id, group_name, source_file = resolved
            if not os.path.isfile(source_file):
                warn("supplemental Treesitter query missing: {0}".format(source_file))
                ok = False
                continue
            destination_dir = os.path.join(runtime_site, "queries", language)
            try:
                os.makedirs(destination_dir, exist_ok=True)
                shutil.copy2(
                    source_file, os.path.join(destination_dir, group_name + ".scm")
                )
            except OSError as exc:
                warn(
                    "unable to install supplemental Treesitter query {0}/{1}: {2}".format(
                        language, group_name, exc
                    )
                )
                ok = False
                continue
            commit = source_commit_by_id(lock, source_id)
            if commit and not write_revision_file(
                runtime_site, language + "." + group_name, commit
            ):
                ok = False
    return ok


def remove_path(path: str) -> None:
    try:
        if os.path.islink(path) or os.path.isfile(path):
            os.unlink(path)
        elif os.path.isdir(path):
            shutil.rmtree(path)
    except OSError as exc:
        warn("unable to remove {0}: {1}".format(path, exc))


def replace_directory(destination: str, staged: str) -> bool:
    backup = destination + ".previous.{0}.{1}".format(os.getpid(), time.time_ns())
    existing_was_moved = False
    try:
        if os.path.exists(destination) or os.path.islink(destination):
            os.rename(destination, backup)
            existing_was_moved = True
        os.rename(staged, destination)
    except OSError as exc:
        if existing_was_moved and not (
            os.path.exists(destination) or os.path.islink(destination)
        ):
            try:
                os.rename(backup, destination)
            except OSError:
                pass
        warn("unable to replace {0}: {1}".format(destination, exc))
        return False
    if existing_was_moved and (os.path.exists(backup) or os.path.islink(backup)):
        remove_path(backup)
    return True


def revision_file_path(runtime_site: str, name: str) -> str:
    return os.path.join(runtime_site, "state", name + ".revision")


def write_revision_file(runtime_site: str, name: str, commit: str) -> bool:
    try:
        with open(
            revision_file_path(runtime_site, name), "w", encoding="utf-8"
        ) as file:
            file.write(commit + "\n")
    except OSError as exc:
        warn("unable to write Treesitter revision file for {0}: {1}".format(name, exc))
        return False
    return True


def publish_runtime_subdirectories(
    runtime_site: str, staged_runtime_site: str, children: Sequence[str]
) -> bool:
    try:
        os.makedirs(runtime_site, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(runtime_site, exc))
        return False

    backups: list[tuple[str, str]] = []
    try:
        for child in children:
            target = os.path.join(runtime_site, child)
            if not (os.path.exists(target) or os.path.islink(target)):
                continue
            backup = target + ".previous.{0}.{1}".format(os.getpid(), time.time_ns())
            os.rename(target, backup)
            backups.append((target, backup))
    except OSError as exc:
        for target, backup in reversed(backups):
            if os.path.exists(backup) or os.path.islink(backup):
                try:
                    os.rename(backup, target)
                except OSError:
                    pass
        warn("unable to stage Treesitter runtime publication: {0}".format(exc))
        return False

    published_targets: list[str] = []
    try:
        for child in children:
            target = os.path.join(runtime_site, child)
            staged = os.path.join(staged_runtime_site, child)
            os.rename(staged, target)
            published_targets.append(target)
    except OSError as exc:
        for target in reversed(published_targets):
            if os.path.exists(target) or os.path.islink(target):
                remove_path(target)
        for target, backup in reversed(backups):
            if os.path.exists(backup) or os.path.islink(backup):
                try:
                    os.rename(backup, target)
                except OSError:
                    pass
        warn("unable to publish Treesitter runtime: {0}".format(exc))
        return False

    for _, backup in backups:
        if os.path.exists(backup) or os.path.islink(backup):
            remove_path(backup)
    return True


def sha256_file(path: str, emit_warnings: bool = True) -> Optional[str]:
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(chunk)
    except OSError as exc:
        if emit_warnings:
            warn("unable to read {0}: {1}".format(path, exc))
        return None
    return digest.hexdigest()


def verify_file_sha256(path: str, expected: str, emit_warnings: bool = True) -> bool:
    actual = sha256_file(path, emit_warnings=emit_warnings)
    if actual is None:
        return False
    if actual != expected:
        if emit_warnings:
            warn(
                "SHA-256 mismatch for {0}: expected {1}, got {2}".format(
                    path, expected, actual
                )
            )
        return False
    return True


def normalize_archive_member_path(path: str) -> Optional[str]:
    normalized = normalize_relative_subpath(path)
    if not normalized:
        return None
    if normalized in (".", "..") or normalized.startswith("../"):
        return None
    return normalized


def extract_tar_gz(archive: str, destination: str) -> bool:
    try:
        with tarfile.open(archive, "r:gz") as tar:
            for member in tar.getmembers():
                normalized = normalize_archive_member_path(member.name)
                if normalized is None:
                    continue
                if member.islnk() or member.issym():
                    warn(
                        "unsupported symlink in Treesitter released source archive: {0}".format(
                            member.name
                        )
                    )
                    return False
                target = os.path.join(destination, normalized)
                if not path_within_repository(destination, target):
                    warn(
                        "Treesitter released source archive path escapes extraction root: {0}".format(
                            member.name
                        )
                    )
                    return False
                if member.isdir():
                    os.makedirs(target, exist_ok=True)
                    continue
                if not member.isfile():
                    continue
                os.makedirs(os.path.dirname(target), exist_ok=True)
                extracted = tar.extractfile(member)
                if extracted is None:
                    warn(
                        "unable to extract Treesitter released source archive member: {0}".format(
                            member.name
                        )
                    )
                    return False
                with extracted:
                    with open(target, "wb") as output:
                        shutil.copyfileobj(extracted, output)
    except (OSError, tarfile.TarError) as exc:
        warn(
            "unable to extract Treesitter released source archive {0}: {1}".format(
                archive, exc
            )
        )
        return False
    return True


def copy_treesitter_released_source_paths(
    source_root: str, destination_root: str, paths: Sequence[str]
) -> bool:
    try:
        for relative_path in paths:
            source = os.path.join(source_root, relative_path)
            destination = os.path.join(destination_root, relative_path)
            if not os.path.exists(source):
                warn(
                    "Treesitter released source retained path missing: {0}".format(
                        source
                    )
                )
                return False
            if os.path.isdir(source):
                shutil.copytree(source, destination)
            else:
                os.makedirs(os.path.dirname(destination), exist_ok=True)
                shutil.copy2(source, destination)
    except OSError as exc:
        warn("unable to copy Treesitter released source paths: {0}".format(exc))
        return False
    return True


def read_json_object_file(path: str, emit_warnings: bool) -> Optional[JSONObject]:
    try:
        with open(path, encoding="utf-8") as file:
            value = json.load(file)
    except OSError as exc:
        if emit_warnings:
            warn("unable to read {0}: {1}".format(path, exc))
        return None
    except json.JSONDecodeError as exc:
        if emit_warnings:
            warn("unable to parse {0}: {1}".format(path, exc))
        return None
    if not isinstance(value, dict):
        if emit_warnings:
            warn("{0} must contain a JSON object".format(path))
        return None
    return value


def treesitter_released_source_state_ok(
    repository: str,
    lock: JSONMapping,
    source_id: str,
    source: JSONMapping,
    emit_warnings: bool,
) -> bool:
    released_source = source_treesitter_released_source(source)
    if not released_source:
        return True

    archive = treesitter_released_source_archive_path(repository, lock, source_id)
    metadata_path = treesitter_released_source_metadata_path(
        repository, lock, source_id
    )
    source_root = treesitter_released_source_source_path(repository, lock, source_id)
    if archive is None or metadata_path is None or source_root is None:
        return False

    if not os.path.isfile(archive):
        if emit_warnings:
            warn(
                "Treesitter released source archive missing: {0}; run ./manage install".format(
                    archive
                )
            )
        return False

    expected_sha256 = released_source.get("sha256")
    if not isinstance(expected_sha256, str) or not verify_file_sha256(
        archive, expected_sha256, emit_warnings=emit_warnings
    ):
        return False

    metadata = read_json_object_file(metadata_path, emit_warnings=emit_warnings)
    if metadata is None:
        return False
    expected_url = released_source.get("url")
    expected_files = list(treesitter_released_source_files(released_source))
    if (
        metadata.get("url") != expected_url
        or metadata.get("sha256") != expected_sha256
        or metadata.get("files") != expected_files
    ):
        if emit_warnings:
            warn(
                "Treesitter released source metadata mismatch for {0}; run ./manage install".format(
                    source_id
                )
            )
        return False

    for relative_path in expected_files:
        path = os.path.join(source_root, relative_path)
        if not os.path.exists(path):
            if emit_warnings:
                warn(
                    "Treesitter released source path missing: {0}; run ./manage install".format(
                        path
                    )
                )
            return False
    return True


def materialize_treesitter_released_source(
    repository: str,
    lock: JSONMapping,
    source_id: str,
    source: JSONMapping,
) -> bool:
    released_source = source_treesitter_released_source(source)
    if not released_source:
        return True
    if treesitter_released_source_state_ok(
        repository, lock, source_id, source, emit_warnings=False
    ):
        return True

    root = treesitter_released_source_root_path(repository, lock, source_id)
    if root is None:
        return False

    url = released_source.get("url")
    sha256 = released_source.get("sha256")
    files = list(treesitter_released_source_files(released_source))
    if not isinstance(url, str) or not isinstance(sha256, str) or not files:
        warn(
            "invalid Treesitter released source metadata for source {0}".format(
                source_id
            )
        )
        return False

    parent = os.path.dirname(root)
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(parent, exc))
        return False

    info("materializing Treesitter released source {0}".format(source_id))
    with tempfile.TemporaryDirectory(
        prefix=".{0}.{1}.".format(source_id, os.getpid()), dir=parent
    ) as staging_root:
        staged_root = os.path.join(staging_root, "install")
        staged_source_root = os.path.join(staged_root, "source")
        extracted_root = os.path.join(staging_root, "extract")
        try:
            os.makedirs(staged_source_root, exist_ok=True)
            os.makedirs(extracted_root, exist_ok=True)
        except OSError as exc:
            warn(
                "unable to create staging directories for {0}: {1}".format(
                    source_id, exc
                )
            )
            return False

        staged_archive = os.path.join(staged_root, "archive.tar.gz")
        staged_metadata_path = os.path.join(staged_root, "metadata.json")
        if not download_url(url, staged_archive):
            return False
        if not verify_file_sha256(staged_archive, sha256):
            return False
        if not extract_tar_gz(staged_archive, extracted_root):
            return False
        if not copy_treesitter_released_source_paths(
            extracted_root, staged_source_root, files
        ):
            return False
        try:
            with open(staged_metadata_path, "w", encoding="utf-8") as file:
                json.dump(
                    {"url": url, "sha256": sha256, "files": files},
                    file,
                    indent=2,
                )
                file.write("\n")
        except OSError as exc:
            warn(
                "unable to write Treesitter released source metadata for {0}: {1}".format(
                    source_id, exc
                )
            )
            return False
        if not replace_directory(root, staged_root):
            return False
    return True


def materialize_treesitter_released_sources(repository: str, lock: JSONMapping) -> bool:
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        warn("lockfile sources must be an object")
        return False
    ok = True
    for source_id, source_value in sources.items():
        if not valid_source_id(source_id):
            warn("invalid source id: {0}".format(source_id))
            ok = False
            continue
        if not isinstance(source_value, dict):
            warn("source {0} must be an object".format(source_id))
            ok = False
            continue
        if not validate_source_settings(source_id, source_value):
            ok = False
            continue
        if not materialize_treesitter_released_source(
            repository, lock, source_id, cast(JSONMapping, source_value)
        ):
            ok = False
    return ok


def check_treesitter_released_sources(repository: str, lock: JSONMapping) -> bool:
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        warn("lockfile sources must be an object")
        return False
    ok = True
    for source_id, source_value in sources.items():
        if not valid_source_id(source_id):
            warn("invalid source id: {0}".format(source_id))
            ok = False
            continue
        if not isinstance(source_value, dict):
            warn("source {0} must be an object".format(source_id))
            ok = False
            continue
        if not validate_source_settings(source_id, source_value):
            ok = False
            continue
        if not treesitter_released_source_state_ok(
            repository,
            lock,
            source_id,
            cast(JSONMapping, source_value),
            emit_warnings=True,
        ):
            ok = False
    return ok


def copy_source_for_build(
    repository: str,
    lock: JSONMapping,
    scratch_root: str,
    source_id: str,
    copied_sources: set[str],
) -> Optional[str]:
    destination = os.path.join(scratch_root, "sources", source_id)
    if source_id in copied_sources:
        return destination
    source_root = treesitter_source_root_by_id(repository, lock, source_id)
    if source_root is None:
        return None
    try:
        if os.path.exists(destination):
            shutil.rmtree(destination)
        shutil.copytree(source_root, destination, ignore=shutil.ignore_patterns(".git"))
    except OSError as exc:
        warn("unable to stage Treesitter build source {0}: {1}".format(source_id, exc))
        return None
    copied_sources.add(source_id)
    return destination


def query_dependency_data(parser_data: JSONMapping) -> JSONObject:
    query_data: JSONObject = {}
    query_source = parser_data.get("querySource")
    if isinstance(query_source, str):
        query_data["querySource"] = query_source
    query_path = parser_data.get("queryPath")
    if isinstance(query_path, str):
        query_data["queryPath"] = query_path
    return query_data


def install_treesitter_runtime(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    minimum = TREE_SITTER_MINIMUM_VERSION
    metadata = root_treesitter_metadata(lock)
    minimum_value = metadata.get("minimumCliVersion")
    if isinstance(minimum_value, str):
        parsed = parse_version_tuple(minimum_value)
        if parsed is not None:
            minimum = parsed
    if not check_tree_sitter_cli(env, repository, minimum):
        return False

    runtime_site = tree_sitter_runtime_site(repository, lock)
    if runtime_site is None:
        return False
    languages = treesitter_languages(lock)
    if not languages:
        warn("no Treesitter parsers configured in {0}".format(SOURCE_MANIFEST_NAME))
        return False

    tree_sitter = resolve_required("tree-sitter", env)
    if tree_sitter is None:
        return False

    runtime_parent = os.path.dirname(runtime_site)
    try:
        os.makedirs(runtime_parent, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(runtime_parent, exc))
        return False

    with tempfile.TemporaryDirectory(
        prefix="treesitter-runtime-", dir=runtime_parent
    ) as staging_root:
        staged_runtime_site = os.path.join(staging_root, "site")
        try:
            for child in ("parser", "queries", "state"):
                os.makedirs(os.path.join(staged_runtime_site, child), exist_ok=True)
        except OSError as exc:
            warn(
                "unable to create staged Treesitter runtime directories: {0}".format(
                    exc
                )
            )
            return False

        ok = True
        with tempfile.TemporaryDirectory(prefix="treesitter-build-") as scratch_root:
            copied_sources: set[str] = set()
            for language, parser_data in sorted(languages.items()):
                source_id = parser_data.get("source")
                location = parser_data.get("location", ".")
                parser_name = parser_data.get("parser", language)
                if (
                    not isinstance(source_id, str)
                    or not isinstance(location, str)
                    or not isinstance(parser_name, str)
                ):
                    warn("invalid Treesitter parser metadata for {0}".format(language))
                    ok = False
                    continue
                build_source = copy_source_for_build(
                    repository, lock, scratch_root, source_id, copied_sources
                )
                if build_source is None:
                    ok = False
                    continue
                normalized_location = validated_relative_subpath_or_current(location)
                if normalized_location is None:
                    warn(
                        "parser location for {0} must be a relative path within the source".format(
                            language
                        )
                    )
                    ok = False
                    continue
                build_dir = os.path.abspath(
                    os.path.join(build_source, normalized_location)
                )
                if not os.path.isdir(build_dir):
                    warn(
                        "parser source not found for {0}: {1}".format(
                            language, build_dir
                        )
                    )
                    ok = False
                    continue
                if bool(parser_data.get("generate", False)):
                    if not run_logged_command(
                        [tree_sitter, "generate"],
                        env,
                        build_dir,
                        show_success_output_on_stderr=False,
                    ):
                        ok = False
                        continue
                output = os.path.join(
                    staged_runtime_site, "parser", parser_name + parser_extension()
                )
                if not run_logged_command(
                    [tree_sitter, "build", "-o", output],
                    env,
                    build_dir,
                    show_success_output_on_stderr=False,
                ):
                    ok = False
                    continue
                commit = source_commit_by_id(lock, source_id)
                if commit and not write_revision_file(
                    staged_runtime_site, language, commit
                ):
                    ok = False
                    continue
                if not install_query_language(
                    repository,
                    lock,
                    staged_runtime_site,
                    language,
                    parser_data,
                    revision_name=None,
                ):
                    ok = False
                query_data = query_dependency_data(parser_data)
                for query_language in sequence_strings(
                    parser_data.get("queryDependencies")
                ):
                    if not install_query_language(
                        repository,
                        lock,
                        staged_runtime_site,
                        query_language,
                        query_data,
                        revision_name=query_language,
                    ):
                        ok = False

        if not install_supplemental_query_groups(repository, lock, staged_runtime_site):
            ok = False
        if not ok:
            return False

        if not publish_runtime_subdirectories(
            runtime_site, staged_runtime_site, ("parser", "queries", "state")
        ):
            return False

    return True


def install_query_language(
    repository: str,
    lock: JSONMapping,
    runtime_site: str,
    language: str,
    parser_data: JSONMapping,
    revision_name: Optional[str],
) -> bool:
    resolved = query_source_path(repository, lock, language, parser_data)
    if resolved is None:
        return False
    source_id, source_dir = resolved
    destination = os.path.join(runtime_site, "queries", language)
    if not copy_query_dir(source_dir, destination):
        return False
    if not normalize_installed_query_dir(source_id, language, destination):
        return False
    commit = source_commit_by_id(lock, source_id)
    if (
        revision_name is not None
        and commit
        and not write_revision_file(runtime_site, revision_name, commit)
    ):
        return False
    parser_source_id = parser_data.get("source")
    if (
        isinstance(parser_source_id, str)
        and parser_source_id != source_id
        and commit
        and not write_revision_file(runtime_site, language + ".query", commit)
    ):
        return False
    return True


def check_treesitter_runtime_state(repository: str, lock: JSONMapping) -> bool:
    runtime_site = tree_sitter_runtime_site(repository, lock)
    if runtime_site is None:
        return False
    languages = treesitter_languages(lock)
    ok = True
    for language, parser_data in sorted(languages.items()):
        parser_name = parser_data.get("parser", language)
        if not isinstance(parser_name, str):
            warn("invalid parser name for {0}".format(language))
            ok = False
            continue
        parser_path = os.path.join(
            runtime_site, "parser", parser_name + parser_extension()
        )
        if not os.path.isfile(parser_path):
            warn(
                "Treesitter parser missing: {0}; run ./manage install".format(
                    parser_path
                )
            )
            ok = False
        for query in required_queries(lock, parser_data):
            query_file = os.path.join(runtime_site, "queries", language, query + ".scm")
            if not os.path.isfile(query_file):
                warn(
                    "Treesitter query missing: {0}; run ./manage install".format(
                        query_file
                    )
                )
                ok = False
        source_id = parser_data.get("source")
        commit = (
            source_commit_by_id(lock, source_id) if isinstance(source_id, str) else None
        )
        revision = revision_file_path(runtime_site, language)
        if commit and read_text_file(revision) != commit:
            warn(
                "Treesitter revision mismatch for {0}; run ./manage install".format(
                    language
                )
            )
            ok = False
        resolved_query_source = query_source_path(
            repository, lock, language, parser_data
        )
        if resolved_query_source is None:
            ok = False
        else:
            query_source_id, _ = resolved_query_source
            query_commit = source_commit_by_id(lock, query_source_id)
            if (
                query_commit
                and isinstance(source_id, str)
                and query_source_id != source_id
                and read_text_file(
                    revision_file_path(runtime_site, language + ".query")
                )
                != query_commit
            ):
                warn(
                    "Treesitter query revision mismatch for {0}; run ./manage install".format(
                        language
                    )
                )
                ok = False
        query_data = query_dependency_data(parser_data)
        for query_language in sequence_strings(parser_data.get("queryDependencies")):
            query_dir = os.path.join(runtime_site, "queries", query_language)
            if not os.path.isdir(query_dir):
                warn(
                    "Treesitter query dependency missing: {0}; run ./manage install".format(
                        query_dir
                    )
                )
                ok = False
                continue
            resolved_dependency_source = query_source_path(
                repository, lock, query_language, query_data
            )
            if resolved_dependency_source is None:
                ok = False
                continue
            query_source_id, _ = resolved_dependency_source
            query_commit = source_commit_by_id(lock, query_source_id)
            if (
                query_commit
                and read_text_file(revision_file_path(runtime_site, query_language))
                != query_commit
            ):
                warn(
                    "Treesitter query dependency revision mismatch for {0}; run ./manage install".format(
                        query_language
                    )
                )
                ok = False

    for group in supplemental_query_groups(lock):
        for language in supplemental_query_languages(group):
            resolved = supplemental_query_source_path(repository, lock, group, language)
            if resolved is None:
                ok = False
                continue
            source_id, group_name, _ = resolved
            query_file = os.path.join(
                runtime_site, "queries", language, group_name + ".scm"
            )
            if not os.path.isfile(query_file):
                warn(
                    "supplemental Treesitter query missing: {0}; run ./manage install".format(
                        query_file
                    )
                )
                ok = False
            commit = source_commit_by_id(lock, source_id)
            revision = revision_file_path(runtime_site, language + "." + group_name)
            if commit and read_text_file(revision) != commit:
                warn(
                    "supplemental Treesitter query revision mismatch for {0}/{1}; run ./manage install".format(
                        language, group_name
                    )
                )
                ok = False
    return ok


def check_treesitter_runtime(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    minimum = TREE_SITTER_MINIMUM_VERSION
    metadata = root_treesitter_metadata(lock)
    minimum_value = metadata.get("minimumCliVersion")
    if isinstance(minimum_value, str):
        parsed = parse_version_tuple(minimum_value)
        if parsed is not None:
            minimum = parsed
    ok = check_tree_sitter_cli(env, repository, minimum)
    if not check_treesitter_released_sources(repository, lock):
        ok = False
    if not check_treesitter_runtime_state(repository, lock):
        ok = False
    return ok


def read_text_file(path: str) -> Optional[str]:
    try:
        with open(path, encoding="utf-8") as file:
            return file.read().strip()
    except OSError:
        return None


def install(offline: bool) -> int:
    """Install production dependencies and Neovim plugins."""
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1

    repository = repository_dir()
    env = install_environment(home)

    ok = True
    if offline:
        info("offline mode: verifying local state only")
        if os.path.exists(os.path.join(repository, "pyproject.toml")):
            info("offline mode: skipped uv production sync")
        if os.path.exists(os.path.join(repository, "package.json")):
            info("offline mode: skipped pnpm production install")
    else:
        if not sync_uv_production_if_needed(env, repository):
            ok = False
        if not sync_pnpm_production(env, repository):
            ok = False

    lock = load_git_worktrees_lock(repository)
    if lock is None:
        ok = False
    elif offline:
        if not check_git_sources(env, repository, lock):
            ok = False
        if not check_treesitter_released_sources(repository, lock):
            ok = False
        if not check_native_plugin_artifacts(repository, lock):
            ok = False
        if not check_treesitter_runtime_state(repository, lock):
            ok = False
    else:
        if not materialize_git_sources(env, repository, lock):
            ok = False
        if not materialize_treesitter_released_sources(repository, lock):
            ok = False
        if not install_native_plugin_artifacts(env, repository, lock):
            ok = False
        if not install_treesitter_runtime(env, repository, lock):
            ok = False

    if offline:
        if not check_neovim_config_link(home, repository):
            ok = False
        info("offline mode: skipped Lazy restore")
        return 0 if ok else 1

    if not link_neovim_config(home, repository):
        ok = False

    nvim = shutil.which("nvim", path=env.get("PATH"))
    if not nvim:
        info("nvim not found; skipped Lazy restore")
        return 0 if ok else 1

    if ok and not sync_neovim_plugins(nvim, env, repository):
        ok = False

    return 0 if ok else 1


def command_name(command: Sequence[str]) -> str:
    return shlex.join(command)


def print_command(command: Sequence[str]) -> None:
    info("$ {0}".format(command_name(command)))


def print_completed_output(completed: subprocess.CompletedProcess[str]) -> None:
    if completed.stdout:
        print(completed.stdout, end="" if completed.stdout.endswith("\n") else "\n")
    if completed.stderr:
        print(
            completed.stderr,
            end="" if completed.stderr.endswith("\n") else "\n",
            file=sys.stderr,
        )


def run_logged_command(
    command: Sequence[str],
    env: Mapping[str, str],
    repository: str,
    success_message: Optional[str] = None,
    show_success_output_on_stderr: bool = True,
) -> bool:
    print_command(command)
    try:
        completed = subprocess.run(
            command,
            env=env,
            cwd=repository,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        warn("unable to run {0}: {1}".format(command[0], exc))
        return False

    if completed.returncode == 0:
        if show_success_output_on_stderr and completed.stderr:
            print_completed_output(completed)
        if success_message:
            info(success_message)
        return True

    print_completed_output(completed)
    warn(
        "command failed with exit code {0}: {1}".format(
            completed.returncode, command_name(command)
        )
    )
    return False


def resolve_required(name: str, env: Mapping[str, str]) -> Optional[str]:
    path = shutil.which(name, path=env.get("PATH"))
    if not path:
        warn("{0} not found on PATH".format(name))
    return path


def neovim_value(
    nvim: str, expression: str, env: Mapping[str, str], repository: str
) -> Optional[str]:
    command = [
        nvim,
        "--clean",
        "--headless",
        "--cmd",
        "lua io.write(" + expression + ")",
        "--cmd",
        "qa",
    ]
    try:
        completed = subprocess.run(
            command,
            env=env,
            cwd=repository,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        warn("unable to run nvim: {0}".format(exc))
        return None

    if completed.returncode != 0:
        warn("unable to query nvim: {0}".format(completed.stderr.strip()))
        return None

    value = completed.stdout.strip()
    if not value:
        warn("nvim returned an empty value for {0}".format(expression))
        return None
    return value


def neovim_runtime(nvim: str, env: Mapping[str, str], repository: str) -> Optional[str]:
    return neovim_value(nvim, "vim.env.VIMRUNTIME", env, repository)


def vendor_dir(repository: str) -> str:
    return os.path.join(repository, VENDOR_DIR_NAME)


def lazy_dir(repository: str) -> str:
    return os.path.join(vendor_dir(repository), LAZY_DIR_NAME)


def lazy_plugin_dir(repository: str, plugin_name: str) -> str:
    return os.path.join(lazy_dir(repository), plugin_name)


def vendored_plugins_dir(repository: str) -> str:
    return os.path.join(vendor_dir(repository), VENDORED_PLUGINS_DIR_NAME)


def vendored_plugin_dir(repository: str, plugin_name: str) -> str:
    return os.path.join(vendored_plugins_dir(repository), plugin_name)


def source_native_build(source: JSONMapping) -> JSONMapping:
    native_build = source_plugin_metadata(source).get("nativeBuild", {})
    return native_build if isinstance(native_build, dict) else {}


def native_build_optional(native_build: JSONMapping) -> bool:
    return bool(native_build.get("optional", False))


def native_build_minimum_cargo_version(
    native_build: JSONMapping,
) -> Optional[tuple[int, int, int]]:
    value = native_build.get("minimumCargoVersion")
    if not isinstance(value, str):
        return None
    return parse_version_tuple(value)


def cargo_version(
    cargo: str, env: Mapping[str, str], repository: str
) -> Optional[tuple[int, int, int]]:
    completed = run_captured_command([cargo, "--version"], env, repository)
    if completed is None or completed.returncode != 0:
        return None
    return parse_version_tuple(completed.stdout)


def optional_native_build_outcome(
    source_id: str, native_build: JSONMapping, message: str
) -> NativeBuildOutcome:
    if native_build_optional(native_build):
        warn(message + "; skipping optional native build")
        return "skipped"
    warn(message)
    return "failed"


def native_build_source_ids(lock: JSONMapping) -> Sequence[str]:
    source_ids: list[str] = []
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        return source_ids
    for source_id, source_value in sources.items():
        if (
            isinstance(source_id, str)
            and isinstance(source_value, dict)
            and source_native_build(source_value)
        ):
            source_ids.append(source_id)
    return sorted(source_ids)


def native_library_extension() -> str:
    if sys.platform == "darwin":
        return ".dylib"
    if os.name == "nt":
        return ".dll"
    return ".so"


def native_plugin_artifact_path(
    worktree: str, native_build: JSONMapping
) -> Optional[str]:
    kind = native_build.get("kind")
    if kind == "cargo":
        return os.path.join(
            worktree,
            "target",
            "release",
            "libblink_cmp_fuzzy" + native_library_extension(),
        )
    if kind == "luasnip_jsregexp":
        return os.path.join(worktree, "deps", "luasnip-jsregexp.so")
    if kind == "make":
        return os.path.join(worktree, "build", "libfzf.so")
    return None


def native_build_revision_path(
    worktree: str, native_build: JSONMapping
) -> Optional[str]:
    kind = native_build.get("kind")
    if kind == "cargo":
        return os.path.join(worktree, "target", "release", ".manage-native-build")
    if kind == "luasnip_jsregexp":
        return os.path.join(worktree, "deps", "jsregexp", ".manage-native-build")
    if kind == "make":
        return os.path.join(worktree, "build", ".manage-native-build")
    return None


def native_build_revision_text(
    lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> Optional[str]:
    commit = source_commit_by_id(lock, source_id)
    if commit is None:
        warn("source {0} commit must be a non-empty string".format(source_id))
        return None
    lines = ["source {0} {1}".format(source_id, commit)]
    dependency_sources = native_build_dependency_sources(source_id, native_build)
    if dependency_sources is None:
        return None
    for relative_path, dependency_source_id in sorted(dependency_sources.items()):
        dependency_commit = source_commit_by_id(lock, dependency_source_id)
        if dependency_commit is None:
            warn(
                "source {0} dependency source commit is not available: {1}".format(
                    source_id, dependency_source_id
                )
            )
            return None
        lines.append(
            "dependency {0} {1} {2}".format(
                relative_path, dependency_source_id, dependency_commit
            )
        )
    return "\n".join(lines)


def write_native_build_revision(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    revision_path = native_build_revision_path(worktree, native_build)
    revision_text = native_build_revision_text(lock, source_id, native_build)
    if revision_path is None or revision_text is None:
        return False
    try:
        with open(revision_path, "w", encoding="utf-8") as file:
            file.write(revision_text + "\n")
    except OSError as exc:
        warn(
            "unable to write native build revision for source {0}: {1}".format(
                source_id, exc
            )
        )
        return False
    return True


def check_native_build_revision(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    revision_path = native_build_revision_path(worktree, native_build)
    revision_text = native_build_revision_text(lock, source_id, native_build)
    if revision_path is None or revision_text is None:
        return False
    actual = read_text_file(revision_path)
    if actual is None:
        warn(
            "native build revision missing for source {0}: {1}; run ./manage install".format(
                source_id, revision_path
            )
        )
        return False
    if actual != revision_text:
        warn(
            "native build revision mismatch for source {0}; run ./manage install".format(
                source_id
            )
        )
        return False
    return True


def overlay_native_build_dependency_sources(
    repository: str,
    lock: JSONMapping,
    worktree: str,
    dependency_sources: Mapping[str, str],
) -> bool:
    for relative_path, dependency_source_id in dependency_sources.items():
        dependency_worktree = source_worktree_by_id(
            repository, lock, dependency_source_id
        )
        if dependency_worktree is None:
            return False
        destination = os.path.join(worktree, relative_path)
        try:
            if os.path.exists(destination) or os.path.islink(destination):
                remove_path(destination)
            shutil.copytree(
                dependency_worktree,
                destination,
                ignore=shutil.ignore_patterns(".git"),
            )
        except OSError as exc:
            warn(
                "unable to overlay native build dependency source {0} into {1}: {2}".format(
                    dependency_source_id, destination, exc
                )
            )
            return False
    return True


def build_luasnip_jsregexp_runtime(
    make: str,
    env: Mapping[str, str],
    repository: str,
    worktree: str,
) -> bool:
    include_dir = os.path.join(worktree, "deps", "lua51_include")
    build_dirs = ("deps/jsregexp", "deps/jsregexp005", "deps/jsregexp006")
    for relative_path in build_dirs:
        build_dir = os.path.join(worktree, relative_path)
        if not os.path.isdir(build_dir):
            warn("LuaSnip build input missing: {0}".format(build_dir))
            return False
        if not run_logged_command(
            [
                make,
                "-C",
                build_dir,
                "INCLUDE_DIR=-I{0}/".format(include_dir),
                "LDLIBS=",
            ],
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False

    source_library = os.path.join(worktree, "deps", "jsregexp", "jsregexp.so")
    source_module = os.path.join(worktree, "deps", "jsregexp", "jsregexp.lua")
    if not os.path.isfile(source_library) or not os.path.isfile(source_module):
        warn("LuaSnip jsregexp build outputs missing in {0}".format(worktree))
        return False

    try:
        shutil.copy2(
            source_module, os.path.join(worktree, "lua", "luasnip-jsregexp.lua")
        )
        shutil.copy2(
            source_library, os.path.join(worktree, "deps", "luasnip-jsregexp.so")
        )
    except OSError as exc:
        warn("unable to publish LuaSnip jsregexp artifacts: {0}".format(exc))
        return False
    return True


def build_native_plugin_runtime(
    env: Mapping[str, str],
    repository: str,
    lock: JSONMapping,
    source_id: str,
    worktree: str,
    native_build: JSONMapping,
) -> NativeBuildOutcome:
    kind = native_build.get("kind")
    if kind == "make":
        make = resolve_required("make", env)
        if make is None:
            return "failed"
        if not run_logged_command(
            [make], env, worktree, show_success_output_on_stderr=False
        ):
            return "failed"
        return (
            "built"
            if write_native_build_revision(worktree, lock, source_id, native_build)
            else "failed"
        )
    if kind == "cargo":
        cargo = resolve_required("cargo", env)
        if cargo is None:
            return optional_native_build_outcome(
                source_id,
                native_build,
                "source {0} requires cargo on PATH".format(source_id),
            )
        minimum_version = native_build_minimum_cargo_version(native_build)
        if minimum_version is not None:
            version = cargo_version(cargo, env, repository)
            if version is None:
                return optional_native_build_outcome(
                    source_id,
                    native_build,
                    "unable to query cargo version for source {0}".format(source_id),
                )
            if version < minimum_version:
                return optional_native_build_outcome(
                    source_id,
                    native_build,
                    "source {0} requires cargo >= {1}; found {2}".format(
                        source_id,
                        ".".join(str(part) for part in minimum_version),
                        ".".join(str(part) for part in version),
                    ),
                )
        if run_logged_command(
            [cargo, *CARGO_BUILD_RELEASE],
            env,
            worktree,
            show_success_output_on_stderr=False,
        ):
            return (
                "built"
                if write_native_build_revision(worktree, lock, source_id, native_build)
                else "failed"
            )
        return optional_native_build_outcome(
            source_id,
            native_build,
            "cargo native build failed for source {0}".format(source_id),
        )
    if kind == "luasnip_jsregexp":
        dependency_sources = native_build_dependency_sources(source_id, native_build)
        if dependency_sources is None:
            return "failed"
        if not overlay_native_build_dependency_sources(
            repository, lock, worktree, dependency_sources
        ):
            return "failed"
        make = resolve_required("make", env)
        if make is None:
            return "failed"
        if not build_luasnip_jsregexp_runtime(make, env, repository, worktree):
            return "failed"
        return (
            "built"
            if write_native_build_revision(worktree, lock, source_id, native_build)
            else "failed"
        )
    warn("unsupported native build kind for source {0}".format(source_id))
    return "failed"


def install_native_plugin_artifacts(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    ok = True
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        return False
    for source_id in native_build_source_ids(lock):
        source_value = sources.get(source_id)
        if not isinstance(source_value, dict):
            ok = False
            continue
        worktree = source_worktree_by_id(repository, lock, source_id)
        if worktree is None:
            ok = False
            continue
        native_build = source_native_build(source_value)
        outcome = build_native_plugin_runtime(
            env, repository, lock, source_id, worktree, native_build
        )
        if outcome == "failed":
            ok = False
            continue
        artifact = native_plugin_artifact_path(worktree, native_build)
        if artifact is None:
            warn(
                "native plugin artifact path is not defined for source {0}".format(
                    source_id
                )
            )
            ok = False
            continue
        if outcome != "skipped" and not os.path.isfile(artifact):
            if native_build_optional(native_build):
                warn(
                    "native plugin artifact missing for optional source {0}: {1}".format(
                        source_id, artifact
                    )
                )
            else:
                warn(
                    "native plugin artifact missing for source {0}: {1}".format(
                        source_id, artifact
                    )
                )
                ok = False
        if outcome == "built" and not check_native_build_revision(
            worktree, lock, source_id, native_build
        ):
            ok = False
    return ok


def check_native_plugin_artifacts(repository: str, lock: JSONMapping) -> bool:
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        return False
    ok = True
    for source_id in native_build_source_ids(lock):
        source_value = sources.get(source_id)
        if not isinstance(source_value, dict):
            ok = False
            continue
        worktree = source_worktree_by_id(repository, lock, source_id)
        if worktree is None:
            ok = False
            continue
        native_build = source_native_build(source_value)
        artifact = native_plugin_artifact_path(worktree, native_build)
        if artifact is None:
            warn(
                "native plugin artifact path is not defined for source {0}".format(
                    source_id
                )
            )
            ok = False
            continue
        if not os.path.isfile(artifact):
            if native_build_optional(native_build):
                info(
                    "optional native plugin artifact not installed for source {0}".format(
                        source_id
                    )
                )
            else:
                warn(
                    "native plugin artifact missing: {0}; run ./manage install".format(
                        artifact
                    )
                )
                ok = False
            continue
        if not check_native_build_revision(worktree, lock, source_id, native_build):
            ok = False
    return ok


def read_json_object(path: str) -> Optional[JSONObject]:
    return read_json_object_file(path, emit_warnings=True)


def validate_upstream_metadata(path: str, metadata: JSONMapping) -> bool:
    required_strings = ("url", "commit")
    for key in required_strings:
        value = metadata.get(key)
        if not isinstance(value, str) or not value:
            warn("{0} {1} must be a non-empty string".format(path, key))
            return False

    optional_strings = ("ref", "importedAt", "notes")
    for key in optional_strings:
        value = metadata.get(key)
        if value is not None and not isinstance(value, str):
            warn("{0} {1} must be a string".format(path, key))
            return False

    return True


def nested_git_path(path: str) -> Optional[str]:
    for current_root, directory_names, file_names in os.walk(path):
        if ".git" in directory_names:
            return os.path.join(current_root, ".git")
        if ".git" in file_names:
            return os.path.join(current_root, ".git")
    return None


def discover_vendored_plugins(repository: str) -> Optional[Sequence[str]]:
    init_path = os.path.join(repository, "init.lua")
    try:
        with open(init_path, encoding="utf-8") as file:
            text = file.read()
    except OSError as exc:
        warn("unable to read {0}: {1}".format(init_path, exc))
        return None
    return sorted(set(VENDORED_PLUGIN_CALL_PATTERN.findall(text)))


def check_vendored_plugins(repository: str) -> bool:
    plugin_names = discover_vendored_plugins(repository)
    if plugin_names is None:
        return False

    ok = True
    repository_realpath = os.path.realpath(repository)
    for plugin_name in plugin_names:
        path = vendored_plugin_dir(repository, plugin_name)
        realpath = os.path.realpath(path)
        if not os.path.isdir(path):
            warn("vendored plugin not found: {0}".format(path))
            ok = False
            continue
        if not path_within_repository(repository_realpath, realpath):
            warn("vendored plugin escapes repository: {0}".format(path))
            ok = False
        git_path = nested_git_path(path)
        if git_path is not None:
            warn("vendored plugin contains nested .git: {0}".format(git_path))
            ok = False
        upstream_path = os.path.join(path, UPSTREAM_METADATA_NAME)
        if os.path.exists(upstream_path):
            metadata = read_json_object(upstream_path)
            if metadata is None or not validate_upstream_metadata(
                upstream_path, metadata
            ):
                ok = False
    return ok


def expand_lua_library_path(
    path: str, env: Mapping[str, str], repository: str
) -> Optional[str]:
    if "${3rd}" in path:
        return None

    missing = []

    def replace_env(match: re.Match[str]) -> str:
        name = match.group(1)
        value = env.get(name)
        if value is None:
            missing.append(name)
            return match.group(0)
        return value

    expanded = ENV_VARIABLE_PATTERN.sub(replace_env, path)
    if missing:
        raise RuntimeError(
            "environment variable missing in .luarc.json: {0}".format(missing[0])
        )

    if "${" in expanded:
        raise RuntimeError("unsupported variable in .luarc.json path: {0}".format(path))

    if os.path.isabs(expanded):
        return expanded
    return os.path.join(repository, expanded)


def lua_workspace_libraries(
    env: Mapping[str, str], repository: str
) -> Optional[Sequence[str]]:
    config_path = os.path.join(repository, ".luarc.json")
    try:
        with open(config_path, encoding="utf-8") as file:
            config = json.load(file)
    except OSError as exc:
        warn("unable to read {0}: {1}".format(config_path, exc))
        return None
    except json.JSONDecodeError as exc:
        warn("unable to parse {0}: {1}".format(config_path, exc))
        return None

    libraries = config.get("workspace.library", [])
    if not isinstance(libraries, list):
        warn(".luarc.json workspace.library must be a list")
        return None

    expanded_libraries = []
    for library in libraries:
        if not isinstance(library, str):
            warn(".luarc.json workspace.library entries must be strings")
            return None
        try:
            expanded = expand_lua_library_path(library, env, repository)
        except RuntimeError as exc:
            warn(str(exc))
            return None
        if expanded is not None:
            expanded_libraries.append(expanded)

    return expanded_libraries


def discover_lua_specs(repository: str) -> Sequence[str]:
    root = os.path.join(repository, LUA_CHECK_PATH)
    specs = []
    for directory, _, filenames in os.walk(root):
        for filename in filenames:
            if filename.endswith("_spec.lua"):
                specs.append(os.path.join(directory, filename))
    return sorted(specs)


def check(fix: bool) -> int:
    """Run development checks without installing tools implicitly."""
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1

    repository = repository_dir()
    env = install_environment(home)
    if not env.get("XDG_DATA_HOME"):
        env["XDG_DATA_HOME"] = os.path.join(home, ".local", "share")

    uv = resolve_required("uv", env)
    stylua = resolve_required("stylua", env)
    lua_language_server = resolve_required("lua-language-server", env)
    nvim = resolve_required("nvim", env)
    if uv is None or stylua is None or lua_language_server is None or nvim is None:
        return 1

    lock = load_git_worktrees_lock(repository)
    if lock is None:
        return 1

    ok = True
    if not check_git_sources(env, repository, lock):
        ok = False
    if not check_treesitter_runtime(env, repository, lock):
        ok = False
    if not check_native_plugin_artifacts(repository, lock):
        ok = False
    if not check_vendored_plugins(repository):
        ok = False

    runtime = neovim_runtime(nvim, env, repository)
    if not runtime:
        return 1
    env["VIMRUNTIME"] = runtime

    libraries = lua_workspace_libraries(env, repository)
    if libraries is None:
        return 1

    missing_libraries = [library for library in libraries if not os.path.isdir(library)]
    if missing_libraries:
        for library in missing_libraries:
            warn("{0} not found; run ./manage install".format(library))
        return 1

    plenary = source_worktree_by_id(repository, lock, PLENARY_PLUGIN_NAME)
    if plenary is None:
        return 1
    if not os.path.isdir(plenary):
        warn("{0} not found; run ./manage install".format(plenary))
        return 1

    specs = discover_lua_specs(repository)
    if not specs:
        warn("no Lua spec files found under {0}".format(LUA_CHECK_PATH))
        return 1

    lua_language_server_commands = [
        [
            lua_language_server,
            "--check=" + target,
            "--checklevel=Warning",
            "--check_format=pretty",
            "--configpath=" + os.path.join(repository, ".luarc.json"),
        ]
        for target in LUA_CHECK_TARGETS
    ]

    ruff_format = [uv, *UV_RUN_CHECK, "ruff", "format"]
    if not fix:
        ruff_format.append("--check")
    ruff_format.append("manage")

    ruff_check = [uv, *UV_RUN_CHECK, "ruff", "check"]
    if fix:
        ruff_check.append("--fix")
    ruff_check.append("manage")

    stylua_check = [stylua]
    if not fix:
        stylua_check.append("--check")
    stylua_check.extend(LUA_CHECK_TARGETS)

    commands = [
        ruff_format,
        ruff_check,
        [uv, *UV_RUN_CHECK, "ty", "check", "manage"],
        stylua_check,
        *lua_language_server_commands,
    ]

    runtimepath_command = (
        "lua vim.opt.runtimepath:prepend({0}); vim.opt.runtimepath:prepend({1})".format(
            json.dumps(plenary), json.dumps(repository)
        )
    )
    plenary_command = [
        nvim,
        "--headless",
        "--noplugin",
        "--cmd",
        runtimepath_command,
        "-c",
        "lua require('plenary.test_harness').test_directory("
        + json.dumps(LUA_CHECK_PATH)
        + ", { sequential = true })",
    ]

    for command in commands:
        if not run_logged_command(command, env, repository):
            ok = False

    if not run_logged_command(
        plenary_command,
        env,
        repository,
        "plenary: {0} Lua spec file(s) passed".format(len(specs)),
        show_success_output_on_stderr=False,
    ):
        ok = False

    return 0 if ok else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="manage")
    subparsers = parser.add_subparsers(dest="command", title="commands")

    install_parser = subparsers.add_parser(
        "install",
        help="sync production dependencies and install Neovim plugins",
        description="Install production dependencies when needed, then install Neovim plugins.",
    )
    install_parser.add_argument(
        "--offline",
        action="store_true",
        help="verify already-local state only; do not fetch, build, or mutate",
    )

    check_parser = subparsers.add_parser(
        "check",
        help="run Python and Lua development checks",
        description="Run Python and Lua development checks without installing tools implicitly.",
    )
    check_parser.add_argument(
        "--fix",
        action="store_true",
        help="format and apply safe fixes before running non-mutating checks",
    )

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "install":
        return install(args.offline)

    if args.command == "check":
        return check(args.fix)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
