# Result kind for classify_schemastore_url. "kept" pairs with a non-None path;
# "external" and "missing" pair with None. These cases partition every URL.
SchemaUrlKind: TypeAlias = Literal["kept", "external", "missing"]


def classify_schemastore_url(
    url: object, repository: str, schemas_dir: str, schemas_dir_real: str
) -> tuple[SchemaUrlKind, Optional[str]]:
    if not isinstance(url, str):
        return "external", None
    match = SCHEMASTORE_URL_PATTERN.match(url)
    if match is None:
        return "external", None
    absolute = os.path.join(schemas_dir, match.group("tail") + ".json")
    real = os.path.realpath(absolute)
    if not real.startswith(schemas_dir_real + os.sep):
        # Defensive: a hostile catalog URL that resolves outside the vendored
        # tree (e.g. via ../) is treated as missing rather than kept.
        return "missing", None
    if not os.path.isfile(real):
        return "missing", None
    return "kept", repository_relative_posix(repository, real)


@dataclasses.dataclass
class SchemaClassificationCounts:
    entries_external: int = 0
    entries_missing: int = 0
    entries_overridden: int = 0
    versions_external: int = 0
    versions_missing: int = 0


def resolve_schema_catalog_override(
    url: object, repository: str, schemas_dir: str, schemas_dir_real: str
) -> Optional[str]:
    """Return the repo-relative POSIX path for an overridden URL, or None.

    Honors the same path-traversal containment as classify_schemastore_url.
    A stale override (file gone from the vendored tree) returns None so the
    entry falls back to the regular classification path.
    """
    if not isinstance(url, str):
        return None
    filename = SCHEMA_CATALOG_OVERRIDES.get(url)
    if filename is None:
        return None
    absolute = os.path.join(schemas_dir, filename)
    real = os.path.realpath(absolute)
    if not real.startswith(schemas_dir_real + os.sep):
        return None
    if not os.path.isfile(real):
        return None
    return repository_relative_posix(repository, real)


def classify_schema_entries(
    catalog: JSONMapping, repository: str, schemas_dir: str
) -> tuple[list[JSONObject], SchemaClassificationCounts]:
    raw_entries = catalog.get("schemas")
    if not isinstance(raw_entries, list):
        return [], SchemaClassificationCounts()

    schemas_dir_real = os.path.realpath(schemas_dir)
    entries: list[JSONObject] = []
    counts = SchemaClassificationCounts()

    for raw in raw_entries:
        if not isinstance(raw, dict):
            continue
        url = raw.get("url")
        kind, relative = classify_schemastore_url(
            url, repository, schemas_dir, schemas_dir_real
        )
        if kind != "kept":
            override_relative = resolve_schema_catalog_override(
                url, repository, schemas_dir, schemas_dir_real
            )
            if override_relative is not None:
                relative = override_relative
                counts.entries_overridden += 1
            elif kind == "external":
                counts.entries_external += 1
                continue
            else:
                counts.entries_missing += 1
                continue
        if relative is None:
            # Defensive: classify_schemastore_url("kept", ...) always pairs
            # with a non-None path, but typing allows None.
            counts.entries_missing += 1
            continue
        entry: JSONObject = {"path": relative}
        for key in ("name", "description", "fileMatch"):
            value = raw.get(key)
            if value is not None:
                entry[key] = value
        raw_versions = raw.get("versions")
        if isinstance(raw_versions, dict):
            kept: JSONObject = {}
            for version_key, version_url in raw_versions.items():
                if not isinstance(version_key, str):
                    continue
                v_kind, v_relative = classify_schemastore_url(
                    version_url, repository, schemas_dir, schemas_dir_real
                )
                if v_kind == "external":
                    counts.versions_external += 1
                elif v_kind == "missing" or v_relative is None:
                    counts.versions_missing += 1
                else:
                    kept[version_key] = v_relative
            if kept:
                entry["versions"] = kept
        entries.append(entry)

    return entries, counts


def lua_quote(value: str) -> str:
    buffer: list[str] = ["'"]
    for char in value:
        code = ord(char)
        if char == "\\":
            buffer.append("\\\\")
        elif char == "'":
            buffer.append("\\'")
        elif char == "\n":
            buffer.append("\\n")
        elif char == "\r":
            buffer.append("\\r")
        elif char == "\t":
            buffer.append("\\t")
        elif code < 32 or code == 127:
            buffer.append("\\{0:03d}".format(code))
        else:
            buffer.append(char)
    buffer.append("'")
    return "".join(buffer)


def write_schema_catalog_lua(path: str, entries: Sequence[JSONMapping]) -> bool:
    try:
        body = json.dumps(
            {"entries": list(entries)},
            ensure_ascii=False,
            allow_nan=False,
            separators=(",", ":"),
        )
        # Choose delimiters against encoded JSON, and validate UTF-8 before opening the output.
        delimiter = "="
        while "]" + delimiter + "]" in body:
            delimiter += "="
        content = (
            "-- Generated by ./manage install; do not edit.\n"
            "-- stylua: ignore start\n"
            "return vim.json.decode(["
            + delimiter
            + "["
            + body
            + "]"
            + delimiter
            + "])\n"
            "-- stylua: ignore end\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as exc:
        warn("unable to serialize schema catalog: {0}".format(exc))
        return False
    try:
        with open(path, "wb") as file:
            file.write(content)
    except OSError as exc:
        warn("unable to write {0}: {1}".format(path, exc))
        return False
    return True


def schema_catalog_overrides_sha256() -> str:
    """SHA-256 of the override map as canonical JSON. Including this in the
    state signature means editing SCHEMA_CATALOG_OVERRIDES forces regeneration
    on the next install, without anyone having to remember to bump the
    generator version."""
    serialized = json.dumps(
        SCHEMA_CATALOG_OVERRIDES, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(serialized).hexdigest()


def schema_catalog_metadata_signature(commit: str, catalog_sha256: str) -> JSONObject:
    return {
        "sourceId": SCHEMASTORE_SOURCE_ID,
        "generatorVersion": SCHEMA_CATALOG_GENERATOR_VERSION,
        "commit": commit,
        "catalogSha256": catalog_sha256,
        "overridesSha256": schema_catalog_overrides_sha256(),
    }


def schema_catalog_state_ok(
    repository: str, lock: JSONMapping, emit_warnings: bool
) -> bool:
    expected_commit = source_commit_by_id(lock, SCHEMASTORE_SOURCE_ID)
    if expected_commit is None:
        return True
    catalog_json = schemastore_catalog_json_path(repository, lock)
    if catalog_json is None:
        return False

    lua_path = schema_catalog_lua_path(repository)
    metadata_path = schema_catalog_metadata_path(repository)

    if not os.path.isfile(lua_path):
        if emit_warnings:
            warn("schema catalog missing: {0}; run ./manage install".format(lua_path))
        return False

    metadata = read_json_object_file(metadata_path, emit_warnings=emit_warnings)
    if metadata is None:
        return False

    catalog_sha = sha256_file(catalog_json, emit_warnings=emit_warnings)
    if catalog_sha is None:
        return False

    expected = schema_catalog_metadata_signature(expected_commit, catalog_sha)
    for key, value in expected.items():
        if metadata.get(key) != value:
            if emit_warnings:
                warn(
                    "schema catalog state mismatch ({0}); run ./manage install".format(
                        key
                    )
                )
            return False
    return True


def materialize_schema_catalog(repository: str, lock: JSONMapping) -> bool:
    expected_commit = source_commit_by_id(lock, SCHEMASTORE_SOURCE_ID)
    if expected_commit is None:
        return True
    catalog_json = schemastore_catalog_json_path(repository, lock)
    schemas_dir = schemastore_schemas_dir(repository, lock)
    if catalog_json is None or schemas_dir is None:
        return False

    if schema_catalog_state_ok(repository, lock, emit_warnings=False):
        return True

    if not os.path.isfile(catalog_json):
        warn(
            "schemastore catalog missing: {0}; run ./manage install --refresh".format(
                catalog_json
            )
        )
        return False
    if not os.path.isdir(schemas_dir):
        warn(
            "schemastore schemas directory missing: {0}; "
            "run ./manage install --refresh".format(schemas_dir)
        )
        return False

    catalog = read_json_object_file(catalog_json, emit_warnings=True)
    if catalog is None:
        return False

    catalog_sha = sha256_file(catalog_json)
    if catalog_sha is None:
        return False

    entries, counts = classify_schema_entries(catalog, repository, schemas_dir)
    if not entries:
        warn("schema catalog produced zero entries; refusing to publish")
        return False

    root = schema_catalog_root(repository)
    parent = os.path.dirname(root)
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(parent, exc))
        return False

    info(
        "materializing schema catalog ({0} entries kept including {1} via "
        "override; dropped {2} entries ({3} missing, {4} external) and {5} "
        "version aliases ({6} missing, {7} external))".format(
            len(entries),
            counts.entries_overridden,
            counts.entries_missing + counts.entries_external,
            counts.entries_missing,
            counts.entries_external,
            counts.versions_missing + counts.versions_external,
            counts.versions_missing,
            counts.versions_external,
        )
    )
    with tempfile.TemporaryDirectory(
        prefix=".{0}.{1}.".format(SCHEMASTORE_SOURCE_ID, os.getpid()), dir=parent
    ) as staging_root:
        staged_root = os.path.join(staging_root, "install")
        try:
            os.makedirs(staged_root, exist_ok=True)
        except OSError as exc:
            warn("unable to create staging directory: {0}".format(exc))
            return False

        if not write_schema_catalog_lua(
            os.path.join(staged_root, SCHEMA_CATALOG_LUA_NAME), entries
        ):
            return False

        metadata: JSONObject = dict(
            schema_catalog_metadata_signature(expected_commit, catalog_sha)
        )
        metadata["entries"] = len(entries)
        metadata["entriesMissing"] = counts.entries_missing
        metadata["entriesExternal"] = counts.entries_external
        metadata["entriesOverridden"] = counts.entries_overridden
        metadata["versionsMissing"] = counts.versions_missing
        metadata["versionsExternal"] = counts.versions_external
        try:
            with open(
                os.path.join(staged_root, SCHEMA_CATALOG_METADATA_NAME),
                "w",
                encoding="utf-8",
            ) as file:
                json.dump(metadata, file, indent=2, sort_keys=True)
                file.write("\n")
        except OSError as exc:
            warn("unable to write schema catalog metadata: {0}".format(exc))
            return False

        if not replace_directory(root, staged_root):
            return False
    return True


def install_managed_state_ok(
    env: Mapping[str, str],
    repository: str,
    lock: JSONMapping,
    emit_warnings: bool,
    check_treesitter_runtime: bool = True,
) -> bool:
    ok = True
    if not git_sources_state_ok(env, repository, lock, emit_warnings=emit_warnings):
        ok = False
    if not treesitter_released_sources_state_ok(
        repository, lock, emit_warnings=emit_warnings
    ):
        ok = False
    if not schema_catalog_state_ok(repository, lock, emit_warnings=emit_warnings):
        ok = False
    if not native_plugin_artifacts_state_ok(
        repository, lock, emit_warnings=emit_warnings
    ):
        ok = False
    if check_treesitter_runtime and not treesitter_runtime_state_ok(
        repository, lock, emit_warnings=emit_warnings, env=env
    ):
        ok = False
    return ok


def install(offline: bool, refresh: bool) -> int:
    """Install production dependencies and Neovim plugins."""
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1

    repository = repository_dir()
    env = install_environment(home)

    ok = True
    if offline:
        info(
            "offline mode: verifying local state; will regenerate local-only "
            "derived artifacts if their vendored sources are present"
        )
        if os.path.exists(os.path.join(repository, "pyproject.toml")):
            info("offline mode: skipped uv production sync")
        if os.path.exists(os.path.join(repository, "package.json")):
            info("offline mode: skipped pnpm production install")
    else:
        if not sync_uv_production_if_needed(env, repository):
            ok = False
        if not sync_pnpm_production(env, repository):
            ok = False

    lock = load_git_worktrees_lock(repository)
    if lock is None:
        ok = False
    elif offline:
        # Rebuild local-only derived artifacts whose source is already on disk.
        # The schema catalog is a pure JSON-to-Lua transform over the vendored
        # schemastore worktree. The Treesitter runtime can also be rebuilt
        # offline from managed local sources when the installed `tree-sitter`
        # CLI satisfies the pinned minimum version; if that CLI is missing or
        # too old, offline mode warns and skips that runtime for this run so the
        # same CLI and runtime checks are retried on the next run.
        #
        # Native plugin artifacts still need `cargo`, `make`, or similar
        # toolchains and may require dependency state that offline mode cannot
        # acquire, so we leave them to `install_managed_state_ok` to flag.
        #
        # An unconfigured schema source is optional. A configured but missing
        # source fails both catalog materialization and managed-state checking.
        if not materialize_schema_catalog(repository, lock):
            ok = False
        tree_sitter_cli_ok = check_tree_sitter_cli(
            env, repository, treesitter_minimum_cli_version(lock)
        )
        tree_sitter_sources_ok = git_sources_state_ok(
            env, repository, lock, emit_warnings=False
        ) and treesitter_released_sources_state_ok(
            repository, lock, emit_warnings=False
        )
        if tree_sitter_cli_ok and tree_sitter_sources_ok:
            if not install_treesitter_runtime(env, repository, lock):
                ok = False
        elif not tree_sitter_cli_ok:
            warn(
                "offline mode: skipped Treesitter runtime install and validation because tree-sitter CLI is missing or too old"
            )
        else:
            warn(
                "offline mode: skipped Treesitter runtime install because managed source state is incomplete"
            )
        if not install_managed_state_ok(
            env,
            repository,
            lock,
            emit_warnings=True,
            check_treesitter_runtime=tree_sitter_cli_ok,
        ):
            ok = False
        if not link_neovim_config(home, repository):
            ok = False
        return 0 if ok else 1
    else:
        if not refresh and install_managed_state_ok(
            env, repository, lock, emit_warnings=False
        ):
            info(
                "managed state already current; skipped source, build, and Treesitter install steps"
            )
        else:
            git_sources_ready = materialize_git_sources(env, repository, lock, refresh)
            if not git_sources_ready:
                ok = False
            tree_sitter_released_sources_ready = (
                materialize_treesitter_released_sources(repository, lock)
            )
            if not tree_sitter_released_sources_ready:
                ok = False
            if not materialize_schema_catalog(repository, lock):
                ok = False
            if git_sources_ready:
                if not install_native_plugin_artifacts(env, repository, lock):
                    ok = False
            else:
                warn("skipped native builds because managed source state is incomplete")
            if git_sources_ready and tree_sitter_released_sources_ready:
                if not install_treesitter_runtime(env, repository, lock):
                    ok = False
            else:
                warn(
                    "skipped Treesitter runtime install because managed source state is incomplete"
                )

    if not link_neovim_config(home, repository):
        ok = False

    return 0 if ok else 1


def command_name(command: Sequence[str]) -> str:
    return shlex.join(command)


def print_command(command: Sequence[str]) -> None:
    info("$ {0}".format(command_name(command)))


def print_completed_output(completed: subprocess.CompletedProcess[str]) -> None:
    if completed.stdout:
        print(completed.stdout, end="" if completed.stdout.endswith("\n") else "\n")
    if completed.stderr:
        print(
            completed.stderr,
            end="" if completed.stderr.endswith("\n") else "\n",
            file=sys.stderr,
        )


def run_logged_command(
    command: Sequence[str],
    env: Mapping[str, str],
    repository: str,
    success_message: Optional[str] = None,
    show_success_output_on_stderr: bool = True,
) -> bool:
    print_command(command)
    completed = run_captured_command(command, env, repository)
    if completed is None:
        return False
    if completed.returncode == 0:
        if show_success_output_on_stderr and completed.stderr:
            print_completed_output(completed)
        if success_message:
            info(success_message)
        return True

    print_completed_output(completed)
    warn(
        "command failed with exit code {0}: {1}".format(
            completed.returncode, command_name(command)
        )
    )
    return False


def resolve_required(name: str, env: Mapping[str, str]) -> Optional[str]:
    path = shutil.which(name, path=env.get("PATH"))
    if not path:
        warn("{0} not found on PATH".format(name))
    return path


def neovim_value(
    nvim: str, expression: str, env: Mapping[str, str], repository: str
) -> Optional[str]:
    command = [
        nvim,
        "--clean",
        "--headless",
        "--cmd",
        "lua io.write(" + expression + ")",
        "--cmd",
        "qa",
    ]
    completed = run_captured_command(command, env, repository)
    if completed is None:
        return None
    if completed.returncode != 0:
        warn("unable to query nvim: {0}".format(completed.stderr.strip()))
        return None

    value = completed.stdout.strip()
    if not value:
        warn("nvim returned an empty value for {0}".format(expression))
        return None
    return value


def neovim_runtime(nvim: str, env: Mapping[str, str], repository: str) -> Optional[str]:
    return neovim_value(nvim, "vim.env.VIMRUNTIME", env, repository)


def vendor_dir(repository: str) -> str:
    return os.path.join(repository, VENDOR_DIR_NAME)


def vendored_plugins_dir(repository: str) -> str:
    return os.path.join(vendor_dir(repository), VENDORED_PLUGINS_DIR_NAME)


def vendored_plugin_dir(repository: str, plugin_name: str) -> str:
    return os.path.join(vendored_plugins_dir(repository), plugin_name)


def source_native_build(source: JSONMapping) -> JSONMapping:
    return cast(JSONMapping, source_plugin_metadata(source).get("nativeBuild", {}))


def native_build_optional(native_build: JSONMapping) -> bool:
    return bool(native_build.get("optional", False))


def native_build_minimum_cargo_version(
    native_build: JSONMapping,
) -> Optional[tuple[int, int, int]]:
    value = native_build.get("minimumCargoVersion")
    if not isinstance(value, str):
        return None
    return parse_version_tuple(value)


def native_build_cargo_package(native_build: JSONMapping) -> Optional[str]:
    value = native_build.get("package")
    return value if isinstance(value, str) and value else None


def native_build_cargo_artifact_stem(native_build: JSONMapping) -> Optional[str]:
    value = native_build.get("artifactStem")
    if not isinstance(value, str) or not value:
        return None
    normalized = validated_relative_subpath(value)
    if normalized is None or has_native_library_extension(normalized):
        return None
    return normalized


def native_build_cargo_features(native_build: JSONMapping) -> Sequence[str]:
    value = native_build.get("features")
    if not isinstance(value, list):
        return ()
    features: list[str] = []
    for item in value:
        if isinstance(item, str) and item:
            features.append(item)
    return tuple(features)


def native_build_cargo_command(native_build: JSONMapping) -> Sequence[str]:
    command = [*CARGO_BUILD_RELEASE]
    package = native_build_cargo_package(native_build)
    if package is not None:
        command.extend(["-p", package])
    features = native_build_cargo_features(native_build)
    if features:
        command.extend(["--features", ",".join(features)])
    return command


def cargo_version(
    cargo: str, env: Mapping[str, str], repository: str
) -> Optional[tuple[int, int, int]]:
    completed = run_captured_command([cargo, "--version"], env, repository)
    if completed is None or completed.returncode != 0:
        return None
    return parse_version_tuple(completed.stdout)


def optional_native_build_outcome(
    native_build: JSONMapping, message: str
) -> NativeBuildOutcome:
    if native_build_optional(native_build):
        warn(message + "; skipping optional native build")
        return "skipped"
    warn(message)
    return "failed"


def native_build_source_ids(lock: JSONMapping) -> Sequence[str]:
    return sorted(
        source_id
        for source_id, source in manifest_sources(lock).items()
        if source_native_build(source)
    )


def native_library_extension() -> str:
    if sys.platform == "darwin":
        return ".dylib"
    if os.name == "nt":
        return ".dll"
    return ".so"


def lua_module_make_overrides() -> Sequence[str]:
    if sys.platform == "darwin":
        return ("LDFLAGS=-bundle -undefined dynamic_lookup", "LDLIBS=")
    return ("LDLIBS=",)


def native_plugin_artifact_path(
    worktree: str, native_build: JSONMapping
) -> Optional[str]:
    kind = native_build.get("kind")
    if kind == "cargo":
        artifact_stem = native_build_cargo_artifact_stem(native_build)
        if artifact_stem is None:
            return None
        return (
            os.path.join(worktree, *artifact_stem.split("/"))
            + native_library_extension()
        )
    if kind == "luasnip_jsregexp":
        return os.path.join(worktree, "deps", "luasnip-jsregexp.so")
    if kind == "make":
        return os.path.join(worktree, "build", "libfzf.so")
    return None


def native_build_revision_path(
    worktree: str, native_build: JSONMapping
) -> Optional[str]:
    kind = native_build.get("kind")
    if kind == "cargo":
        artifact_path = native_plugin_artifact_path(worktree, native_build)
        if artifact_path is None:
            return None
        return os.path.join(os.path.dirname(artifact_path), ".manage-native-build")
    if kind == "luasnip_jsregexp":
        return os.path.join(worktree, "deps", "jsregexp", ".manage-native-build")
    if kind == "make":
        return os.path.join(worktree, "build", ".manage-native-build")
    return None


def native_build_platform_signature_lines() -> Sequence[str]:
    return [
        "platform {0} {1}".format(key, value)
        for key, value in current_platform_signature().items()
    ]


def native_build_revision_text(
    lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> Optional[str]:
    commit = source_commit_by_id(lock, source_id)
    if commit is None:
        warn("source {0} commit must be a non-empty string".format(source_id))
        return None
    lines = ["source {0} {1}".format(source_id, commit)]
    dependency_sources = native_build_dependency_sources(source_id, native_build)
    if dependency_sources is None:
        return None
    for relative_path, dependency_source_id in sorted(dependency_sources.items()):
        dependency_commit = source_commit_by_id(lock, dependency_source_id)
        if dependency_commit is None:
            warn(
                "source {0} dependency source commit is not available: {1}".format(
                    source_id, dependency_source_id
                )
            )
            return None
        lines.append(
            "dependency {0} {1} {2}".format(
                relative_path, dependency_source_id, dependency_commit
            )
        )
    if native_build.get("kind") == "cargo":
        package = native_build_cargo_package(native_build)
        if package is not None:
            lines.append("cargo package {0}".format(package))
        artifact_stem = native_build_cargo_artifact_stem(native_build)
        if artifact_stem is None:
            warn(
                "source {0} plugin.nativeBuild.artifactStem must be a non-empty worktree-relative path without a native library extension".format(
                    source_id
                )
            )
            return None
        lines.append("cargo artifactStem {0}".format(artifact_stem))
        features = native_build_cargo_features(native_build)
        if features:
            lines.append("cargo features {0}".format(",".join(features)))
    lines.extend(native_build_platform_signature_lines())
    return "\n".join(lines)


def write_native_build_revision(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    revision_path = native_build_revision_path(worktree, native_build)
    revision_text = native_build_revision_text(lock, source_id, native_build)
    if revision_path is None or revision_text is None:
        return False
    try:
        with open(revision_path, "w", encoding="utf-8") as file:
            file.write(revision_text + "\n")
    except OSError as exc:
        warn(
            "unable to write native build revision for source {0}: {1}".format(
                source_id, exc
            )
        )
        return False
    return True


def native_build_revision_matches(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    revision_path = native_build_revision_path(worktree, native_build)
    revision_text = native_build_revision_text(lock, source_id, native_build)
    if revision_path is None or revision_text is None:
        return False
    return read_text_file(revision_path) == revision_text


def check_native_build_revision(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    revision_path = native_build_revision_path(worktree, native_build)
    revision_text = native_build_revision_text(lock, source_id, native_build)
    if revision_path is None or revision_text is None:
        return False
    actual = read_text_file(revision_path)
    if actual is None:
        warn(
            "native build revision missing for source {0}: {1}; run ./manage install".format(
                source_id, revision_path
            )
        )
        return False
    if actual != revision_text:
        warn(
            "native build revision mismatch for source {0}; run ./manage install".format(
                source_id
            )
        )
        return False
    return True


def native_build_artifact_current(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    artifact = native_plugin_artifact_path(worktree, native_build)
    if artifact is None or not os.path.isfile(artifact):
        return False
    return native_build_revision_matches(worktree, lock, source_id, native_build)


def overlay_native_build_dependency_sources(
    repository: str,
    lock: JSONMapping,
    worktree: str,
    dependency_sources: Mapping[str, str],
) -> bool:
    for relative_path, dependency_source_id in dependency_sources.items():
        dependency_worktree = source_worktree_by_id(
            repository, lock, dependency_source_id
        )
        if dependency_worktree is None:
            return False
        destination = source_subpath(worktree, relative_path)
        if destination is None:
            return False
        try:
            if os.path.exists(destination) or os.path.islink(destination):
                if not remove_path(destination):
                    return False
            shutil.copytree(
                dependency_worktree,
                destination,
                ignore=shutil.ignore_patterns(".git"),
            )
        except OSError as exc:
            warn(
                "unable to overlay native build dependency source {0} into {1}: {2}".format(
                    dependency_source_id, destination, exc
                )
            )
            return False
    return True


def build_luasnip_jsregexp_runtime(
    make: str,
    env: Mapping[str, str],
    repository: str,
    worktree: str,
) -> bool:
    include_dir = os.path.join(worktree, "deps", "lua51_include")
    for relative_path in LUASNIP_BUILD_DIRS:
        build_dir = os.path.join(worktree, relative_path)
        if not os.path.isdir(build_dir):
            warn("LuaSnip build input missing: {0}".format(build_dir))
            return False
        if not run_logged_command(
            [
                make,
                "-C",
                build_dir,
                "INCLUDE_DIR=-I{0}/".format(include_dir),
                *lua_module_make_overrides(),
            ],
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False

    source_library = os.path.join(worktree, "deps", "jsregexp", "jsregexp.so")
    source_module = os.path.join(worktree, "deps", "jsregexp", "jsregexp.lua")
    if not os.path.isfile(source_library) or not os.path.isfile(source_module):
        warn("LuaSnip jsregexp build outputs missing in {0}".format(worktree))
        return False

    try:
        shutil.copy2(
            source_module, os.path.join(worktree, "lua", "luasnip-jsregexp.lua")
        )
        shutil.copy2(
            source_library, os.path.join(worktree, "deps", "luasnip-jsregexp.so")
        )
    except OSError as exc:
        warn("unable to publish LuaSnip jsregexp artifacts: {0}".format(exc))
        return False
    return True


def build_native_plugin_runtime(
    env: Mapping[str, str],
    repository: str,
    lock: JSONMapping,
    source_id: str,
    worktree: str,
    native_build: JSONMapping,
) -> NativeBuildOutcome:
    source = manifest_sources(lock).get(source_id)
    if source is None or not native_build_paths_ok(worktree, source_id, source):
        return "failed"
    kind = native_build.get("kind")
    if kind == "cargo":
        cargo = resolve_required("cargo", env)
        if cargo is None:
            return optional_native_build_outcome(
                native_build,
                "source {0} requires cargo on PATH".format(source_id),
            )
        minimum_version = native_build_minimum_cargo_version(native_build)
        if minimum_version is not None:
            version = cargo_version(cargo, env, repository)
            if version is None:
                return optional_native_build_outcome(
                    native_build,
                    "unable to query cargo version for source {0}".format(source_id),
                )
            if version < minimum_version:
                return optional_native_build_outcome(
                    native_build,
                    "source {0} requires cargo >= {1}; found {2}".format(
                        source_id,
                        ".".join(str(part) for part in minimum_version),
                        ".".join(str(part) for part in version),
                    ),
                )
        build_env = dict(env, CARGO_TARGET_DIR=os.path.join(worktree, "target"))
        built = run_logged_command(
            [cargo, *native_build_cargo_command(native_build)],
            build_env,
            worktree,
            show_success_output_on_stderr=False,
        )
    elif kind == "make":
        make = resolve_required("make", env)
        built = make is not None and run_logged_command(
            [make], env, worktree, show_success_output_on_stderr=False
        )
    elif kind == "luasnip_jsregexp":
        dependency_sources = native_build_dependency_sources(source_id, native_build)
        if dependency_sources is None:
            return "failed"
        if not overlay_native_build_dependency_sources(
            repository, lock, worktree, dependency_sources
        ):
            return "failed"
        make = resolve_required("make", env)
        if make is None:
            return "failed"
        built = build_luasnip_jsregexp_runtime(make, env, repository, worktree)
    else:
        warn("unsupported native build kind for source {0}".format(source_id))
        return "failed"
    artifact = native_plugin_artifact_path(worktree, native_build)
    if not built or artifact is None or not os.path.isfile(artifact):
        return optional_native_build_outcome(
            native_build,
            "native build failed or produced no artifact for source {0}".format(
                source_id
            ),
        )
    if not native_build_paths_ok(worktree, source_id, source):
        return "failed"
    git = resolve_required("git", env)
    if git is None or not check_worktree_pristine(
        git, env, repository, source_id, worktree, source_allowed_dirty_paths(source)
    ):
        return "failed"
    return (
        "built"
        if write_native_build_revision(worktree, lock, source_id, native_build)
        else "failed"
    )


def install_native_plugin_artifacts(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    ok = True
    sources = manifest_sources(lock)
    for source_id in native_build_source_ids(lock):
        source_value = sources[source_id]
        worktree = source_worktree_by_id(repository, lock, source_id)
        if worktree is None:
            ok = False
            continue
        native_build = source_native_build(source_value)
        if not native_build_paths_ok(worktree, source_id, source_value):
            ok = False
            continue
        if native_build_artifact_current(worktree, lock, source_id, native_build):
            continue
        # Never leave an old library eligible for presence-based runtime loading.
        stale_paths = (
            native_plugin_artifact_path(worktree, native_build),
            native_build_revision_path(worktree, native_build),
        )
        if any(path is None for path in stale_paths):
            ok = False
            continue
        removed = [remove_path(path) for path in stale_paths if path is not None]
        if not all(removed):
            ok = False
            continue
        outcome = build_native_plugin_runtime(
            env, repository, lock, source_id, worktree, native_build
        )
        if outcome == "built" and not native_build_artifact_current(
            worktree, lock, source_id, native_build
        ):
            warn(
                "native build did not produce a current artifact for source {0}".format(
                    source_id
                )
            )
            outcome = "failed"
        if outcome != "built":
            cleaned = [remove_path(path) for path in stale_paths if path is not None]
            if outcome == "failed" or not all(cleaned):
                ok = False
    return ok


def native_plugin_artifacts_state_ok(
    repository: str, lock: JSONMapping, emit_warnings: bool
) -> bool:
    sources = manifest_sources(lock)
    ok = True
    for source_id in native_build_source_ids(lock):
        source_value = sources[source_id]
        worktree = source_worktree_by_id(repository, lock, source_id)
        if worktree is None:
            ok = False
            continue
        native_build = source_native_build(source_value)
        if not native_build_paths_ok(worktree, source_id, source_value):
            ok = False
            continue
        artifact = native_plugin_artifact_path(worktree, native_build)
        if artifact is None:
            if emit_warnings:
                warn(
                    "native plugin artifact path is not defined for source {0}".format(
                        source_id
                    )
                )
            ok = False
            continue
        if not os.path.isfile(artifact):
            if native_build_optional(native_build):
                revision_path = native_build_revision_path(worktree, native_build)
                if revision_path is not None and os.path.lexists(revision_path):
                    if emit_warnings:
                        warn(
                            "orphaned native build revision for source {0}; run ./manage install".format(
                                source_id
                            )
                        )
                    ok = False
                    continue
                if emit_warnings:
                    info(
                        "optional native plugin artifact not installed for source {0}".format(
                            source_id
                        )
                    )
            else:
                if emit_warnings:
                    warn(
                        "native plugin artifact missing: {0}; run ./manage install".format(
                            artifact
                        )
                    )
                ok = False
            continue
        if emit_warnings:
            if not check_native_build_revision(worktree, lock, source_id, native_build):
                ok = False
        elif not native_build_revision_matches(worktree, lock, source_id, native_build):
            ok = False
    return ok


def check_native_plugin_artifacts(repository: str, lock: JSONMapping) -> bool:
    return native_plugin_artifacts_state_ok(repository, lock, emit_warnings=True)


def read_json_object(path: str) -> Optional[JSONObject]:
    return read_json_object_file(path, emit_warnings=True)


def validate_upstream_metadata(path: str, metadata: JSONMapping) -> bool:
    required_strings = ("url", "commit")
    for key in required_strings:
        value = metadata.get(key)
        if not isinstance(value, str) or not value:
            warn("{0} {1} must be a non-empty string".format(path, key))
            return False

    optional_strings = ("ref", "importedAt", "notes")
    for key in optional_strings:
        value = metadata.get(key)
        if value is not None and not isinstance(value, str):
            warn("{0} {1} must be a string".format(path, key))
            return False

    return True


def nested_git_path(path: str) -> Optional[str]:
    for current_root, directory_names, file_names in os.walk(path):
        if ".git" in directory_names:
            return os.path.join(current_root, ".git")
        if ".git" in file_names:
            return os.path.join(current_root, ".git")
    return None


def discover_vendored_plugins(repository: str) -> Optional[Sequence[str]]:
    init_path = os.path.join(repository, "init.lua")
    try:
        with open(init_path, encoding="utf-8") as file:
            text = file.read()
    except OSError as exc:
        warn("unable to read {0}: {1}".format(init_path, exc))
        return None
    return sorted(set(VENDORED_PLUGIN_CALL_PATTERN.findall(text)))


def check_vendored_plugins(repository: str) -> bool:
    plugin_names = discover_vendored_plugins(repository)
    if plugin_names is None:
        return False

    ok = True
    repository_realpath = os.path.realpath(repository)
    for plugin_name in plugin_names:
        path = vendored_plugin_dir(repository, plugin_name)
        realpath = os.path.realpath(path)
        if not os.path.isdir(path):
            warn("vendored plugin not found: {0}".format(path))
            ok = False
            continue
        if not path_within_repository(repository_realpath, realpath):
            warn("vendored plugin escapes repository: {0}".format(path))
            ok = False
        git_path = nested_git_path(path)
        if git_path is not None:
            warn("vendored plugin contains nested .git: {0}".format(git_path))
            ok = False
        upstream_path = os.path.join(path, UPSTREAM_METADATA_NAME)
        if os.path.exists(upstream_path):
            metadata = read_json_object(upstream_path)
            if metadata is None or not validate_upstream_metadata(
                upstream_path, metadata
            ):
                ok = False
    return ok


def expand_lua_library_path(
    path: str, env: Mapping[str, str], repository: str
) -> Optional[str]:
    if "${3rd}" in path:
        return None

    missing = []

    def replace_env(match: re.Match[str]) -> str:
        name = match.group(1)
        value = env.get(name)
        if value is None:
            missing.append(name)
            return match.group(0)
        return value

    expanded = ENV_VARIABLE_PATTERN.sub(replace_env, path)
    if missing:
        raise RuntimeError(
            "environment variable missing in .luarc.json: {0}".format(missing[0])
        )

    if "${" in expanded:
        raise RuntimeError("unsupported variable in .luarc.json path: {0}".format(path))

    if os.path.isabs(expanded):
        return expanded
    return os.path.join(repository, expanded)


def lua_workspace_libraries(
    env: Mapping[str, str], repository: str
) -> Optional[Sequence[str]]:
    config = read_json_object_file(
        os.path.join(repository, ".luarc.json"), emit_warnings=True
    )
    if config is None:
        return None
    libraries = config.get("workspace.library", [])
    if not isinstance(libraries, list):
        warn(".luarc.json workspace.library must be a list")
        return None

    expanded_libraries = []
    for library in libraries:
        if not isinstance(library, str):
            warn(".luarc.json workspace.library entries must be strings")
            return None
        try:
            expanded = expand_lua_library_path(library, env, repository)
        except RuntimeError as exc:
            warn(str(exc))
            return None
        if expanded is not None:
            expanded_libraries.append(expanded)

    return expanded_libraries


def discover_lua_specs(repository: str) -> Sequence[str]:
    root = os.path.join(repository, LUA_CHECK_PATH)
    specs = []
    for directory, _, filenames in os.walk(root):
        for filename in filenames:
            if filename.endswith("_spec.lua"):
                specs.append(os.path.join(directory, filename))
    return sorted(specs)


def check(fix: bool) -> int:
    """Run development checks without installing tools implicitly."""
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1

    repository = repository_dir()
    env = install_environment(home)
    if not env.get("XDG_DATA_HOME"):
        env["XDG_DATA_HOME"] = os.path.join(home, ".local", "share")

    uv = resolve_required("uv", env)
    stylua = resolve_required("stylua", env)
    lua_language_server = resolve_required("lua-language-server", env)
    nvim = resolve_required("nvim", env)
    if uv is None or stylua is None or lua_language_server is None or nvim is None:
        return 1

    lock = load_git_worktrees_lock(repository)
    if lock is None:
        return 1

    ok = True
    if not check_git_sources(env, repository, lock):
        ok = False
    if not check_treesitter_runtime(env, repository, lock):
        ok = False
    if not check_native_plugin_artifacts(repository, lock):
        ok = False
    if not schema_catalog_state_ok(repository, lock, emit_warnings=True):
        ok = False
    if not check_vendored_plugins(repository):
        ok = False

    runtime = neovim_runtime(nvim, env, repository)
    if not runtime:
        return 1
    env["VIMRUNTIME"] = runtime

    libraries = lua_workspace_libraries(env, repository)
    if libraries is None:
        return 1

    missing_libraries = [library for library in libraries if not os.path.isdir(library)]
    if missing_libraries:
        for library in missing_libraries:
            warn("{0} not found; run ./manage install".format(library))
        return 1

    plenary = source_worktree_by_id(repository, lock, PLENARY_PLUGIN_NAME)
    if plenary is None:
        return 1
    if not os.path.isdir(plenary):
        warn("{0} not found; run ./manage install".format(plenary))
        return 1

    specs = discover_lua_specs(repository)
    if not specs:
        warn("no Lua spec files found under {0}".format(LUA_CHECK_PATH))
        return 1

    lua_language_server_commands = [
        [
            lua_language_server,
            "--check=" + target,
            "--checklevel=Warning",
            "--check_format=pretty",
            "--configpath=" + os.path.join(repository, ".luarc.json"),
        ]
        for target in LUA_CHECK_TARGETS
    ]

    ruff_format = [uv, *UV_RUN_CHECK, "ruff", "format"]
    if not fix:
        ruff_format.append("--check")
    ruff_format.extend(["manage", "tests"])

    ruff_check = [uv, *UV_RUN_CHECK, "ruff", "check"]
    if fix:
        ruff_check.append("--fix")
    ruff_check.extend(["manage", "tests"])

    stylua_check = [stylua]
    if not fix:
        stylua_check.append("--check")
    stylua_check.extend(LUA_CHECK_TARGETS)

    commands = [
        ruff_format,
        ruff_check,
        [uv, *UV_RUN_CHECK, "ty", "check", "manage", "tests"],
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"],
        stylua_check,
        *lua_language_server_commands,
    ]

    runtimepath_command = (
        "lua vim.opt.runtimepath:prepend({0}); vim.opt.runtimepath:prepend({1})".format(
            lua_quote(plenary), lua_quote(repository)
        )
    )
    plenary_command = [
        nvim,
        "--headless",
        "--noplugin",
        "--cmd",
        runtimepath_command,
        "-c",
        "lua require('plenary.test_harness').test_directory("
        + lua_quote(LUA_CHECK_PATH)
        + ", { sequential = true })",
    ]

    for command in commands:
        if not run_logged_command(command, env, repository):
            ok = False

    if not ok:
        warn("skipped Plenary because prerequisite or development checks failed")
        return 1
    if not run_logged_command(
        plenary_command,
        env,
        repository,
        "plenary: {0} Lua spec file(s) passed".format(len(specs)),
        show_success_output_on_stderr=False,
    ):
        ok = False

    return 0 if ok else 1


SCAN_TARGETS = (
    os.path.join("vendor", "git", "worktrees"),
    os.path.join("vendor", "plugins"),
    os.path.join("vendor", "schemas"),
    os.path.join("vendor", "treesitter", "sources"),
)
SCAN_RULES_DIR = "rules"


def scan(strict: bool, paths: Sequence[str]) -> int:
    """Scan vendored third-party code for malicious patterns."""
    invocation_directory = os.getcwd()
    repository = repository_dir()
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1
    env = install_environment(home)

    uv = resolve_required("uv", env)
    if uv is None:
        return 1

    rules_dir = os.path.join(repository, SCAN_RULES_DIR)
    if not os.path.isdir(rules_dir):
        warn(
            "rules directory not found: {0}; expected at {1}".format(
                SCAN_RULES_DIR, rules_dir
            )
        )
        return 1

    if paths:
        targets = [
            os.path.abspath(os.path.join(invocation_directory, path)) for path in paths
        ]
        invalid_targets = [
            path
            for path in targets
            if not (os.path.isfile(path) or os.path.isdir(path))
        ]
        if invalid_targets:
            for path in invalid_targets:
                warn(
                    "scan target must be an existing file or directory: {0}".format(
                        path
                    )
                )
            return 1
    else:
        targets = [
            os.path.join(repository, subdir)
            for subdir in SCAN_TARGETS
            if os.path.isdir(os.path.join(repository, subdir))
        ]
        if not targets:
            warn("no vendor directories found; run ./manage install first")
            return 1

    semgrep_command = [
        uv,
        *UV_RUN_CHECK,
        "semgrep",
        "--config",
        SCAN_RULES_DIR,
        "--severity",
        "ERROR",
        "--error",
        "--no-git-ignore",
    ]
    if strict:
        semgrep_command.extend(["--severity", "WARNING"])
    semgrep_command.extend(targets)

    return 0 if run_logged_command(semgrep_command, env, repository) else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="manage")
    subparsers = parser.add_subparsers(dest="command", title="commands")

    install_parser = subparsers.add_parser(
        "install",
        help="sync production dependencies and ensure the managed Neovim runtime",
        description=(
            "Sync production dependencies when needed, then ensure the pinned managed "
            "Neovim runtime locally. Repeated installs skip source, build, and "
            "Treesitter work when local state is already current."
        ),
    )
    install_mode = install_parser.add_mutually_exclusive_group()
    install_mode.add_argument(
        "--offline",
        action="store_true",
        help="verify already-local managed state, rebuild local-only derived artifacts, and never fetch; warn and skip Treesitter runtime work when tree-sitter is missing or too old; still ensure the Neovim config link",
    )
    install_mode.add_argument(
        "--refresh",
        action="store_true",
        help="force Git ref refresh before ensuring the pinned manifest state locally",
    )

    check_parser = subparsers.add_parser(
        "check",
        help="run Python and Lua development checks",
        description="Run Python and Lua development checks without installing tools implicitly.",
    )
    check_parser.add_argument(
        "--fix",
        action="store_true",
        help="format and apply safe fixes before running non-mutating checks",
    )

    scan_parser = subparsers.add_parser(
        "scan",
        help="run semgrep security scan on vendored third-party code",
        description=(
            "Scan vendor directories, or explicit files and directories, for malicious "
            "code patterns using semgrep rules from rules/. By default exits non-zero "
            "only on ERROR-severity findings. Run ./manage install first to populate "
            "vendor directories when no scan path is provided."
        ),
    )
    scan_parser.add_argument(
        "--strict",
        action="store_true",
        help="exit non-zero on WARNING findings in addition to ERROR findings",
    )
    scan_parser.add_argument(
        "paths",
        nargs="*",
        help="optional files or directories to scan; defaults to managed vendor directories",
    )

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "install":
        return install(args.offline, args.refresh)

    if args.command == "check":
        return check(args.fix)

    if args.command == "scan":
        return scan(args.strict, args.paths)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
