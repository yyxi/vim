def publish_runtime_subdirectories(
    runtime_site: str, staged_runtime_site: str, children: Sequence[str]
) -> bool:
    try:
        os.makedirs(runtime_site, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(runtime_site, exc))
        return False

    backups: list[tuple[str, str]] = []
    try:
        for child in children:
            target = os.path.join(runtime_site, child)
            if not (os.path.exists(target) or os.path.islink(target)):
                continue
            backup = target + ".previous.{0}.{1}".format(os.getpid(), time.time_ns())
            os.rename(target, backup)
            backups.append((target, backup))
    except OSError as exc:
        for target, backup in reversed(backups):
            if os.path.exists(backup) or os.path.islink(backup):
                try:
                    os.rename(backup, target)
                except OSError:
                    pass
        warn("unable to stage Treesitter runtime publication: {0}".format(exc))
        return False

    published_targets: list[str] = []
    try:
        for child in children:
            target = os.path.join(runtime_site, child)
            staged = os.path.join(staged_runtime_site, child)
            os.rename(staged, target)
            published_targets.append(target)
    except OSError as exc:
        for target in reversed(published_targets):
            if os.path.exists(target) or os.path.islink(target):
                remove_path(target)
        for target, backup in reversed(backups):
            if os.path.exists(backup) or os.path.islink(backup):
                try:
                    os.rename(backup, target)
                except OSError:
                    pass
        warn("unable to publish Treesitter runtime: {0}".format(exc))
        return False

    for _, backup in backups:
        if os.path.exists(backup) or os.path.islink(backup):
            remove_path(backup)
    return True


def sha256_file(path: str, emit_warnings: bool = True) -> Optional[str]:
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(chunk)
    except OSError as exc:
        if emit_warnings:
            warn("unable to read {0}: {1}".format(path, exc))
        return None
    return digest.hexdigest()


def verify_file_sha256(path: str, expected: str, emit_warnings: bool = True) -> bool:
    actual = sha256_file(path, emit_warnings=emit_warnings)
    if actual is None:
        return False
    if actual != expected:
        if emit_warnings:
            warn(
                "SHA-256 mismatch for {0}: expected {1}, got {2}".format(
                    path, expected, actual
                )
            )
        return False
    return True


def normalize_archive_member_path(path: str) -> Optional[str]:
    normalized = normalize_relative_subpath(path)
    if not normalized:
        return None
    if normalized in (".", "..") or normalized.startswith("../"):
        return None
    return normalized


def extract_tar_gz(archive: str, destination: str) -> bool:
    try:
        with tarfile.open(archive, "r:gz") as tar:
            for member in tar.getmembers():
                normalized = normalize_archive_member_path(member.name)
                if normalized is None:
                    continue
                if member.islnk() or member.issym():
                    warn(
                        "unsupported symlink in Treesitter released source archive: {0}".format(
                            member.name
                        )
                    )
                    return False
                target = os.path.join(destination, normalized)
                if not path_within_repository(destination, target):
                    warn(
                        "Treesitter released source archive path escapes extraction root: {0}".format(
                            member.name
                        )
                    )
                    return False
                if member.isdir():
                    os.makedirs(target, exist_ok=True)
                    continue
                if not member.isfile():
                    continue
                os.makedirs(os.path.dirname(target), exist_ok=True)
                extracted = tar.extractfile(member)
                if extracted is None:
                    warn(
                        "unable to extract Treesitter released source archive member: {0}".format(
                            member.name
                        )
                    )
                    return False
                with extracted:
                    with open(target, "wb") as output:
                        shutil.copyfileobj(extracted, output)
    except (OSError, tarfile.TarError) as exc:
        warn(
            "unable to extract Treesitter released source archive {0}: {1}".format(
                archive, exc
            )
        )
        return False
    return True


def copy_treesitter_released_source_paths(
    source_root: str, destination_root: str, paths: Sequence[str]
) -> bool:
    try:
        for relative_path in paths:
            source = os.path.join(source_root, relative_path)
            destination = os.path.join(destination_root, relative_path)
            if not os.path.exists(source):
                warn(
                    "Treesitter released source retained path missing: {0}".format(
                        source
                    )
                )
                return False
            if os.path.isdir(source):
                shutil.copytree(source, destination)
            else:
                os.makedirs(os.path.dirname(destination), exist_ok=True)
                shutil.copy2(source, destination)
    except OSError as exc:
        warn("unable to copy Treesitter released source paths: {0}".format(exc))
        return False
    return True


def read_json_object_file(path: str, emit_warnings: bool) -> Optional[JSONObject]:
    try:
        with open(path, encoding="utf-8") as file:
            value = json.load(file)
    except OSError as exc:
        if emit_warnings:
            warn("unable to read {0}: {1}".format(path, exc))
        return None
    except json.JSONDecodeError as exc:
        if emit_warnings:
            warn("unable to parse {0}: {1}".format(path, exc))
        return None
    if not isinstance(value, dict):
        if emit_warnings:
            warn("{0} must contain a JSON object".format(path))
        return None
    return value


def treesitter_released_source_state_ok(
    repository: str,
    lock: JSONMapping,
    source_id: str,
    source: JSONMapping,
    emit_warnings: bool,
) -> bool:
    released_source = source_treesitter_released_source(source)
    if not released_source:
        return True

    archive = treesitter_released_source_archive_path(repository, lock, source_id)
    metadata_path = treesitter_released_source_metadata_path(
        repository, lock, source_id
    )
    source_root = treesitter_released_source_source_path(repository, lock, source_id)
    if archive is None or metadata_path is None or source_root is None:
        return False

    if not os.path.isfile(archive):
        if emit_warnings:
            warn(
                "Treesitter released source archive missing: {0}; run ./manage install".format(
                    archive
                )
            )
        return False

    expected_sha256 = released_source.get("sha256")
    if not isinstance(expected_sha256, str) or not verify_file_sha256(
        archive, expected_sha256, emit_warnings=emit_warnings
    ):
        return False

    metadata = read_json_object_file(metadata_path, emit_warnings=emit_warnings)
    if metadata is None:
        return False
    expected_url = released_source.get("url")
    expected_files = list(treesitter_released_source_files(released_source))
    if (
        metadata.get("url") != expected_url
        or metadata.get("sha256") != expected_sha256
        or metadata.get("files") != expected_files
    ):
        if emit_warnings:
            warn(
                "Treesitter released source metadata mismatch for {0}; run ./manage install".format(
                    source_id
                )
            )
        return False

    for relative_path in expected_files:
        path = os.path.join(source_root, relative_path)
        if not os.path.exists(path):
            if emit_warnings:
                warn(
                    "Treesitter released source path missing: {0}; run ./manage install".format(
                        path
                    )
                )
            return False
    return True


def materialize_treesitter_released_source(
    repository: str,
    lock: JSONMapping,
    source_id: str,
    source: JSONMapping,
) -> bool:
    released_source = source_treesitter_released_source(source)
    if not released_source:
        return True
    if treesitter_released_source_state_ok(
        repository, lock, source_id, source, emit_warnings=False
    ):
        return True

    root = treesitter_released_source_root_path(repository, lock, source_id)
    if root is None:
        return False

    url = released_source.get("url")
    sha256 = released_source.get("sha256")
    files = list(treesitter_released_source_files(released_source))
    if not isinstance(url, str) or not isinstance(sha256, str) or not files:
        warn(
            "invalid Treesitter released source metadata for source {0}".format(
                source_id
            )
        )
        return False

    parent = os.path.dirname(root)
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(parent, exc))
        return False

    info("materializing Treesitter released source {0}".format(source_id))
    with tempfile.TemporaryDirectory(
        prefix=".{0}.{1}.".format(source_id, os.getpid()), dir=parent
    ) as staging_root:
        staged_root = os.path.join(staging_root, "install")
        staged_source_root = os.path.join(staged_root, "source")
        extracted_root = os.path.join(staging_root, "extract")
        try:
            os.makedirs(staged_source_root, exist_ok=True)
            os.makedirs(extracted_root, exist_ok=True)
        except OSError as exc:
            warn(
                "unable to create staging directories for {0}: {1}".format(
                    source_id, exc
                )
            )
            return False

        staged_archive = os.path.join(staged_root, "archive.tar.gz")
        staged_metadata_path = os.path.join(staged_root, "metadata.json")
        if not download_url(url, staged_archive):
            return False
        if not verify_file_sha256(staged_archive, sha256):
            return False
        if not extract_tar_gz(staged_archive, extracted_root):
            return False
        if not copy_treesitter_released_source_paths(
            extracted_root, staged_source_root, files
        ):
            return False
        try:
            with open(staged_metadata_path, "w", encoding="utf-8") as file:
                json.dump(
                    {"url": url, "sha256": sha256, "files": files},
                    file,
                    indent=2,
                )
                file.write("\n")
        except OSError as exc:
            warn(
                "unable to write Treesitter released source metadata for {0}: {1}".format(
                    source_id, exc
                )
            )
            return False
        if not replace_directory(root, staged_root):
            return False
    return True


def materialize_treesitter_released_sources(repository: str, lock: JSONMapping) -> bool:
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        warn("lockfile sources must be an object")
        return False
    ok = True
    for source_id, source_value in sources.items():
        if not valid_source_id(source_id):
            warn("invalid source id: {0}".format(source_id))
            ok = False
            continue
        if not isinstance(source_value, dict):
            warn("source {0} must be an object".format(source_id))
            ok = False
            continue
        if not validate_source_settings(source_id, source_value):
            ok = False
            continue
        if not materialize_treesitter_released_source(
            repository, lock, source_id, cast(JSONMapping, source_value)
        ):
            ok = False
    return ok


