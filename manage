def treesitter_released_source_files(released_source: JSONMapping) -> Sequence[str]:
    value = released_source.get("files", [])
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return [normalize_relative_subpath(str(item)) for item in value]
    return []


def validate_treesitter_released_source(
    source_id: str, released_source: JSONMapping
) -> bool:
    url = released_source.get("url")
    if not isinstance(url, str) or not url:
        warn(
            "source {0} treesitter.releasedSource.url must be a non-empty string".format(
                source_id
            )
        )
        return False

    sha256 = released_source.get("sha256")
    if not isinstance(sha256, str) or SHA256_PATTERN.match(sha256) is None:
        warn(
            "source {0} treesitter.releasedSource.sha256 must be a lowercase SHA-256 digest".format(
                source_id
            )
        )
        return False

    files = released_source.get("files")
    if (
        not isinstance(files, list)
        or not files
        or not all(isinstance(item, str) for item in files)
    ):
        warn(
            "source {0} treesitter.releasedSource.files must be a non-empty list of paths".format(
                source_id
            )
        )
        return False

    normalized_files: list[str] = []
    for item in files:
        normalized = validated_relative_subpath(str(item))
        if normalized is None:
            warn(
                "source {0} treesitter.releasedSource.files entries must be non-empty relative paths".format(
                    source_id
                )
            )
            return False
        for existing in normalized_files:
            if normalized == existing:
                warn(
                    "source {0} treesitter.releasedSource.files entries must not repeat paths".format(
                        source_id
                    )
                )
                return False
            if normalized.startswith(existing + "/") or existing.startswith(
                normalized + "/"
            ):
                warn(
                    "source {0} treesitter.releasedSource.files entries must not overlap".format(
                        source_id
                    )
                )
                return False
        normalized_files.append(normalized)

    return True


