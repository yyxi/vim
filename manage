            shutil.rmtree(destination_dir)
        shutil.copytree(source_dir, destination_dir)
    except OSError as exc:
        warn(
            "unable to copy query directory {0} to {1}: {2}".format(
                source_dir, destination_dir, exc
            )
        )
        return False
    return True


# tree-sitter-sql v0.3.11 ships SQL highlights predicates in a form Neovim
# does not load as-is, so normalize only the installed SQL query copy.
def normalize_installed_query_dir(
    source_id: str, language: str, destination_dir: str
) -> bool:
    if source_id != "tree-sitter-sql" or language != "sql":
        return True

    highlights = os.path.join(destination_dir, "highlights.scm")
    try:
        with open(highlights, encoding="utf-8") as file:
            content = file.read()
    except OSError as exc:
        warn("unable to read {0}: {1}".format(highlights, exc))
        return False

    content = content.replace(
        '(#match? @number "^[-+]?%d+$")',
        '(#lua-match? @number "^[-+]?%d+$")',
    )
    content = content.replace(
        '(#match? @float "^[-+]?%d*\\.%d*$")',
        '(#lua-match? @float "^[-+]?%d*%.%d*$")',
    )

    try:
        with open(highlights, "w", encoding="utf-8") as file:
            file.write(content)
    except OSError as exc:
        warn("unable to write {0}: {1}".format(highlights, exc))
        return False

    return True


def query_source_path(
    repository: str,
    lock: JSONMapping,
    language: str,
    parser_data: JSONMapping,
) -> Optional[tuple[str, str]]:
    metadata = root_treesitter_metadata(lock)
    defaults = metadata.get("defaults", {})
    if not isinstance(defaults, dict):
        defaults = {}
    source_id = parser_data.get(
        "querySource", defaults.get("querySource", "nvim-treesitter")
    )
    if not isinstance(source_id, str):
        warn("querySource for {0} must be a string".format(language))
        return None
    query_path = parser_data.get("queryPath")
    if not isinstance(query_path, str):
        template = defaults.get("queryPathTemplate", "runtime/queries/{language}")
        if not isinstance(template, str):
            warn("treesitter.defaults.queryPathTemplate must be a string")
            return None
        query_path = template.replace("{language}", language)
    normalized_query_path = validated_relative_subpath(query_path)
    if normalized_query_path is None:
        warn("queryPath for {0} must be a non-empty relative path".format(language))
        return None
    source_root = treesitter_source_root_by_id(repository, lock, source_id)
    if source_root is None:
        return None
    path = source_subpath(source_root, normalized_query_path)
    return (source_id, path) if path is not None else None


