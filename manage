def current_platform_signature() -> JSONObject:
    signature: JSONObject = {
        "osName": os.name,
        "sysPlatform": sys.platform,
    }
    machine = platform.machine()
    if machine:
        signature["machine"] = machine
    return signature


def treesitter_runtime_signature(
    configuration_sha256: str, tree_sitter_version: Optional[str]
) -> JSONObject:
    signature = dict(current_platform_signature())
    signature["parserExtension"] = parser_extension()
    signature["generatorVersion"] = TREE_SITTER_RUNTIME_GENERATOR_VERSION
    signature["configurationSha256"] = configuration_sha256
    if tree_sitter_version:
        signature["treeSitterCliVersion"] = tree_sitter_version
    return signature


