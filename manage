def copy_source_for_build(
    repository: str,
    lock: JSONMapping,
    scratch_root: str,
    source_id: str,
    copied_sources: set[str],
) -> Optional[str]:
    destination = os.path.join(scratch_root, "sources", source_id)
    if source_id in copied_sources:
        return destination
    source_root = treesitter_source_root_by_id(repository, lock, source_id)
    if source_root is None:
        return None
    try:
        if os.path.exists(destination):
            shutil.rmtree(destination)
        shutil.copytree(source_root, destination, ignore=shutil.ignore_patterns(".git"))
    except OSError as exc:
        warn("unable to stage Treesitter build source {0}: {1}".format(source_id, exc))
        return None
    copied_sources.add(source_id)
    return destination


@dataclasses.dataclass
class TreesitterPlan:
    """Resolved output ownership shared by the builder and both state checks."""

    parsers: Dict[str, JSONObject]
    queries: dict[str, tuple[str, str]]
    supplemental: dict[str, tuple[str, str]]
    files: set[str]
    configuration_sha256: str


def file_inventory(root: str, emit_warnings: bool) -> Optional[set[str]]:
    files: set[str] = set()
    pending = [root]
    try:
        while pending:
            with os.scandir(pending.pop()) as entries:
                for entry in entries:
                    if entry.is_symlink():
                        raise OSError("unexpected symlink: " + entry.path)
                    if entry.is_dir(follow_symlinks=False):
                        pending.append(entry.path)
                    elif entry.is_file(follow_symlinks=False):
                        files.add(
                            os.path.relpath(entry.path, root).replace(os.sep, "/")
                        )
                    else:
                        raise OSError("unsupported file type: " + entry.path)
    except OSError as exc:
        if emit_warnings:
            warn("unable to inventory {0}: {1}".format(root, exc))
        return None
    return files


def treesitter_plan(
    repository: str, lock: JSONMapping, emit_warnings: bool
) -> Optional[TreesitterPlan]:
    parsers = treesitter_languages(lock)
    queries: dict[str, tuple[str, str]] = {}
    supplemental: dict[str, tuple[str, str]] = {}
    files = {"state/runtime-signature.json"}
    required: set[str] = set()
    source_ids: set[str] = set()
    for language, data in parsers.items():
        source_ids.add(str(data["source"]))
        files.add("parser/" + str(data.get("parser", language)) + parser_extension())
        dependency_data = {
            key: data[key] for key in ("querySource", "queryPath") if key in data
        }
        query_tasks = [(language, data)] + [
            (name, dependency_data)
            for name in sequence_strings(data.get("queryDependencies"))
        ]
        for query_language, query_data in query_tasks:
            resolved = query_source_path(repository, lock, query_language, query_data)
            if resolved is None:
                return None
            if query_language in queries and queries[query_language] != resolved:
                if emit_warnings:
                    warn("conflicting query directory ownership for " + query_language)
                return None
            queries[query_language] = resolved
            source_ids.add(resolved[0])
            required.update(
                "queries/" + query_language + "/" + name + ".scm"
                for name in required_queries(lock, query_data)
            )
    for language, (_, directory) in queries.items():
        inventory = file_inventory(directory, emit_warnings)
        if inventory is None:
            return None
        files.update("queries/" + language + "/" + path for path in inventory)
    for group in supplemental_query_groups(lock):
        for language in supplemental_query_languages(group):
            resolved = supplemental_query_source_path(repository, lock, group, language)
            if resolved is None:
                return None
            source_id, name, source_file = resolved
            if not os.path.isfile(source_file) or os.path.islink(source_file):
                if emit_warnings:
                    warn("supplemental query missing or symlinked: " + source_file)
                return None
            path = "queries/" + language + "/" + name + ".scm"
            supplemental[path] = (source_id, source_file)
            files.add(path)
            source_ids.add(source_id)
    if not required.issubset(files):
        if emit_warnings:
            warn(
                "required Treesitter queries missing: "
                + ", ".join(sorted(required - files))
            )
        return None
    sources = manifest_sources(lock)
    inputs = {
        "parsers": parsers,
        "defaults": root_treesitter_metadata(lock).get("defaults", {}),
        "sources": {
            source_id: {
                "commit": sources[source_id]["commit"],
                "files": sources[source_id].get("files"),
                "releasedSource": source_treesitter_released_source(sources[source_id]),
            }
            for source_id in sorted(source_ids)
        },
        "outputs": sorted(files),
    }
    digest = hashlib.sha256(
        json.dumps(inputs, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    return TreesitterPlan(parsers, queries, supplemental, files, digest)


def treesitter_matches_plan(
    runtime_site: str,
    plan: TreesitterPlan,
    env: Optional[Mapping[str, str]],
    repository: str,
    emit_warnings: bool,
) -> bool:
    signature = read_json_object_file(
        treesitter_runtime_signature_path(runtime_site), emit_warnings
    )
    if signature is None:
        return False
    version = None
    if env is not None:
        cli = shutil.which("tree-sitter", path=env.get("PATH"))
        if cli:
            version = tree_sitter_cli_version_text(cli, env, repository)
            if version is None:
                if emit_warnings:
                    warn("unable to query installed tree-sitter version")
                return False
    expected = treesitter_runtime_signature(plan.configuration_sha256, version)
    for key, value in expected.items():
        if signature.get(key) != value:
            if emit_warnings:
                warn(
                    "Treesitter runtime signature mismatch ({0}); run ./manage install".format(
                        key
                    )
                )
            return False
    actual: set[str] = set()
    for child in ("parser", "queries", "state"):
        inventory = file_inventory(os.path.join(runtime_site, child), emit_warnings)
        if inventory is None:
            return False
        actual.update(child + "/" + path for path in inventory)
    if actual != plan.files:
        if emit_warnings:
            warn(
                "Treesitter output mismatch; missing: {0}; obsolete: {1}; run ./manage install".format(
                    sorted(plan.files - actual), sorted(actual - plan.files)
                )
            )
        return False
    try:
        for path in plan.files:
            if (
                path.startswith("parser/")
                and os.path.getsize(os.path.join(runtime_site, path)) == 0
            ):
                if emit_warnings:
                    warn("empty Treesitter parser: " + path)
                return False
    except OSError as exc:
        if emit_warnings:
            warn("unable to inspect Treesitter parser: {0}".format(exc))
        return False
    return True


def install_treesitter_runtime(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    plan = treesitter_plan(repository, lock, emit_warnings=True)
    runtime_site = tree_sitter_runtime_site(repository, lock)
    if plan is None or runtime_site is None:
        return False
    if treesitter_matches_plan(
        runtime_site, plan, env, repository, emit_warnings=False
    ):
        return True
    if not check_tree_sitter_cli(env, repository, treesitter_minimum_cli_version(lock)):
        return False
    tree_sitter = resolve_required("tree-sitter", env)
    if tree_sitter is None:
        return False
    version = tree_sitter_cli_version_text(tree_sitter, env, repository)
    if version is None:
        warn("unable to query tree-sitter build version")
        return False
    defaults = root_treesitter_metadata(lock).get("defaults", {})
    default_generate = (
        defaults.get("generate", False) if isinstance(defaults, dict) else False
    )
    try:
        os.makedirs(os.path.dirname(runtime_site), exist_ok=True)
        with tempfile.TemporaryDirectory(
            prefix="treesitter-runtime-", dir=os.path.dirname(runtime_site)
        ) as staging_root:
            staged = os.path.join(staging_root, "site")
            for child in ("parser", "queries", "state"):
                os.makedirs(os.path.join(staged, child))
            with tempfile.TemporaryDirectory(prefix="treesitter-build-") as scratch:
                copied: set[str] = set()
                for language, data in sorted(plan.parsers.items()):
                    build_source = copy_source_for_build(
                        repository, lock, scratch, str(data["source"]), copied
                    )
                    if build_source is None:
                        return False
                    build_dir = source_subpath(
                        build_source, str(data.get("location", ".")), allow_current=True
                    )
                    if build_dir is None or not os.path.isdir(build_dir):
                        warn("parser source missing for " + language)
                        return False
                    if data.get(
                        "generate", default_generate
                    ) and not run_logged_command(
                        [tree_sitter, "generate"],
                        env,
                        build_dir,
                        show_success_output_on_stderr=False,
                    ):
                        return False
                    output = os.path.join(
                        staged,
                        "parser",
                        str(data.get("parser", language)) + parser_extension(),
                    )
                    if not run_logged_command(
                        [tree_sitter, "build", "-o", output],
                        env,
                        build_dir,
                        show_success_output_on_stderr=False,
                    ):
                        return False
            for language, (source_id, directory) in plan.queries.items():
                destination = os.path.join(staged, "queries", language)
                if not copy_query_dir(
                    directory, destination
                ) or not normalize_installed_query_dir(
                    source_id, language, destination
                ):
                    return False
            for path, (_, source_file) in plan.supplemental.items():
                destination = os.path.join(staged, path)
                os.makedirs(os.path.dirname(destination), exist_ok=True)
                shutil.copy2(source_file, destination)
            if not write_treesitter_runtime_signature(
                staged, treesitter_runtime_signature(plan.configuration_sha256, version)
            ):
                return False
            if not treesitter_matches_plan(
                staged, plan, env, repository, emit_warnings=True
            ):
                return False
            return publish_runtime_subdirectories(
                runtime_site, staged, ("parser", "queries", "state")
            )
    except OSError as exc:
        warn("unable to build Treesitter runtime: {0}".format(exc))
        return False


def treesitter_runtime_state_ok(
    repository: str,
    lock: JSONMapping,
    emit_warnings: bool,
    env: Optional[Mapping[str, str]] = None,
) -> bool:
    plan = treesitter_plan(repository, lock, emit_warnings)
    runtime_site = tree_sitter_runtime_site(repository, lock)
    return (
        plan is not None
        and runtime_site is not None
        and treesitter_matches_plan(runtime_site, plan, env, repository, emit_warnings)
    )


def check_treesitter_runtime(
    env: Mapping[str, str], repository: str, lock: JSONMapping
