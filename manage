def write_treesitter_runtime_signature(
    runtime_site: str, signature: JSONMapping
) -> bool:
    path = treesitter_runtime_signature_path(runtime_site)
    signature = dict(signature)
    files = []
    for child in ("parser", "queries"):
        inventory = file_inventory(os.path.join(runtime_site, child), True)
        if inventory is None:
            return False
        files.extend(child + "/" + name for name in inventory)
    hashes = output_hashes(runtime_site, files)
    if hashes is None:
        return False
    signature["outputHashes"] = hashes
    try:
        with open(path, "w", encoding="utf-8") as file:
            json.dump(signature, file, indent=2)
            file.write("\n")
    except OSError as exc:
        warn("unable to write Treesitter runtime signature {0}: {1}".format(path, exc))
        return False
    return True


def publish_runtime_subdirectories(
    runtime_site: str, staged_runtime_site: str, children: Sequence[str]
) -> bool:
    try:
        os.makedirs(runtime_site, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(runtime_site, exc))
        return False

    pairs: list[tuple[str, str]] = []
    for child in children:
        target = source_subpath(runtime_site, child)
        staged = source_subpath(staged_runtime_site, child)
        if target is None or staged is None:
            return False
        pairs.append((target, staged))
    return publish_directories(pairs)


def sha256_stream(stream: io.BufferedIOBase) -> str:
    return hashlib.file_digest(stream, "sha256").hexdigest()


def sha256_file(path: str, emit_warnings: bool = True) -> Optional[str]:
    try:
        with open(path, "rb") as stream:
            return sha256_stream(stream)
    except OSError as exc:
        if emit_warnings:
            warn("unable to read {0}: {1}".format(path, exc))
        return None


def verify_file_sha256(path: str, expected: str, emit_warnings: bool = True) -> bool:
    actual = sha256_file(path, emit_warnings=emit_warnings)
    if actual is None:
        return False
    if actual != expected:
        if emit_warnings:
            warn(
                "SHA-256 mismatch for {0}: expected {1}, got {2}".format(
                    path, expected, actual
                )
            )
        return False
    return True


def normalize_archive_member_path(path: str) -> Optional[str]:
    return validated_relative_subpath(path)


def extract_tar_gz(archive: str, destination: str) -> bool:
    try:
        with tarfile.open(archive, "r:gz") as tar:
            for member in tar.getmembers():
                normalized = normalize_archive_member_path(member.name)
                if normalized is None:
                    if (
                        member.isdir()
                        and validated_relative_subpath_or_current(member.name) == "."
                    ):
                        continue
                    warn("invalid archive member path: " + member.name)
                    return False
                if member.islnk() or member.issym():
                    warn(
                        "unsupported symlink in Treesitter released source archive: {0}".format(
                            member.name
                        )
                    )
                    return False
                target = os.path.join(destination, normalized)
                if not path_within_repository(destination, target):
                    warn(
                        "Treesitter released source archive path escapes extraction root: {0}".format(
                            member.name
                        )
                    )
                    return False
                if member.isdir():
                    os.makedirs(target, exist_ok=True)
                    continue
                if not member.isfile():
                    continue
                os.makedirs(os.path.dirname(target), exist_ok=True)
                extracted = tar.extractfile(member)
                if extracted is None:
                    warn(
                        "unable to extract Treesitter released source archive member: {0}".format(
                            member.name
                        )
                    )
                    return False
                with extracted:
                    with open(target, "wb") as output:
                        shutil.copyfileobj(extracted, output)
    except (OSError, tarfile.TarError) as exc:
        warn(
            "unable to extract Treesitter released source archive {0}: {1}".format(
                archive, exc
            )
        )
        return False
    return True


def copy_treesitter_released_source_paths(
    source_root: str, destination_root: str, paths: Sequence[str]
) -> bool:
    try:
        for relative_path in paths:
            source = os.path.join(source_root, relative_path)
            destination = os.path.join(destination_root, relative_path)
            if not os.path.exists(source):
                warn(
                    "Treesitter released source retained path missing: {0}".format(
                        source
                    )
                )
                return False
            if os.path.isdir(source):
                shutil.copytree(source, destination)
            else:
                os.makedirs(os.path.dirname(destination), exist_ok=True)
                shutil.copy2(source, destination)
    except OSError as exc:
        warn("unable to copy Treesitter released source paths: {0}".format(exc))
        return False
    return True


def reject_json_constant(value: str) -> None:
    raise ValueError("non-finite JSON number: " + value)


def read_json_object_file(path: str, emit_warnings: bool) -> Optional[JSONObject]:
    try:
        with open(path, encoding="utf-8") as file:
            value = json.load(file, parse_constant=reject_json_constant)
    except OSError as exc:
        if emit_warnings:
            warn("unable to read {0}: {1}".format(path, exc))
        return None
    except ValueError as exc:
        if emit_warnings:
            warn("unable to parse {0}: {1}".format(path, exc))
        return None
    if not isinstance(value, dict):
        if emit_warnings:
            warn("{0} must contain a JSON object".format(path))
        return None
    return value


def treesitter_released_source_state_ok(
    repository: str,
    lock: JSONMapping,
    source_id: str,
    source: JSONMapping,
    emit_warnings: bool,
) -> bool:
    released_source = source_treesitter_released_source(source)
    if not released_source:
        return True

    archive = treesitter_released_source_archive_path(repository, lock, source_id)
    metadata_path = treesitter_released_source_metadata_path(
        repository, lock, source_id
    )
    source_root = treesitter_released_source_source_path(repository, lock, source_id)
    if archive is None or metadata_path is None or source_root is None:
        return False

    if not os.path.isfile(archive):
        if emit_warnings:
            warn(
                "Treesitter released source archive missing: {0}; run ./manage install".format(
                    archive
                )
            )
        return False

    expected_sha256 = released_source.get("sha256")
    if not isinstance(expected_sha256, str) or not verify_file_sha256(
        archive, expected_sha256, emit_warnings=emit_warnings
    ):
        return False

    metadata = read_json_object_file(metadata_path, emit_warnings=emit_warnings)
    if metadata is None:
        return False
    expected_url = released_source.get("url")
    expected_files = list(treesitter_released_source_files(released_source))
    if (
        metadata.get("url") != expected_url
        or metadata.get("sha256") != expected_sha256
        or metadata.get("files") != expected_files
    ):
        if emit_warnings:
            warn(
                "Treesitter released source metadata mismatch for {0}; run ./manage install".format(
                    source_id
                )
            )
        return False

    for relative_path in expected_files:
        path = source_subpath(source_root, relative_path)
        if path is None:
            return False
        if not os.path.exists(path):
            if emit_warnings:
                warn(
                    "Treesitter released source path missing: {0}; run ./manage install".format(
                        path
                    )
                )
            return False
    return released_source_contents_ok(
        archive, source_root, expected_files, emit_warnings
    )


def released_source_contents_ok(
    archive: str, source_root: str, retained_paths: Sequence[str], emit_warnings: bool
) -> bool:
    """Check the mutable extracted cache against the already verified archive."""
    expected: set[str] = set()
    try:
        with tarfile.open(archive, "r:gz") as tar:
            for member in tar.getmembers():
                relative = normalize_archive_member_path(member.name)
                if (
                    relative is None
                    or not member.isfile()
                    or not path_allowed_by(relative, retained_paths)
                ):
                    continue
                if relative in expected:
                    raise OSError("duplicate retained archive member: " + relative)
                expected.add(relative)
                target = source_subpath(source_root, relative)
                extracted = tar.extractfile(member)
                if target is None or extracted is None:
                    return False
                with extracted:
                    # extractfile's IO[bytes] annotation omits readinto;
                    # its actual ExFileObject is a BufferedReader.
                    expected_sha = sha256_stream(cast(tarfile.ExFileObject, extracted))
                if not verify_file_sha256(target, expected_sha, emit_warnings):
                    return False
    except (OSError, tarfile.TarError) as exc:
        if emit_warnings:
            warn("unable to verify released source contents: {0}".format(exc))
        return False
    actual = file_inventory(source_root, emit_warnings)
    if actual != expected:
        if emit_warnings:
            warn(
                "released source files differ from the verified archive; run ./manage install"
            )
        return False
    return True


def materialize_treesitter_released_source(
    repository: str,
    lock: JSONMapping,
    source_id: str,
    source: JSONMapping,
) -> bool:
    released_source = source_treesitter_released_source(source)
    if not released_source:
        return True
    if treesitter_released_source_state_ok(
        repository, lock, source_id, source, emit_warnings=False
    ):
        return True

    root = treesitter_released_source_root_path(repository, lock, source_id)
    if root is None:
        return False

    url = released_source.get("url")
    sha256 = released_source.get("sha256")
    files = list(treesitter_released_source_files(released_source))
    if not isinstance(url, str) or not isinstance(sha256, str) or not files:
        warn(
            "invalid Treesitter released source metadata for source {0}".format(
                source_id
            )
        )
        return False

    parent = os.path.dirname(root)
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(parent, exc))
        return False

    info("materializing Treesitter released source {0}".format(source_id))
    with tempfile.TemporaryDirectory(
        prefix=".{0}.{1}.".format(source_id, os.getpid()), dir=parent
    ) as staging_root:
        staged_root = os.path.join(staging_root, "install")
        staged_source_root = os.path.join(staged_root, "source")
        extracted_root = os.path.join(staging_root, "extract")
        try:
            os.makedirs(staged_source_root, exist_ok=True)
            os.makedirs(extracted_root, exist_ok=True)
        except OSError as exc:
            warn(
                "unable to create staging directories for {0}: {1}".format(
                    source_id, exc
                )
            )
            return False

        staged_archive = os.path.join(staged_root, "archive.tar.gz")
        staged_metadata_path = os.path.join(staged_root, "metadata.json")
        if not download_url(url, staged_archive):
            return False
        if not verify_file_sha256(staged_archive, sha256):
            return False
        if not extract_tar_gz(staged_archive, extracted_root):
            return False
        if not copy_treesitter_released_source_paths(
            extracted_root, staged_source_root, files
        ):
            return False
        if not released_source_contents_ok(
            staged_archive, staged_source_root, files, emit_warnings=True
        ):
            return False
        try:
            with open(staged_metadata_path, "w", encoding="utf-8") as file:
                json.dump(
                    {"url": url, "sha256": sha256, "files": files},
                    file,
                    indent=2,
                )
                file.write("\n")
        except OSError as exc:
            warn(
                "unable to write Treesitter released source metadata for {0}: {1}".format(
                    source_id, exc
                )
            )
            return False
        if not replace_directory(root, staged_root):
            return False
    return True


def materialize_treesitter_released_sources(repository: str, lock: JSONMapping) -> bool:
    ok = True
    for source_id, source_value in manifest_sources(lock).items():
        if not materialize_treesitter_released_source(
            repository, lock, source_id, cast(JSONMapping, source_value)
        ):
            ok = False
    return ok


def treesitter_released_sources_state_ok(
    repository: str, lock: JSONMapping, emit_warnings: bool
) -> bool:
    ok = True
    for source_id, source_value in manifest_sources(lock).items():
        if not treesitter_released_source_state_ok(
            repository,
            lock,
            source_id,
            cast(JSONMapping, source_value),
            emit_warnings=emit_warnings,
        ):
            ok = False
    return ok


def check_treesitter_released_sources(repository: str, lock: JSONMapping) -> bool:
    return treesitter_released_sources_state_ok(repository, lock, emit_warnings=True)


def copy_source_for_build(
    repository: str,
    lock: JSONMapping,
    scratch_root: str,
    source_id: str,
    copied_sources: set[str],
) -> Optional[str]:
    destination = os.path.join(scratch_root, "sources", source_id)
    if source_id in copied_sources:
        return destination
    source_root = treesitter_source_root_by_id(repository, lock, source_id)
    if source_root is None:
        return None
    try:
        if os.path.exists(destination):
            shutil.rmtree(destination)
        shutil.copytree(source_root, destination, ignore=shutil.ignore_patterns(".git"))
    except OSError as exc:
        warn("unable to stage Treesitter build source {0}: {1}".format(source_id, exc))
        return None
    copied_sources.add(source_id)
    return destination


@dataclasses.dataclass
class TreesitterPlan:
    """Resolved output ownership shared by the builder and both state checks."""

    parsers: Dict[str, JSONObject]
    queries: dict[str, tuple[str, str]]
    supplemental: dict[str, tuple[str, str]]
    files: set[str]
    configuration_sha256: str


def file_inventory(root: str, emit_warnings: bool) -> Optional[set[str]]:
    files: set[str] = set()
    pending = [root]
    try:
        while pending:
            with os.scandir(pending.pop()) as entries:
                for entry in entries:
                    if entry.is_symlink():
                        raise OSError("unexpected symlink: " + entry.path)
                    if entry.is_dir(follow_symlinks=False):
                        pending.append(entry.path)
                    elif entry.is_file(follow_symlinks=False):
                        files.add(
                            os.path.relpath(entry.path, root).replace(os.sep, "/")
                        )
                    else:
                        raise OSError("unsupported file type: " + entry.path)
    except OSError as exc:
        if emit_warnings:
            warn("unable to inventory {0}: {1}".format(root, exc))
        return None
    return files


def treesitter_plan(
    repository: str, lock: JSONMapping, emit_warnings: bool
) -> Optional[TreesitterPlan]:
    parsers = treesitter_languages(lock)
    queries: dict[str, tuple[str, str]] = {}
    supplemental: dict[str, tuple[str, str]] = {}
    files = {"state/runtime-signature.json"}
    required: set[str] = set()
    source_ids: set[str] = set()
    for language, data in parsers.items():
        source_ids.add(str(data["source"]))
        files.add("parser/" + str(data.get("parser", language)) + parser_extension())
        dependency_data = {
            key: data[key] for key in ("querySource", "queryPath") if key in data
        }
        query_tasks = [(language, data)] + [
            (name, dependency_data)
            for name in sequence_strings(data.get("queryDependencies"))
        ]
        for query_language, query_data in query_tasks:
            resolved = query_source_path(repository, lock, query_language, query_data)
            if resolved is None:
                return None
            if query_language in queries and queries[query_language] != resolved:
                if emit_warnings:
                    warn("conflicting query directory ownership for " + query_language)
                return None
            queries[query_language] = resolved
            source_ids.add(resolved[0])
            required.update(
                "queries/" + query_language + "/" + name + ".scm"
                for name in required_queries(lock, query_data)
            )
    for language, (_, directory) in queries.items():
        inventory = file_inventory(directory, emit_warnings)
        if inventory is None:
            return None
        files.update("queries/" + language + "/" + path for path in inventory)
    for group in supplemental_query_groups(lock):
        for language in supplemental_query_languages(group):
            resolved = supplemental_query_source_path(repository, lock, group, language)
            if resolved is None:
                return None
            source_id, name, source_file = resolved
            if not os.path.isfile(source_file) or os.path.islink(source_file):
                if emit_warnings:
                    warn("supplemental query missing or symlinked: " + source_file)
                return None
            path = "queries/" + language + "/" + name + ".scm"
            supplemental[path] = (source_id, source_file)
            files.add(path)
            source_ids.add(source_id)
    if not required.issubset(files):
        if emit_warnings:
            warn(
                "required Treesitter queries missing: "
                + ", ".join(sorted(required - files))
            )
        return None
    sources = manifest_sources(lock)
    inputs = {
        "parsers": parsers,
        "defaults": root_treesitter_metadata(lock).get("defaults", {}),
        "sources": {
            source_id: {
                "commit": sources[source_id]["commit"],
                "files": sources[source_id].get("files"),
                "releasedSource": source_treesitter_released_source(sources[source_id]),
            }
            for source_id in sorted(source_ids)
        },
        "outputs": sorted(files),
    }
    digest = hashlib.sha256(
        json.dumps(inputs, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    return TreesitterPlan(parsers, queries, supplemental, files, digest)


def treesitter_matches_plan(
    runtime_site: str,
    plan: TreesitterPlan,
    env: Optional[Mapping[str, str]],
    repository: str,
    emit_warnings: bool,
) -> bool:
    signature = read_json_object_file(
        treesitter_runtime_signature_path(runtime_site), emit_warnings
    )
    if signature is None:
        return False
    # Tool availability/version controls rebuilding, never valid runtime reuse.
    if not platform_state_ok(signature):
        if emit_warnings:
            warn("Treesitter runtime platform/deployment requirements mismatch")
        return False
    expected = treesitter_runtime_signature(plan.configuration_sha256, None)
    expected.pop("requirements")
    for key, value in expected.items():
        if signature.get(key) != value:
            if emit_warnings:
                warn(
                    "Treesitter runtime signature mismatch ({0}); run ./manage install".format(
                        key
                    )
                )
            return False
    actual: set[str] = set()
    for child in ("parser", "queries", "state"):
        inventory = file_inventory(os.path.join(runtime_site, child), emit_warnings)
        if inventory is None:
            return False
        actual.update(child + "/" + path for path in inventory)
    if actual != plan.files:
        if emit_warnings:
            warn(
                "Treesitter output mismatch; missing: {0}; obsolete: {1}; run ./manage install".format(
                    sorted(plan.files - actual), sorted(actual - plan.files)
                )
            )
        return False
    parser_abis = signature.get("parserAbi")
    parser_paths = {path for path in plan.files if path.startswith("parser/")}
    if not isinstance(parser_abis, dict) or set(parser_abis) != parser_paths:
        if emit_warnings:
            warn("missing/inconsistent parser ABI metadata")
        return False
    if parser_paths:
        runtime_env = env if env is not None else install_environment(home_dir())
        nvim = resolve_required("nvim", runtime_env)
        value = (
            neovim_value(
                nvim,
                "vim.json.encode({minimum=vim.treesitter.minimum_language_version,maximum=vim.treesitter.language_version})",
                runtime_env,
                repository,
            )
            if nvim is not None
            else None
        )
        try:
            supported = json.loads(value) if value is not None else {}
            minimum, maximum = supported["minimum"], supported["maximum"]
            if (
                type(minimum) is not int
                or type(maximum) is not int
                or any(
                    type(abi) is not int or not minimum <= abi <= maximum
                    for abi in parser_abis.values()
                )
            ):
                raise ValueError("unsupported parser ABI")
        except (ValueError, KeyError, TypeError) as exc:
            if emit_warnings:
                warn("Neovim/parser ABI mismatch: " + str(exc))
            return False
    outputs = sorted(path for path in plan.files if not path.startswith("state/"))
    hashes = output_hashes(runtime_site, outputs)
    if hashes is None or signature.get("outputHashes") != hashes:
        if emit_warnings:
            warn("Treesitter output integrity mismatch; run ./manage install")
        return False
    try:
        for path in plan.files:
            if (
                path.startswith("parser/")
                and os.path.getsize(os.path.join(runtime_site, path)) == 0
            ):
                if emit_warnings:
                    warn("empty Treesitter parser: " + path)
                return False
    except OSError as exc:
        if emit_warnings:
            warn("unable to inspect Treesitter parser: {0}".format(exc))
        return False
    return True


def install_treesitter_runtime(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    plan = treesitter_plan(repository, lock, emit_warnings=True)
    runtime_site = tree_sitter_runtime_site(repository, lock)
    if plan is None or runtime_site is None:
        return False
    if treesitter_matches_plan(
        runtime_site, plan, env, repository, emit_warnings=False
    ):
        return True
    if not check_tree_sitter_cli(env, repository, treesitter_minimum_cli_version(lock)):
        return False
    tree_sitter = resolve_required("tree-sitter", env)
    if tree_sitter is None:
        return False
    version = tree_sitter_cli_version_text(tree_sitter, env, repository)
    if version is None:
        warn("unable to query tree-sitter build version")
        return False
    defaults = root_treesitter_metadata(lock).get("defaults", {})
    default_generate = (
        defaults.get("generate", False) if isinstance(defaults, dict) else False
    )
    try:
        os.makedirs(os.path.dirname(runtime_site), exist_ok=True)
        with tempfile.TemporaryDirectory(
            prefix="treesitter-runtime-", dir=os.path.dirname(runtime_site)
        ) as staging_root:
            staged = os.path.join(staging_root, "site")
            for child in ("parser", "queries", "state"):
                os.makedirs(os.path.join(staged, child))
            parser_abis: JSONObject = {}
            with tempfile.TemporaryDirectory(prefix="treesitter-build-") as scratch:
                copied: set[str] = set()
                for language, data in sorted(plan.parsers.items()):
                    build_source = copy_source_for_build(
                        repository, lock, scratch, str(data["source"]), copied
                    )
                    if build_source is None:
                        return False
                    build_dir = source_subpath(
                        build_source, str(data.get("location", ".")), allow_current=True
                    )
                    if build_dir is None or not os.path.isdir(build_dir):
                        warn("parser source missing for " + language)
                        return False
                    if data.get(
                        "generate", default_generate
                    ) and not run_logged_command(
                        [tree_sitter, "generate"],
                        env,
                        build_dir,
                        show_success_output_on_stderr=False,
                    ):
                        return False
                    output = os.path.join(
                        staged,
                        "parser",
                        str(data.get("parser", language)) + parser_extension(),
                    )
                    abi = None
                    with open(
                        os.path.join(build_dir, "src", "parser.c"), encoding="utf-8"
                    ) as source_file:
                        for line in source_file:
                            match = re.match(
                                r"#define\s+LANGUAGE_VERSION\s+(\d+)\b", line
                            )
                            if match:
                                abi = int(match[1])
                                break
                    if abi is None:
                        warn(
                            "parser source does not declare LANGUAGE_VERSION: "
                            + language
                        )
                        return False
                    parser_abis[
                        os.path.relpath(output, staged).replace(os.sep, "/")
                    ] = abi
                    if not run_logged_command(
                        [tree_sitter, "build", "-o", output],
                        env,
                        build_dir,
                        show_success_output_on_stderr=False,
                    ):
                        return False
            for language, (source_id, directory) in plan.queries.items():
                destination = os.path.join(staged, "queries", language)
                if not copy_query_dir(
                    directory, destination
                ) or not normalize_installed_query_dir(
                    source_id, language, destination
                ):
                    return False
            for path, (_, source_file) in plan.supplemental.items():
                destination = os.path.join(staged, path)
                os.makedirs(os.path.dirname(destination), exist_ok=True)
                shutil.copy2(source_file, destination)
            signature = treesitter_runtime_signature(plan.configuration_sha256, version)
            signature["parserAbi"] = parser_abis
            if not write_treesitter_runtime_signature(staged, signature):
                return False
            if not treesitter_matches_plan(
                staged, plan, env, repository, emit_warnings=True
            ):
                return False
            return publish_runtime_subdirectories(
                runtime_site, staged, ("parser", "queries", "state")
            )
    except OSError as exc:
        warn("unable to build Treesitter runtime: {0}".format(exc))
        return False


def treesitter_runtime_state_ok(
    repository: str,
    lock: JSONMapping,
    emit_warnings: bool,
    env: Optional[Mapping[str, str]] = None,
) -> bool:
    plan = treesitter_plan(repository, lock, emit_warnings)
    runtime_site = tree_sitter_runtime_site(repository, lock)
    return (
        plan is not None
        and runtime_site is not None
        and treesitter_matches_plan(runtime_site, plan, env, repository, emit_warnings)
    )


def check_treesitter_runtime(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    ok = check_tree_sitter_cli(env, repository, treesitter_minimum_cli_version(lock))
    if not check_treesitter_released_sources(repository, lock):
        ok = False
    if not treesitter_runtime_state_ok(repository, lock, emit_warnings=True, env=env):
        ok = False
    return ok


def read_text_file(path: str) -> Optional[str]:
    try:
        with open(path, encoding="utf-8") as file:
            return file.read().strip()
    except (OSError, UnicodeError):
        return None


def schema_catalog_root(repository: str) -> str:
    return os.path.join(repository, SCHEMA_CATALOG_DIR)


def schema_catalog_lua_path(repository: str) -> str:
    return os.path.join(schema_catalog_root(repository), SCHEMA_CATALOG_LUA_NAME)


def schema_catalog_metadata_path(repository: str) -> str:
    return os.path.join(schema_catalog_root(repository), SCHEMA_CATALOG_METADATA_NAME)


def schemastore_worktree(repository: str, lock: JSONMapping) -> Optional[str]:
    return source_worktree_by_id(repository, lock, SCHEMASTORE_SOURCE_ID)


def schemastore_catalog_json_path(repository: str, lock: JSONMapping) -> Optional[str]:
    worktree = schemastore_worktree(repository, lock)
    if worktree is None:
        return None
    return os.path.join(worktree, SCHEMA_CATALOG_SRC_CATALOG)


def schemastore_schemas_dir(repository: str, lock: JSONMapping) -> Optional[str]:
    worktree = schemastore_worktree(repository, lock)
    if worktree is None:
        return None
    return os.path.join(worktree, SCHEMA_CATALOG_SRC_SCHEMAS)


def repository_relative_posix(repository: str, path: str) -> Optional[str]:
    try:
        relative = os.path.relpath(path, repository)
    except ValueError:
        return None
    return relative.replace(os.sep, "/")


# Result kind for classify_schemastore_url. "kept" pairs with a non-None path;
# "external" and "missing" pair with None. These cases partition every URL.
SchemaUrlKind: TypeAlias = Literal["kept", "external", "missing"]


def classify_schemastore_url(
    url: object, repository: str, schemas_dir: str, schemas_dir_real: str
) -> tuple[SchemaUrlKind, Optional[str]]:
    if not isinstance(url, str):
        return "external", None
    match = SCHEMASTORE_URL_PATTERN.match(url)
    if match is None:
        return "external", None
    absolute = os.path.join(schemas_dir, match.group("tail") + ".json")
    real = os.path.realpath(absolute)
    if not path_within_repository(schemas_dir_real, real):
        # Defensive: a hostile catalog URL that resolves outside the vendored
        # tree (e.g. via ../) is treated as missing rather than kept.
        return "missing", None
    if not os.path.isfile(real):
        return "missing", None
    return "kept", repository_relative_posix(repository, real)


@dataclasses.dataclass
class SchemaClassificationCounts:
    entries_external: int = 0
    entries_missing: int = 0
    entries_overridden: int = 0
    versions_external: int = 0
    versions_missing: int = 0


def resolve_schema_catalog_override(
    url: object, repository: str, schemas_dir: str, schemas_dir_real: str
) -> Optional[str]:
    """Return the repo-relative POSIX path for an overridden URL, or None.

    Honors the same path-traversal containment as classify_schemastore_url.
    A stale override (file gone from the vendored tree) returns None so the
    entry falls back to the regular classification path.
    """
    if not isinstance(url, str):
        return None
    filename = SCHEMA_CATALOG_OVERRIDES.get(url)
    if filename is None:
        return None
    absolute = os.path.join(schemas_dir, filename)
    real = os.path.realpath(absolute)
    if not path_within_repository(schemas_dir_real, real):
        return None
    if not os.path.isfile(real):
        return None
    return repository_relative_posix(repository, real)


def classify_schema_entries(
    catalog: JSONMapping, repository: str, schemas_dir: str
) -> tuple[list[JSONObject], SchemaClassificationCounts]:
    raw_entries = catalog.get("schemas")
    if not isinstance(raw_entries, list):
        return [], SchemaClassificationCounts()

    schemas_dir_real = os.path.realpath(schemas_dir)
    entries: list[JSONObject] = []
    counts = SchemaClassificationCounts()

    for raw in raw_entries:
        if not isinstance(raw, dict):
            continue
        url = raw.get("url")
        kind, relative = classify_schemastore_url(
            url, repository, schemas_dir, schemas_dir_real
        )
        if kind != "kept":
            override_relative = resolve_schema_catalog_override(
                url, repository, schemas_dir, schemas_dir_real
            )
            if override_relative is not None:
                relative = override_relative
                counts.entries_overridden += 1
            elif kind == "external":
                counts.entries_external += 1
                continue
            else:
                counts.entries_missing += 1
                continue
        if relative is None:
            # Defensive: classify_schemastore_url("kept", ...) always pairs
            # with a non-None path, but typing allows None.
            counts.entries_missing += 1
            continue
        entry: JSONObject = {"path": relative}
        for key in ("name", "description", "fileMatch"):
            value = raw.get(key)
            if value is not None:
                entry[key] = value
        raw_versions = raw.get("versions")
        if isinstance(raw_versions, dict):
            kept: JSONObject = {}
            for version_key, version_url in raw_versions.items():
                if not isinstance(version_key, str):
                    continue
                v_kind, v_relative = classify_schemastore_url(
                    version_url, repository, schemas_dir, schemas_dir_real
                )
                if v_kind == "external":
                    counts.versions_external += 1
                elif v_kind == "missing" or v_relative is None:
                    counts.versions_missing += 1
                else:
                    kept[version_key] = v_relative
            if kept:
                entry["versions"] = kept
        entries.append(entry)

    return entries, counts


def lua_quote(value: str) -> str:
    buffer: list[str] = ["'"]
    for char in value:
        code = ord(char)
        if char == "\\":
            buffer.append("\\\\")
        elif char == "'":
            buffer.append("\\'")
        elif char == "\n":
            buffer.append("\\n")
        elif char == "\r":
            buffer.append("\\r")
        elif char == "\t":
            buffer.append("\\t")
        elif code < 32 or code == 127:
            buffer.append("\\{0:03d}".format(code))
        else:
            buffer.append(char)
    buffer.append("'")
    return "".join(buffer)


def write_schema_catalog_lua(path: str, entries: Sequence[JSONMapping]) -> bool:
    try:
        body = json.dumps(
            {"entries": list(entries)},
            ensure_ascii=False,
            allow_nan=False,
            separators=(",", ":"),
        )
        # Choose delimiters against encoded JSON, and validate UTF-8 before opening the output.
        delimiter = "="
        while "]" + delimiter + "]" in body:
            delimiter += "="
        content = (
            "-- Generated by ./manage install; do not edit.\n"
            "-- stylua: ignore start\n"
            "return vim.json.decode(["
            + delimiter
            + "["
            + body
            + "]"
            + delimiter
            + "])\n"
            "-- stylua: ignore end\n"
        ).encode("utf-8")
    except (TypeError, ValueError) as exc:
        warn("unable to serialize schema catalog: {0}".format(exc))
        return False
    try:
        with open(path, "wb") as file:
            file.write(content)
    except OSError as exc:
        warn("unable to write {0}: {1}".format(path, exc))
        return False
    return True


def schema_catalog_overrides_sha256() -> str:
    """SHA-256 of the override map as canonical JSON. Including this in the
    state signature means editing SCHEMA_CATALOG_OVERRIDES forces regeneration
    on the next install, without anyone having to remember to bump the
    generator version."""
    serialized = json.dumps(
        SCHEMA_CATALOG_OVERRIDES, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(serialized).hexdigest()


def schema_catalog_metadata_signature(commit: str, catalog_sha256: str) -> JSONObject:
    return {
        "sourceId": SCHEMASTORE_SOURCE_ID,
        "generatorVersion": SCHEMA_CATALOG_GENERATOR_VERSION,
        "commit": commit,
        "catalogSha256": catalog_sha256,
        "overridesSha256": schema_catalog_overrides_sha256(),
    }


def schema_catalog_state_ok(
    repository: str, lock: JSONMapping, emit_warnings: bool
) -> bool:
    expected_commit = source_commit_by_id(lock, SCHEMASTORE_SOURCE_ID)
    if expected_commit is None:
        return True
    catalog_json = schemastore_catalog_json_path(repository, lock)
    if catalog_json is None:
        return False

    lua_path = schema_catalog_lua_path(repository)
    metadata_path = schema_catalog_metadata_path(repository)

    if os.path.islink(lua_path) or not os.path.isfile(lua_path):
        if emit_warnings:
            warn(
                "schema catalog missing/linked: {0}; run ./manage install".format(
                    lua_path
                )
            )
        return False

    metadata = read_json_object_file(metadata_path, emit_warnings=emit_warnings)
    if metadata is None:
        return False

    catalog_sha = sha256_file(catalog_json, emit_warnings=emit_warnings)
    if catalog_sha is None:
        return False

    expected = schema_catalog_metadata_signature(expected_commit, catalog_sha)
    for key, value in expected.items():
        if metadata.get(key) != value:
            if emit_warnings:
                warn(
                    "schema catalog state mismatch ({0}); run ./manage install".format(
                        key
                    )
                )
            return False
    output_sha = sha256_file(lua_path, emit_warnings=emit_warnings)
    if output_sha is None or metadata.get("outputSha256") != output_sha:
        if emit_warnings:
            warn("schema catalog output integrity mismatch; run ./manage install")
        return False
    return True


def materialize_schema_catalog(repository: str, lock: JSONMapping) -> bool:
    expected_commit = source_commit_by_id(lock, SCHEMASTORE_SOURCE_ID)
    if expected_commit is None:
        return True
    catalog_json = schemastore_catalog_json_path(repository, lock)
    schemas_dir = schemastore_schemas_dir(repository, lock)
    if catalog_json is None or schemas_dir is None:
        return False

    if schema_catalog_state_ok(repository, lock, emit_warnings=False):
        return True

    if not os.path.isfile(catalog_json):
        warn(
            "schemastore catalog missing: {0}; run ./manage install --refresh".format(
                catalog_json
            )
        )
        return False
    if not os.path.isdir(schemas_dir):
        warn(
            "schemastore schemas directory missing: {0}; "
            "run ./manage install --refresh".format(schemas_dir)
        )
        return False

    catalog = read_json_object_file(catalog_json, emit_warnings=True)
    if catalog is None:
        return False

    catalog_sha = sha256_file(catalog_json)
    if catalog_sha is None:
        return False

    entries, counts = classify_schema_entries(catalog, repository, schemas_dir)
    if not entries:
        warn("schema catalog produced zero entries; refusing to publish")
        return False

    root = schema_catalog_root(repository)
    parent = os.path.dirname(root)
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(parent, exc))
        return False

    info(
        "materializing schema catalog ({0} entries kept including {1} via "
        "override; dropped {2} entries ({3} missing, {4} external) and {5} "
        "version aliases ({6} missing, {7} external))".format(
            len(entries),
            counts.entries_overridden,
            counts.entries_missing + counts.entries_external,
            counts.entries_missing,
            counts.entries_external,
            counts.versions_missing + counts.versions_external,
            counts.versions_missing,
            counts.versions_external,
        )
    )
    with tempfile.TemporaryDirectory(
        prefix=".{0}.{1}.".format(SCHEMASTORE_SOURCE_ID, os.getpid()), dir=parent
    ) as staging_root:
        staged_root = os.path.join(staging_root, "install")
        try:
            os.makedirs(staged_root, exist_ok=True)
        except OSError as exc:
            warn("unable to create staging directory: {0}".format(exc))
            return False

        if not write_schema_catalog_lua(
            os.path.join(staged_root, SCHEMA_CATALOG_LUA_NAME), entries
        ):
            return False

        output_sha = sha256_file(os.path.join(staged_root, SCHEMA_CATALOG_LUA_NAME))
        if output_sha is None:
            return False
        metadata: JSONObject = dict(
            schema_catalog_metadata_signature(expected_commit, catalog_sha)
        )
        metadata["outputSha256"] = output_sha
        metadata["entries"] = len(entries)
        metadata["entriesMissing"] = counts.entries_missing
        metadata["entriesExternal"] = counts.entries_external
        metadata["entriesOverridden"] = counts.entries_overridden
        metadata["versionsMissing"] = counts.versions_missing
        metadata["versionsExternal"] = counts.versions_external
        try:
            with open(
                os.path.join(staged_root, SCHEMA_CATALOG_METADATA_NAME),
                "w",
                encoding="utf-8",
            ) as file:
                json.dump(metadata, file, indent=2, sort_keys=True)
                file.write("\n")
        except OSError as exc:
            warn("unable to write schema catalog metadata: {0}".format(exc))
            return False

        if not replace_directory(root, staged_root):
            return False
    return True


def install_managed_state_ok(
    env: Mapping[str, str],
    repository: str,
    lock: JSONMapping,
    emit_warnings: bool,
) -> bool:
    ok = True
    if not git_sources_state_ok(env, repository, lock, emit_warnings=emit_warnings):
        ok = False
    if not treesitter_released_sources_state_ok(
        repository, lock, emit_warnings=emit_warnings
    ):
        ok = False
    if not schema_catalog_state_ok(repository, lock, emit_warnings=emit_warnings):
        ok = False
    if not native_plugin_artifacts_state_ok(
        repository, lock, emit_warnings=emit_warnings
    ):
        ok = False
    if not treesitter_runtime_state_ok(
        repository, lock, emit_warnings=emit_warnings, env=env
    ):
        ok = False
    if not python_state_ok(env, repository, emit_warnings):
        ok = False
    if not node_state_ok(env, repository, emit_warnings):
        ok = False
    return ok


def install(offline: bool, refresh: bool) -> int:
    """Install production dependencies and Neovim plugins."""
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1

    repository = repository_dir()
    env = install_environment(home)

    lock = load_git_worktrees_lock(repository)
    if lock is None:
        return 1
    if offline:
        env = local_git_environment(env)
        info("offline mode: reuse/validate ordinary state; acquisition disabled")
        packages_ok = complete_python_offline(env, repository)
        if not node_state_ok(env, repository):
            packages_ok = False
    else:
        packages_ok = sync_uv_production_if_needed(env, repository)
        if not sync_pnpm_production(env, repository):
            packages_ok = False
    if not packages_ok:
        return 1

    if not refresh and install_managed_state_ok(
        env, repository, lock, emit_warnings=False
    ):
        info(
            "managed state already current; skipped source, build, and Treesitter install steps"
        )
        # Nothing changed after validation; mutating preparation validates below.
        return 0 if link_neovim_config(home, repository) else 1
    else:
        if offline:
            git_ready = git_sources_state_ok(env, repository, lock, emit_warnings=True)
            released_ready = treesitter_released_sources_state_ok(
                repository, lock, emit_warnings=True
            )
        else:
            git_ready = materialize_git_sources(env, repository, lock, refresh)
            released_ready = materialize_treesitter_released_sources(repository, lock)
        if not git_ready or not released_ready:
            warn(
                "managed source state is incomplete; no derived/native preparation or linking"
            )
            return 1
        if not materialize_schema_catalog(repository, lock):
            return 1
        if not offline and not install_native_plugin_artifacts(env, repository, lock):
            return 1
        # This routine reuses valid state before probing any build CLI. An
        # unavailable tool never changes the final validation obligation.
        if not install_treesitter_runtime(env, repository, lock):
            return 1
    if not install_managed_state_ok(env, repository, lock, emit_warnings=True):
        return 1
    return 0 if link_neovim_config(home, repository) else 1


def archive_file_selection(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> tuple[Dict[str, str], Dict[str, bytes]]:
    """Select ordinary managed state; sanitization never modifies its sources."""
    selected: Dict[str, str] = {}
    replacements: Dict[str, bytes] = {}
    git = resolve_required("git", env)
    if git is None:
        raise RuntimeError("Git is required for export")

    def add(path: str) -> str:
        relative = os.path.relpath(path, repository).replace(os.sep, "/")
        if (
            validated_relative_subpath(relative) != relative
            or relative.startswith(".git/")
            or relative == ".git"
        ):
            raise RuntimeError("invalid export destination: " + relative)
        if relative in selected and selected[relative] != path:
            raise RuntimeError("colliding export owner: " + relative)
        selected[relative] = path
        return relative

    def tree(root: str) -> None:
        for directory, children, files in os.walk(
            root, followlinks=False, onerror=raise_walk_error
        ):
            add(directory)
            for name in children + files:
                path = os.path.join(directory, name)
                if not os.path.isdir(path) or os.path.islink(path):
                    add(path)

    for source_id, source in manifest_sources(lock).items():
        bare = source_repository_path(repository, lock, source_id, source)
        worktree = source_worktree_path(repository, lock, source_id, source)
        if (
            bare is None
            or worktree is None
            or not worktree_registration_ok(bare, worktree)
        ):
            raise RuntimeError("invalid export source: " + source_id)
        for name in ("HEAD", "packed-refs", "shallow", "objects", "refs", "worktrees"):
            path = os.path.join(bare, name)
            if os.path.isdir(path):
                tree(path)
            elif os.path.lexists(path):
                add(path)
        key = add(os.path.join(bare, "config"))
        # Git metadata is data, not another resolution. Keep only declared
        # transport and sparse/relative-worktree settings; omit hooks, helpers,
        # includes, external alternates, logs, and builder-specific options.
        remote = json.dumps(source_remote(source), ensure_ascii=False)
        url = json.dumps(str(source["url"]), ensure_ascii=False)
        sparse = source_sparse_checkout_paths(source, source_id) is not None
        config = (
            "[core]\n repositoryformatversion = 1\n filemode = true\n bare = true\n[extensions]\n worktreeConfig = "
            + str(sparse).lower()
            + "\n relativeWorktrees = true\n[remote "
            + remote
            + "]\n url = "
            + url
            + "\n"
        )
        filter_value = source_filter(source)
        if filter_value:
            config += (
                " promisor = true\n partialclonefilter = "
                + json.dumps(filter_value)
                + "\n"
            )
        replacements[key] = config.encode("utf-8")
        for relative, path in list(selected.items()):
            if path.startswith(os.path.join(bare, "worktrees") + os.sep):
                name = os.path.basename(path)
                if (
                    name in ("logs", "hooks")
                    or "/logs/" in relative
                    or "/hooks/" in relative
                ):
                    selected.pop(relative)
                elif name == "config.worktree":
                    enabled = (
                        source_sparse_checkout_paths(source, source_id) is not None
                    )
                    replacements[relative] = (
                        "[core]\n bare = false\n sparseCheckout = "
                        + str(enabled).lower()
                        + "\n sparseCheckoutCone = false\n[index]\n sparse = false\n"
                    ).encode("utf-8")
        listing = run_captured_command(
            [git, "-C", worktree, "ls-files", "-t", "-z"], env, repository
        )
        if listing is None or listing.returncode != 0:
            raise RuntimeError("unable to select retained worktree files: " + source_id)
        add(worktree)
        add(os.path.join(worktree, ".git"))
        for entry in listing.stdout.split("\0"):
            if not entry or entry.startswith("S "):
                continue
            path = source_subpath(worktree, entry[2:])
            if path is None:
                raise RuntimeError("invalid retained source path")
            if os.path.lexists(path) and not os.path.isdir(path):
                add(path)
        native = source_native_build(source)
        if native:
            artifact = native_plugin_artifact_path(worktree, native)
            if artifact is not None and os.path.isfile(artifact):
                for relative in native_runtime_files(native):
                    add(os.path.join(worktree, relative))
                stamp = native_build_revision_path(worktree, native)
                if stamp is None:
                    raise RuntimeError("missing native export state")
                add(stamp)
    runtime = tree_sitter_runtime_site(repository, lock)
    plan = treesitter_plan(repository, lock, True)
    if runtime is None or plan is None:
        raise RuntimeError("invalid Tree-sitter export plan")
    for name in plan.files:
        add(os.path.join(runtime, name))
    sources = treesitter_sources_root(repository, lock)
    if sources is not None and os.path.isdir(sources):
        tree(sources)
    node = os.path.join(repository, "node_modules")
    if os.path.isfile(os.path.join(repository, "package.json")):
        state = read_json_object_file(os.path.join(node, COMPONENT_STATE_NAME), True)
        if state is None or not isinstance(state.get("inventory"), dict):
            raise RuntimeError("missing Node export inventory")
        for name in cast(dict[str, JSONValue], state["inventory"]):
            add(os.path.join(node, name))
        add(os.path.join(node, COMPONENT_STATE_NAME))
    if os.path.isfile(os.path.join(repository, "pyproject.toml")):
        state = python_cache_state(repository)
        if state is None or set(cast(list[str], state.get("pythonMinors", []))) != set(
            PYTHON_SUPPORTED_MINORS
        ):
            raise RuntimeError(
                "export requires prepared lock-bound wheels for "
                + PYTHON_RUNTIME_DESCRIPTION
            )
        wheel_root = python_cache_path(repository)
        for name in cast(dict[str, JSONValue], state["wheels"]):
            add(os.path.join(wheel_root, name))
        add(os.path.join(wheel_root, "state.json"))
    catalog = os.path.join(repository, SCHEMA_CATALOG_DIR)
    if os.path.isdir(catalog):
        tree(catalog)
    # Include ancestors explicitly, rejecting members below a linked ancestor.
    for relative in list(selected):
        parent = posixpath.dirname(relative)
        while parent:
            path = os.path.join(repository, *parent.split("/"))
            if os.path.islink(path) or not os.path.isdir(path):
                raise RuntimeError("invalid/linked export ancestor: " + parent)
            add(path)
            parent = posixpath.dirname(parent)
    tracked = run_captured_command(
        [git, "-C", repository, "ls-files", "-z"], env, repository
    )
    if tracked is None or tracked.returncode != 0:
        raise RuntimeError("export requires a Git configuration checkout")
    if set(tracked.stdout.split("\0")) & set(selected):
        raise RuntimeError("export would replace tracked configuration/plugin files")
    return selected, replacements


def write_state_archive(
    repository: str,
    output: str,
    selected: Mapping[str, str],
    replacements: Mapping[str, bytes],
) -> bool:
    """Normalize packaging, not compilation; never publish over another file."""
    temporary = None
    try:
        if os.path.lexists(output) or os.path.commonpath(
            (os.path.realpath(output), os.path.realpath(repository))
        ) == os.path.realpath(repository):
            raise RuntimeError("archive output must be a new file outside the checkout")
        parent = os.path.dirname(os.path.abspath(output))
        fd, temporary = tempfile.mkstemp(prefix=".manage-archive-", dir=parent)
        with (
            os.fdopen(fd, "wb") as raw,
            gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as compressed,
            tarfile.open(
                fileobj=compressed, mode="w", format=tarfile.PAX_FORMAT
            ) as archive,
        ):
            for name, path in sorted(selected.items()):
                if validated_relative_subpath(name) != name:
                    raise RuntimeError("invalid archive member: " + name)
                metadata = os.lstat(path)
                if metadata.st_mode & 0o7000:
                    raise RuntimeError("special archive permissions: " + name)
                entry = tarfile.TarInfo(name)
                entry.uid = entry.gid = entry.mtime = 0
                entry.uname = entry.gname = ""
                if stat.S_ISDIR(metadata.st_mode):
                    entry.type = tarfile.DIRTYPE
                    entry.mode = 0o755
                    archive.addfile(entry)
                elif stat.S_ISLNK(metadata.st_mode):
                    target = os.readlink(path)
                    resolved = posixpath.normpath(
                        posixpath.join(posixpath.dirname(name), target)
                    )
                    if os.path.isabs(target) or resolved not in selected:
                        raise RuntimeError("escaping/unselected archive link: " + name)
                    if name.startswith("node_modules/"):
                        if not resolved.startswith("node_modules/"):
                            raise RuntimeError(
                                "Node link leaves its component: " + name
                            )
                    else:
                        # Source selection already checks worktree containment.
                        if os.path.commonpath(
                            (os.path.realpath(path), os.path.realpath(repository))
                        ) != os.path.realpath(repository):
                            raise RuntimeError("escaping source link: " + name)
                    entry.type = tarfile.SYMTYPE
                    entry.mode = 0o777
                    entry.linkname = target
                    archive.addfile(entry)
                elif stat.S_ISREG(metadata.st_mode):
                    entry.mode = 0o755 if metadata.st_mode & 0o111 else 0o644
                    replacement = replacements.get(name)
                    if replacement is not None:
                        entry.size = len(replacement)
                        archive.addfile(entry, io.BytesIO(replacement))
                    else:
                        entry.size = metadata.st_size
                        with open(path, "rb") as file:
                            archive.addfile(entry, file)
                else:
                    raise RuntimeError("special archive member: " + name)
        if os.path.getsize(temporary) >= ARCHIVE_MAX_BYTES:
            raise RuntimeError("archive exceeds GitHub's 2 GiB asset limit")
        digest = sha256_file(temporary)
        if digest is None:
            raise RuntimeError("unable to hash archive before publication")
        os.link(temporary, output)
        info("archive: " + output + "; sha256=" + digest)
        return True
    except (OSError, RuntimeError, ValueError, tarfile.TarError) as exc:
        warn("archive export failed: " + str(exc))
        return False
    finally:
        if temporary is not None and not remove_path(temporary):
            warn("archive scratch retained: " + temporary)


def runtime_policy() -> JSONObject:
    """Read-only CI/export contract, available without prepared dependencies."""
    return {
        "pythonMinors": list(PYTHON_SUPPORTED_MINORS),
        "archives": [
            {"profile": profile, "os": runner}
            for profile, runner in ARCHIVE_PROFILES.values()
        ],
    }


def archive_profile() -> Optional[str]:
    signature = current_platform_signature()
    profile = ARCHIVE_PROFILES.get((sys.platform, str(signature.get("machine"))))
    expected = ARCHIVE_OS_REQUIREMENTS.get(sys.platform)
    if profile is None or expected is None:
        return None
    actual = runtime_requirements()
    if actual.get("libc") != expected.get("libc"):
        return None
    version = str(actual.get("minimumVersion", ""))
    if not re.fullmatch(r"\d+(?:\.\d+)*", version):
        return None
    return (
        profile[0]
        if numeric_version(version) == numeric_version(expected["minimumVersion"])
        else None
    )


def export_archive(output: str) -> int:
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1
    repository = repository_dir()
    env = local_git_environment(install_environment(home))
    lock = load_git_worktrees_lock(repository)
    if lock is None or not install_managed_state_ok(env, repository, lock, True):
        return 1
    if archive_profile() is None:
        warn(
            "archive export requires a declared Linux glibc 2.39/macOS 14.0 architecture profile; see ./manage policy"
        )
        return 1
    try:
        selected, replacements = archive_file_selection(env, repository, lock)
    except (OSError, RuntimeError, ValueError) as exc:
        warn("unable to select archive state: " + str(exc))
        return 1
    return (
        0
        if write_state_archive(
            repository, os.path.abspath(output), selected, replacements
        )
        else 1
    )


def command_name(command: Sequence[str]) -> str:
    return shlex.join(command)


def print_command(command: Sequence[str]) -> None:
    info("$ {0}".format(command_name(command)))


def print_completed_output(completed: subprocess.CompletedProcess[str]) -> None:
    if completed.stdout:
        print(completed.stdout, end="" if completed.stdout.endswith("\n") else "\n")
    if completed.stderr:
        print(
            completed.stderr,
            end="" if completed.stderr.endswith("\n") else "\n",
            file=sys.stderr,
        )


def run_logged_command(
    command: Sequence[str],
    env: Mapping[str, str],
    repository: str,
    success_message: Optional[str] = None,
    show_success_output_on_stderr: bool = True,
) -> bool:
    print_command(command)
    completed = run_captured_command(command, env, repository)
    if completed is None:
        return False
    if completed.returncode == 0:
        if show_success_output_on_stderr and completed.stderr:
            print_completed_output(completed)
        if success_message:
            info(success_message)
        return True

    print_completed_output(completed)
    warn(
        "command failed with exit code {0}: {1}".format(
            completed.returncode, command_name(command)
        )
    )
    return False


def resolve_required(name: str, env: Mapping[str, str]) -> Optional[str]:
    path = shutil.which(name, path=env.get("PATH"))
    if not path:
        warn("{0} not found on PATH".format(name))
    return path


def neovim_value(
    nvim: str, expression: str, env: Mapping[str, str], repository: str
) -> Optional[str]:
    command = [
        nvim,
        "--clean",
        "--headless",
        "--cmd",
        "lua io.write(" + expression + ")",
        "--cmd",
        "qa",
    ]
    completed = run_captured_command(command, env, repository)
    if completed is None:
        return None
    if completed.returncode != 0:
        warn("unable to query nvim: {0}".format(completed.stderr.strip()))
        return None

    value = completed.stdout.strip()
    if not value:
        warn("nvim returned an empty value for {0}".format(expression))
        return None
    return value


def neovim_runtime(nvim: str, env: Mapping[str, str], repository: str) -> Optional[str]:
    return neovim_value(nvim, "vim.env.VIMRUNTIME", env, repository)


def vendor_dir(repository: str) -> str:
    return os.path.join(repository, VENDOR_DIR_NAME)


def vendored_plugins_dir(repository: str) -> str:
    return os.path.join(vendor_dir(repository), VENDORED_PLUGINS_DIR_NAME)


def vendored_plugin_dir(repository: str, plugin_name: str) -> str:
    return os.path.join(vendored_plugins_dir(repository), plugin_name)


def source_native_build(source: JSONMapping) -> JSONMapping:
    return cast(JSONMapping, source_plugin_metadata(source).get("nativeBuild", {}))


def native_build_optional(native_build: JSONMapping) -> bool:
    return bool(native_build.get("optional", False))


def native_build_minimum_cargo_version(
    native_build: JSONMapping,
) -> Optional[tuple[int, int, int]]:
    value = native_build.get("minimumCargoVersion")
    if not isinstance(value, str):
        return None
    return parse_version_tuple(value)


def native_build_cargo_package(native_build: JSONMapping) -> Optional[str]:
    value = native_build.get("package")
    return value if isinstance(value, str) and value else None


def native_build_cargo_artifact_stem(native_build: JSONMapping) -> Optional[str]:
    value = native_build.get("artifactStem")
    if not isinstance(value, str) or not value:
        return None
    normalized = validated_relative_subpath(value)
    if normalized is None or has_native_library_extension(normalized):
        return None
    return normalized


def native_build_cargo_features(native_build: JSONMapping) -> Sequence[str]:
    value = native_build.get("features")
    if not isinstance(value, list):
        return ()
    features: list[str] = []
    for item in value:
        if isinstance(item, str) and item:
            features.append(item)
    return tuple(features)


def native_build_cargo_command(native_build: JSONMapping) -> Sequence[str]:
    command = [*CARGO_BUILD_RELEASE]
    package = native_build_cargo_package(native_build)
    if package is not None:
        command.extend(["-p", package])
    features = native_build_cargo_features(native_build)
    if features:
        command.extend(["--features", ",".join(features)])
    return command


def cargo_version(
    cargo: str, env: Mapping[str, str], repository: str
) -> Optional[tuple[int, int, int]]:
    completed = run_captured_command([cargo, "--version"], env, repository)
    if completed is None or completed.returncode != 0:
        return None
    return parse_version_tuple(completed.stdout)


def optional_native_build_outcome(
    native_build: JSONMapping, message: str
) -> NativeBuildOutcome:
    if native_build_optional(native_build):
        warn(message + "; skipping optional native build")
        return "skipped"
    warn(message)
    return "failed"


def native_build_source_ids(lock: JSONMapping) -> Sequence[str]:
    return sorted(
        source_id
        for source_id, source in manifest_sources(lock).items()
        if source_native_build(source)
    )


def native_library_extension() -> str:
    return NATIVE_LIBRARY_EXTENSIONS.get(sys.platform, ".so")


def native_plugin_artifact_path(
    worktree: str, native_build: JSONMapping
) -> Optional[str]:
    kind = native_build.get("kind")
    if kind == "cargo":
        artifact_stem = native_build_cargo_artifact_stem(native_build)
        if artifact_stem is None:
            return None
        return (
            os.path.join(worktree, *artifact_stem.split("/"))
            + native_library_extension()
        )
    policy = NATIVE_BUILD_POLICIES.get(str(kind))
    return (
        os.path.join(worktree, policy.artifact) if policy and policy.artifact else None
    )


def native_build_revision_path(
    worktree: str, native_build: JSONMapping
) -> Optional[str]:
    kind = native_build.get("kind")
    if kind == "cargo":
        artifact_path = native_plugin_artifact_path(worktree, native_build)
        if artifact_path is None:
            return None
        return os.path.join(os.path.dirname(artifact_path), ".manage-native-build")
    policy = NATIVE_BUILD_POLICIES.get(str(kind))
    return (
        os.path.join(worktree, policy.revision) if policy and policy.revision else None
    )


def native_build_platform_signature_lines() -> Sequence[str]:
    return [
        "platform {0} {1}".format(key, value)
        for key, value in current_platform_signature().items()
    ]


def native_build_revision_text(
    lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> Optional[str]:
    commit = source_commit_by_id(lock, source_id)
    if commit is None:
        warn("source {0} commit must be a non-empty string".format(source_id))
        return None
    lines = ["source {0} {1}".format(source_id, commit)]
    dependency_sources = native_build_dependency_sources(source_id, native_build)
    if dependency_sources is None:
        return None
    for relative_path, dependency_source_id in sorted(dependency_sources.items()):
        dependency_commit = source_commit_by_id(lock, dependency_source_id)
        if dependency_commit is None:
            warn(
                "source {0} dependency source commit is not available: {1}".format(
                    source_id, dependency_source_id
                )
            )
            return None
        lines.append(
            "dependency {0} {1} {2}".format(
                relative_path, dependency_source_id, dependency_commit
            )
        )
    if native_build.get("kind") == "cargo":
        package = native_build_cargo_package(native_build)
        if package is not None:
            lines.append("cargo package {0}".format(package))
        artifact_stem = native_build_cargo_artifact_stem(native_build)
        if artifact_stem is None:
            warn(
                "source {0} plugin.nativeBuild.artifactStem must be a non-empty worktree-relative path without a native library extension".format(
                    source_id
                )
            )
            return None
        lines.append("cargo artifactStem {0}".format(artifact_stem))
        features = native_build_cargo_features(native_build)
        if features:
            lines.append("cargo features {0}".format(",".join(features)))
    lines.extend(native_build_platform_signature_lines())
    return "\n".join(lines)


def native_runtime_files(native_build: JSONMapping) -> Sequence[str]:
    artifact = native_plugin_artifact_path("", native_build)
    if artifact is None:
        return []
    policy = NATIVE_BUILD_POLICIES[str(native_build["kind"])]
    return list(
        dict.fromkeys(
            [artifact.replace(os.sep, "/"), *(target for _, target in policy.publish)]
        )
    )


def native_build_state(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> Optional[JSONObject]:
    revision = native_build_revision_text(lock, source_id, native_build)
    hashes = output_hashes(worktree, native_runtime_files(native_build))
    if revision is None or hashes is None or not hashes:
        return None
    return {
        "version": NATIVE_STATE_VERSION,
        "revision": revision,
        "platform": dict(
            current_platform_signature(), requirements=runtime_requirements()
        ),
        "outputHashes": hashes,
    }


def write_native_build_revision(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    revision_path = native_build_revision_path(worktree, native_build)
    state = native_build_state(worktree, lock, source_id, native_build)
    if revision_path is None or state is None:
        return False
    try:
        with open(revision_path, "w", encoding="utf-8") as file:
            json.dump(state, file, indent=2)
            file.write("\n")
    except OSError as exc:
        warn(
            "unable to write native build revision for source {0}: {1}".format(
                source_id, exc
            )
        )
        return False
    return True


def native_build_revision_matches(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    revision_path = native_build_revision_path(worktree, native_build)
    expected = native_build_state(worktree, lock, source_id, native_build)
    if revision_path is None or expected is None:
        return False
    state = read_json_object_file(revision_path, False)
    if state is None:
        return False
    built = state.get("platform")
    return (
        isinstance(built, dict)
        and platform_state_ok(built)
        and all(
            state.get(key) == expected[key]
            for key in ("version", "revision", "outputHashes")
        )
    )


def check_native_build_revision(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    if native_build_revision_matches(worktree, lock, source_id, native_build):
        return True
    warn(
        "native build state/output integrity mismatch for source "
        + source_id
        + "; run ./manage install"
    )
    return False


def native_build_artifact_current(
    worktree: str, lock: JSONMapping, source_id: str, native_build: JSONMapping
) -> bool:
    artifact = native_plugin_artifact_path(worktree, native_build)
    if artifact is None or not os.path.isfile(artifact):
        return False
    return native_build_revision_matches(worktree, lock, source_id, native_build)


def overlay_native_build_dependency_sources(
    repository: str,
    lock: JSONMapping,
    worktree: str,
    dependency_sources: Mapping[str, str],
) -> bool:
    for relative_path, dependency_source_id in dependency_sources.items():
        dependency_worktree = source_worktree_by_id(
            repository, lock, dependency_source_id
        )
        if dependency_worktree is None:
            return False
        destination = source_subpath(worktree, relative_path)
        if destination is None:
            return False
        try:
            if os.path.exists(destination) or os.path.islink(destination):
                if not remove_path(destination):
                    return False
            shutil.copytree(
                dependency_worktree,
                destination,
                ignore=shutil.ignore_patterns(".git"),
            )
        except OSError as exc:
            warn(
                "unable to overlay native build dependency source {0} into {1}: {2}".format(
                    dependency_source_id, destination, exc
                )
            )
            return False
    return True


def build_make_runtime(
    make: str,
    env: Mapping[str, str],
    repository: str,
    worktree: str,
    policy: NativeBuildPolicy,
) -> bool:
    arguments = [value.format(worktree=worktree) for value in policy.make_arguments]
    arguments.extend(policy.platform_arguments.get(sys.platform, ()))
    for relative in policy.make_directories:
        directory = os.path.join(worktree, relative)
        if not os.path.isdir(directory):
            warn("native Make build input missing: " + directory)
            return False
        if not run_logged_command(
            [make, *arguments], env, directory, show_success_output_on_stderr=False
        ):
            return False
    try:
        for source, target in policy.publish:
            shutil.copy2(os.path.join(worktree, source), os.path.join(worktree, target))
    except OSError as exc:
        warn("unable to publish native Make outputs: " + str(exc))
        return False
    return True


def build_native_plugin_runtime(
    env: Mapping[str, str],
    repository: str,
    lock: JSONMapping,
    source_id: str,
    worktree: str,
    native_build: JSONMapping,
) -> NativeBuildOutcome:
    source = manifest_sources(lock).get(source_id)
    if source is None or not native_build_paths_ok(worktree, source_id, source):
        return "failed"
    kind = native_build.get("kind")
    if kind == "cargo":
        cargo = resolve_required("cargo", env)
        if cargo is None:
            return optional_native_build_outcome(
                native_build,
                "source {0} requires cargo on PATH".format(source_id),
            )
        minimum_version = native_build_minimum_cargo_version(native_build)
        if minimum_version is not None:
            version = cargo_version(cargo, env, repository)
            if version is None:
                return optional_native_build_outcome(
                    native_build,
                    "unable to query cargo version for source {0}".format(source_id),
                )
            if version < minimum_version:
                return optional_native_build_outcome(
                    native_build,
                    "source {0} requires cargo >= {1}; found {2}".format(
                        source_id,
                        ".".join(str(part) for part in minimum_version),
                        ".".join(str(part) for part in version),
                    ),
                )
        build_env = dict(env, CARGO_TARGET_DIR=os.path.join(worktree, "target"))
        built = run_logged_command(
            [cargo, *native_build_cargo_command(native_build)],
            build_env,
            worktree,
            show_success_output_on_stderr=False,
        )
    elif kind in NATIVE_BUILD_POLICIES:
        policy = NATIVE_BUILD_POLICIES[str(kind)]
        dependency_sources = native_build_dependency_sources(source_id, native_build)
        if dependency_sources is None:
            return "failed"
        if not overlay_native_build_dependency_sources(
            repository, lock, worktree, dependency_sources
        ):
            return "failed"
        make = resolve_required("make", env)
        if make is None:
            return "failed"
        built = build_make_runtime(make, env, repository, worktree, policy)
    else:
        warn("unsupported native build kind for source {0}".format(source_id))
        return "failed"
    artifact = native_plugin_artifact_path(worktree, native_build)
    if not built or artifact is None or not os.path.isfile(artifact):
        return optional_native_build_outcome(
            native_build,
            "native build failed or produced no artifact for source {0}".format(
                source_id
            ),
        )
    if not native_build_paths_ok(worktree, source_id, source):
        return "failed"
    git = resolve_required("git", env)
    if git is None or not check_worktree_pristine(
        git, env, repository, source_id, worktree, source_allowed_dirty_paths(source)
    ):
        return "failed"
    return (
        "built"
        if write_native_build_revision(worktree, lock, source_id, native_build)
        else "failed"
    )


def install_native_plugin_artifacts(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    ok = True
    sources = manifest_sources(lock)
    for source_id in native_build_source_ids(lock):
        source_value = sources[source_id]
        worktree = source_worktree_by_id(repository, lock, source_id)
        if worktree is None:
            ok = False
            continue
        native_build = source_native_build(source_value)
        if not native_build_paths_ok(worktree, source_id, source_value):
            ok = False
            continue
        if native_build_artifact_current(worktree, lock, source_id, native_build):
            continue
        # Never leave an old library eligible for presence-based runtime loading.
        stale_paths = (
            native_plugin_artifact_path(worktree, native_build),
            native_build_revision_path(worktree, native_build),
        )
        if any(path is None for path in stale_paths):
            ok = False
            continue
        removed = [remove_path(path) for path in stale_paths if path is not None]
        if not all(removed):
            ok = False
            continue
        outcome = build_native_plugin_runtime(
            env, repository, lock, source_id, worktree, native_build
        )
        if outcome == "built" and not native_build_artifact_current(
            worktree, lock, source_id, native_build
        ):
            warn(
                "native build did not produce a current artifact for source {0}".format(
                    source_id
                )
            )
            outcome = "failed"
        if outcome != "built":
            cleaned = [remove_path(path) for path in stale_paths if path is not None]
            if outcome == "failed" or not all(cleaned):
                ok = False
    return ok


def native_plugin_artifacts_state_ok(
    repository: str, lock: JSONMapping, emit_warnings: bool
) -> bool:
    sources = manifest_sources(lock)
    ok = True
    for source_id in native_build_source_ids(lock):
        source_value = sources[source_id]
        worktree = source_worktree_by_id(repository, lock, source_id)
        if worktree is None:
            ok = False
            continue
        native_build = source_native_build(source_value)
        if not native_build_paths_ok(worktree, source_id, source_value):
            ok = False
            continue
        artifact = native_plugin_artifact_path(worktree, native_build)
        if artifact is None:
            if emit_warnings:
                warn(
                    "native plugin artifact path is not defined for source {0}".format(
                        source_id
                    )
                )
            ok = False
            continue
        if not os.path.isfile(artifact):
            if native_build_optional(native_build):
                revision_path = native_build_revision_path(worktree, native_build)
                if revision_path is not None and os.path.lexists(revision_path):
                    if emit_warnings:
                        warn(
                            "orphaned native build revision for source {0}; run ./manage install".format(
                                source_id
                            )
                        )
                    ok = False
                    continue
                if emit_warnings:
                    info(
                        "optional native plugin artifact not installed for source {0}".format(
                            source_id
                        )
                    )
            else:
                if emit_warnings:
                    warn(
                        "native plugin artifact missing: {0}; run ./manage install".format(
                            artifact
                        )
                    )
                ok = False
            continue
        if emit_warnings:
            if not check_native_build_revision(worktree, lock, source_id, native_build):
                ok = False
        elif not native_build_revision_matches(worktree, lock, source_id, native_build):
            ok = False
    return ok


def check_native_plugin_artifacts(repository: str, lock: JSONMapping) -> bool:
    return native_plugin_artifacts_state_ok(repository, lock, emit_warnings=True)


def read_json_object(path: str) -> Optional[JSONObject]:
    return read_json_object_file(path, emit_warnings=True)


def validate_upstream_metadata(path: str, metadata: JSONMapping) -> bool:
    required_strings = ("url", "commit")
    for key in required_strings:
        value = metadata.get(key)
        if not isinstance(value, str) or not value:
            warn("{0} {1} must be a non-empty string".format(path, key))
            return False

    optional_strings = ("ref", "importedAt", "notes")
    for key in optional_strings:
        value = metadata.get(key)
        if value is not None and not isinstance(value, str):
            warn("{0} {1} must be a string".format(path, key))
            return False

    return True


def nested_git_path(path: str) -> Optional[str]:
    for current_root, directory_names, file_names in os.walk(path):
        if ".git" in directory_names:
            return os.path.join(current_root, ".git")
        if ".git" in file_names:
            return os.path.join(current_root, ".git")
    return None


def discover_vendored_plugins(repository: str) -> Optional[Sequence[str]]:
    init_path = os.path.join(repository, "init.lua")
    try:
        with open(init_path, encoding="utf-8") as file:
            text = file.read()
    except OSError as exc:
        warn("unable to read {0}: {1}".format(init_path, exc))
        return None
    return sorted(set(VENDORED_PLUGIN_CALL_PATTERN.findall(text)))


def check_vendored_plugins(repository: str) -> bool:
    plugin_names = discover_vendored_plugins(repository)
    if plugin_names is None:
        return False

    ok = True
    repository_realpath = os.path.realpath(repository)
    for plugin_name in plugin_names:
        path = vendored_plugin_dir(repository, plugin_name)
        realpath = os.path.realpath(path)
        if not os.path.isdir(path):
            warn("vendored plugin not found: {0}".format(path))
            ok = False
            continue
        if not path_within_repository(repository_realpath, realpath):
            warn("vendored plugin escapes repository: {0}".format(path))
            ok = False
        git_path = nested_git_path(path)
        if git_path is not None:
            warn("vendored plugin contains nested .git: {0}".format(git_path))
            ok = False
        upstream_path = os.path.join(path, UPSTREAM_METADATA_NAME)
        if os.path.exists(upstream_path):
            metadata = read_json_object(upstream_path)
            if metadata is None or not validate_upstream_metadata(
                upstream_path, metadata
            ):
                ok = False
    return ok


def expand_lua_library_path(
    path: str, env: Mapping[str, str], repository: str
) -> Optional[str]:
    if "${3rd}" in path:
        return None

    missing = []

    def replace_env(match: re.Match[str]) -> str:
        name = match.group(1)
        value = env.get(name)
        if value is None:
            missing.append(name)
            return match.group(0)
        return value

    expanded = ENV_VARIABLE_PATTERN.sub(replace_env, path)
    if missing:
        raise RuntimeError(
            "environment variable missing in .luarc.json: {0}".format(missing[0])
        )

    if "${" in expanded:
        raise RuntimeError("unsupported variable in .luarc.json path: {0}".format(path))

    if os.path.isabs(expanded):
        return expanded
    return os.path.join(repository, expanded)


def lua_workspace_libraries(
    env: Mapping[str, str], repository: str
) -> Optional[Sequence[str]]:
    config = read_json_object_file(
        os.path.join(repository, ".luarc.json"), emit_warnings=True
    )
    if config is None:
        return None
    libraries = config.get("workspace.library", [])
    if not isinstance(libraries, list):
        warn(".luarc.json workspace.library must be a list")
        return None

    expanded_libraries = []
    for library in libraries:
        if not isinstance(library, str):
            warn(".luarc.json workspace.library entries must be strings")
            return None
        try:
            expanded = expand_lua_library_path(library, env, repository)
        except RuntimeError as exc:
            warn(str(exc))
            return None
        if expanded is not None:
            expanded_libraries.append(expanded)

    return expanded_libraries


def discover_lua_specs(repository: str) -> Sequence[str]:
    root = os.path.join(repository, LUA_CHECK_PATH)
    specs = []
    for directory, _, filenames in os.walk(root):
        for filename in filenames:
            if filename.endswith("_spec.lua"):
                specs.append(os.path.join(directory, filename))
    return sorted(specs)


def check(fix: bool) -> int:
    """Run development checks without installing tools implicitly."""
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1

    repository = repository_dir()
    env = install_environment(home)
    if not env.get("XDG_DATA_HOME"):
        env["XDG_DATA_HOME"] = os.path.join(home, ".local", "share")

    uv = resolve_required("uv", env)
    stylua = resolve_required("stylua", env)
    lua_language_server = resolve_required("lua-language-server", env)
    nvim = resolve_required("nvim", env)
    if uv is None or stylua is None or lua_language_server is None or nvim is None:
        return 1

    lock = load_git_worktrees_lock(repository)
    if lock is None:
        return 1

    ok = True
    if not check_git_sources(env, repository, lock):
        ok = False
    if not check_treesitter_runtime(env, repository, lock):
        ok = False
    if not check_native_plugin_artifacts(repository, lock):
        ok = False
    if not schema_catalog_state_ok(repository, lock, emit_warnings=True):
        ok = False
    if not check_vendored_plugins(repository):
        ok = False

    runtime = neovim_runtime(nvim, env, repository)
    if not runtime:
        return 1
    env["VIMRUNTIME"] = runtime

    libraries = lua_workspace_libraries(env, repository)
    if libraries is None:
        return 1

    missing_libraries = [library for library in libraries if not os.path.isdir(library)]
    if missing_libraries:
        for library in missing_libraries:
            warn("{0} not found; run ./manage install".format(library))
        return 1

    plenary = source_worktree_by_id(repository, lock, PLENARY_PLUGIN_NAME)
    if plenary is None:
        return 1
    if not os.path.isdir(plenary):
        warn("{0} not found; run ./manage install".format(plenary))
        return 1

    specs = discover_lua_specs(repository)
    if not specs:
        warn("no Lua spec files found under {0}".format(LUA_CHECK_PATH))
        return 1

    lua_language_server_commands = [
        [
            lua_language_server,
            "--check=" + target,
            "--checklevel=Warning",
            "--check_format=pretty",
            "--configpath=" + os.path.join(repository, ".luarc.json"),
        ]
        for target in LUA_CHECK_TARGETS
    ]

    ruff_format = [uv, *UV_RUN_CHECK, "ruff", "format"]
    if not fix:
        ruff_format.append("--check")
    ruff_format.extend(["manage", "tests"])

    ruff_check = [uv, *UV_RUN_CHECK, "ruff", "check"]
    if fix:
        ruff_check.append("--fix")
    ruff_check.extend(["manage", "tests"])

    stylua_check = [stylua]
    if not fix:
        stylua_check.append("--check")
    stylua_check.extend(LUA_CHECK_TARGETS)

    commands = [
        ruff_format,
        ruff_check,
        [uv, *UV_RUN_CHECK, "ty", "check", "manage", "tests"],
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"],
        stylua_check,
        *lua_language_server_commands,
    ]

    runtimepath_command = (
        "lua vim.opt.runtimepath:prepend({0}); vim.opt.runtimepath:prepend({1})".format(
            lua_quote(plenary), lua_quote(repository)
        )
    )
    plenary_command = [
        nvim,
        "--headless",
        "--noplugin",
        "--cmd",
        runtimepath_command,
        "-c",
        "lua require('plenary.test_harness').test_directory("
        + lua_quote(LUA_CHECK_PATH)
        + ", { sequential = true })",
    ]

    for command in commands:
        if not run_logged_command(command, env, repository):
            ok = False

    if not ok:
        warn("skipped Plenary because prerequisite or development checks failed")
        return 1
    if not run_logged_command(
        plenary_command,
        env,
        repository,
        "plenary: {0} Lua spec file(s) passed".format(len(specs)),
        show_success_output_on_stderr=False,
    ):
        ok = False

    return 0 if ok else 1


def scan(strict: bool, paths: Sequence[str]) -> int:
    """Scan vendored third-party code for malicious patterns."""
    invocation_directory = os.getcwd()
    repository = repository_dir()
    try:
        home = home_dir()
    except RuntimeError as exc:
        warn(str(exc))
        return 1
    env = install_environment(home)

    uv = resolve_required("uv", env)
    if uv is None:
        return 1

    rules_dir = os.path.join(repository, SCAN_RULES_DIR)
    if not os.path.isdir(rules_dir):
        warn(
            "rules directory not found: {0}; expected at {1}".format(
                SCAN_RULES_DIR, rules_dir
            )
        )
        return 1

    if paths:
        targets = [
            os.path.abspath(os.path.join(invocation_directory, path)) for path in paths
        ]
        invalid_targets = [
            path
            for path in targets
            if not (os.path.isfile(path) or os.path.isdir(path))
        ]
        if invalid_targets:
            for path in invalid_targets:
                warn(
                    "scan target must be an existing file or directory: {0}".format(
                        path
                    )
                )
            return 1
    else:
        targets = [
            os.path.join(repository, subdir)
            for subdir in SCAN_TARGETS
            if os.path.isdir(os.path.join(repository, subdir))
        ]
        if not targets:
            warn("no vendor directories found; run ./manage install first")
            return 1

    semgrep_command = [
        uv,
        *UV_RUN_CHECK,
        "semgrep",
        "--config",
        SCAN_RULES_DIR,
        "--severity",
        "ERROR",
        "--error",
        "--no-git-ignore",
    ]
    if strict:
        semgrep_command.extend(["--severity", "WARNING"])
    semgrep_command.extend(targets)

    return 0 if run_logged_command(semgrep_command, env, repository) else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="manage")
    subparsers = parser.add_subparsers(dest="command", title="commands")

    install_parser = subparsers.add_parser(
        "install",
        help="sync production dependencies and ensure the managed Neovim runtime",
        description=(
            "Sync production dependencies when needed, then ensure the pinned managed "
            "Neovim runtime locally. Repeated installs skip source, build, and "
            "Treesitter work when local state is already current."
        ),
    )
    install_parser.add_argument(
        "--offline",
        action="store_true",
        help="reuse verified ordinary state or local Python wheels; prohibit acquisition and native builds; validate all required components before linking",
    )
    install_parser.add_argument(
        "--refresh",
        action="store_true",
        help="force Git ref refresh before ensuring the pinned manifest state locally",
    )

    subparsers.add_parser(
        "policy",
        help="print supported Python/archive CI policy as JSON (no dependency loading)",
    )

    archive_parser = subparsers.add_parser(
        "archive", help="export verified ordinary state without acquisition or repair"
    )
    archive_parser.add_argument(
        "--output", required=True, help="new archive path outside the checkout"
    )

    check_parser = subparsers.add_parser(
        "check",
        help="run Python and Lua development checks",
        description="Run Python and Lua development checks without installing tools implicitly.",
    )
    check_parser.add_argument(
        "--fix",
        action="store_true",
        help="format and apply safe fixes before running non-mutating checks",
    )

    scan_parser = subparsers.add_parser(
        "scan",
        help="run semgrep security scan on vendored third-party code",
        description=(
            "Scan vendor directories, or explicit files and directories, for malicious "
            "code patterns using semgrep rules from rules/. By default exits non-zero "
            "only on ERROR-severity findings. Run ./manage install first to populate "
            "vendor directories when no scan path is provided."
        ),
    )
    scan_parser.add_argument(
        "--strict",
        action="store_true",
        help="exit non-zero on WARNING findings in addition to ERROR findings",
    )
    scan_parser.add_argument(
        "paths",
        nargs="*",
        help="optional files or directories to scan; defaults to managed vendor directories",
    )

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "install":
        return install(args.offline, args.refresh)

    if args.command == "archive":
        return export_archive(args.output)
    if args.command == "policy":
        print(json.dumps(runtime_policy(), sort_keys=True))
        return 0

    if args.command == "check":
        return check(args.fix)

    if args.command == "scan":
        return scan(args.strict, args.paths)

    parser.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
