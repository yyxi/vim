def supplemental_query_source_path(
    repository: str, lock: JSONMapping, group: JSONMapping, language: str
) -> Optional[tuple[str, str, str]]:
    group_name = group.get("name")
    source_id = group.get("source")
    if not isinstance(group_name, str) or not group_name:
        warn("supplemental query group name must be a non-empty string")
        return None
    if not isinstance(source_id, str) or not source_id:
        warn(
            "supplemental query group {0} source must be a non-empty string".format(
                group_name
            )
        )
        return None

    query_path = group.get("path")
    if not isinstance(query_path, str):
        template = group.get("pathTemplate", "queries/{language}/{group}.scm")
        if not isinstance(template, str):
            warn(
                "supplemental query group {0} pathTemplate must be a string".format(
                    group_name
                )
            )
            return None
        query_path = template.replace("{language}", language).replace(
            "{group}", group_name
        )
    normalized_query_path = validated_relative_subpath(query_path)
    if normalized_query_path is None:
        warn(
