def source_treesitter_released_source(source: JSONMapping) -> JSONMapping:
    released_source = source_treesitter(source).get("releasedSource", {})
    return released_source if isinstance(released_source, dict) else {}


def normalize_relative_subpath(path: str) -> str:
    normalized = path.replace("\\", "/")
    while normalized.startswith("./"):
        normalized = normalized[2:]
    while normalized.startswith("//"):
        normalized = normalized[1:]
    if normalized.startswith("/"):
        normalized = normalized[1:]
    return normalized.rstrip("/")


def validated_relative_subpath(path: str) -> Optional[str]:
    normalized = normalize_relative_subpath(path)
    if not normalized or normalized in (".", "..") or normalized.startswith("../"):
        return None
    return normalized


def validated_relative_subpath_or_current(path: str) -> Optional[str]:
    normalized = normalize_relative_subpath(path)
    if normalized in ("", "."):
        return "."
    if normalized == ".." or normalized.startswith("../"):
        return None
    return normalized


def treesitter_released_source_files(released_source: JSONMapping) -> Sequence[str]:
    value = released_source.get("files", [])
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return [normalize_relative_subpath(str(item)) for item in value]
    return []


def validate_treesitter_released_source(
    source_id: str, released_source: JSONMapping
) -> bool:
    url = released_source.get("url")
    if not isinstance(url, str) or not url:
        warn(
            "source {0} treesitter.releasedSource.url must be a non-empty string".format(
                source_id
            )
        )
        return False

    sha256 = released_source.get("sha256")
    if not isinstance(sha256, str) or SHA256_PATTERN.match(sha256) is None:
        warn(
            "source {0} treesitter.releasedSource.sha256 must be a lowercase SHA-256 digest".format(
                source_id
            )
        )
        return False

    files = released_source.get("files")
    if (
        not isinstance(files, list)
        or not files
        or not all(isinstance(item, str) for item in files)
    ):
        warn(
            "source {0} treesitter.releasedSource.files must be a non-empty list of paths".format(
                source_id
            )
        )
        return False

    normalized_files: list[str] = []
    for item in files:
        normalized = validated_relative_subpath(str(item))
        if normalized is None:
            warn(
                "source {0} treesitter.releasedSource.files entries must be non-empty relative paths".format(
                    source_id
                )
            )
            return False
        for existing in normalized_files:
            if normalized == existing:
                warn(
                    "source {0} treesitter.releasedSource.files entries must not repeat paths".format(
                        source_id
                    )
                )
                return False
            if normalized.startswith(existing + "/") or existing.startswith(
                normalized + "/"
            ):
                warn(
                    "source {0} treesitter.releasedSource.files entries must not overlap".format(
                        source_id
                    )
                )
                return False
        normalized_files.append(normalized)

    return True


def source_plugin_metadata(source: JSONMapping) -> JSONMapping:
    plugin = source.get("plugin", {})
    return plugin if isinstance(plugin, dict) else {}


def native_build_dependency_sources(
    source_id: str, native_build: JSONMapping
) -> Optional[dict[str, str]]:
    value = native_build.get("dependencySources")
    if value is None:
        return {}
    if not isinstance(value, dict):
        warn(
            "source {0} plugin.nativeBuild.dependencySources must be an object of strings".format(
                source_id
            )
        )
        return None
    dependencies: dict[str, str] = {}
    for relative_path, dependency_source_id in value.items():
        if not isinstance(relative_path, str) or not relative_path:
            warn(
                "source {0} plugin.nativeBuild.dependencySources keys must be non-empty worktree-relative paths".format(
                    source_id
                )
            )
            return None
        normalized_path = validated_relative_subpath(relative_path)
        if normalized_path is None:
            warn(
                "source {0} plugin.nativeBuild.dependencySources keys must be non-empty worktree-relative paths".format(
                    source_id
                )
            )
            return None
        if normalized_path in dependencies:
            warn(
                "source {0} plugin.nativeBuild.dependencySources must not repeat destination paths".format(
                    source_id
                )
            )
            return None
        for existing_path in dependencies:
            if normalized_path.startswith(
                existing_path + "/"
            ) or existing_path.startswith(normalized_path + "/"):
                warn(
                    "source {0} plugin.nativeBuild.dependencySources must not contain overlapping destination paths".format(
                        source_id
                    )
                )
                return None
        if not valid_source_id(dependency_source_id):
            warn(
                "source {0} plugin.nativeBuild.dependencySources values must be valid source ids".format(
                    source_id
                )
            )
            return None
        dependencies[normalized_path] = dependency_source_id
    return dependencies


def valid_source_id(source_id: object) -> bool:
    return isinstance(source_id, str) and SOURCE_ID_PATTERN.match(source_id) is not None


def root_treesitter_metadata(lock: JSONMapping) -> JSONMapping:
    treesitter = lock.get("treesitter", {})
    return treesitter if isinstance(treesitter, dict) else {}


def source_repository_path(
    repository: str, lock: JSONMapping, source_id: str, source: JSONMapping
) -> Optional[str]:
    explicit = source.get("repository")
    if explicit is not None:
        if not isinstance(explicit, str):
            warn("source {0} repository must be a string".format(source_id))
            return None
        return repository_path(repository, explicit)

    roots = lock_roots(lock)
    root = roots.get("repositories", os.path.join("vendor", "git", "repositories"))
    if not isinstance(root, str):
        warn("roots.repositories must be a string")
        return None
    return repository_path(repository, os.path.join(root, source_id + ".git"))


def source_worktree_path(
    repository: str, lock: JSONMapping, source_id: str, source: JSONMapping
) -> Optional[str]:
    explicit = source.get("worktree")
    if explicit is not None:
        if not isinstance(explicit, str):
            warn("source {0} worktree must be a string".format(source_id))
            return None
        return repository_path(repository, explicit)

    roots = lock_roots(lock)
    root = roots.get("worktrees", os.path.join("vendor", "git", "worktrees"))
    if not isinstance(root, str):
        warn("roots.worktrees must be a string")
        return None
    return repository_path(repository, os.path.join(root, source_id))


def source_remote(source: JSONMapping) -> str:
    remote = source.get("remote", DEFAULT_GIT_REMOTE)
    return remote if isinstance(remote, str) and remote else DEFAULT_GIT_REMOTE


def source_filter(source: JSONMapping) -> Optional[str]:
    value = source.get("filter", DEFAULT_GIT_FILTER)
    return value if isinstance(value, str) and value else None


def source_locked(source: JSONMapping) -> bool:
    value = source.get("locked", DEFAULT_WORKTREE_LOCKED)
    return bool(value)


def normalize_worktree_path(path: str) -> str:
    normalized = path.replace("\\", "/")
    while normalized.startswith("./"):
        normalized = normalized[2:]
    return normalized.rstrip("/")


def source_allowed_dirty_paths(source: JSONMapping) -> Sequence[str]:
    value = source.get("allowedDirtyPaths", [])
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        paths: list[str] = []
        for item in value:
            normalized = validated_relative_subpath(str(item))
            if normalized is not None:
                paths.append(normalize_worktree_path(normalized))
        return paths
    return []


def validate_source_settings(source_id: str, source: JSONMapping) -> bool:
    remote = source.get("remote")
    if remote is not None and (not isinstance(remote, str) or not remote):
        warn("source {0} remote must be a non-empty string".format(source_id))
        return False

    filter_value = source.get("filter")
    if filter_value is not None and (
        not isinstance(filter_value, str) or not filter_value
    ):
        warn("source {0} filter must be a non-empty string".format(source_id))
        return False

    locked = source.get("locked")
    if locked is not None and not isinstance(locked, bool):
        warn("source {0} locked must be a boolean".format(source_id))
        return False

    allowed_dirty_paths = source.get("allowedDirtyPaths")
    if allowed_dirty_paths is not None:
        if not isinstance(allowed_dirty_paths, list) or not all(
            isinstance(item, str) for item in allowed_dirty_paths
        ):
            warn(
                "source {0} allowedDirtyPaths must be a list of strings".format(
                    source_id
                )
            )
            return False
        if any(
            validated_relative_subpath(item) is None for item in allowed_dirty_paths
        ):
            warn(
                "source {0} allowedDirtyPaths entries must be non-empty repository-relative paths".format(
                    source_id
                )
            )
            return False

    treesitter = source.get("treesitter")
    if treesitter is not None:
        if not isinstance(treesitter, dict):
            warn("source {0} treesitter must be an object".format(source_id))
            return False
        released_source = treesitter.get("releasedSource")
        if released_source is not None:
            if not isinstance(released_source, dict):
                warn(
                    "source {0} treesitter.releasedSource must be an object".format(
                        source_id
                    )
                )
                return False
            if not validate_treesitter_released_source(
                source_id, cast(JSONMapping, released_source)
            ):
                return False

    plugin = source.get("plugin")
    if plugin is not None:
        if not isinstance(plugin, dict):
            warn("source {0} plugin must be an object".format(source_id))
            return False
        native_build = plugin.get("nativeBuild")
        if native_build is not None:
            if not isinstance(native_build, dict):
                warn(
                    "source {0} plugin.nativeBuild must be an object".format(source_id)
                )
                return False
            kind = native_build.get("kind")
            if kind not in ("cargo", "luasnip_jsregexp", "make"):
                warn(
                    "source {0} plugin.nativeBuild.kind must be one of cargo, luasnip_jsregexp, make".format(
                        source_id
                    )
                )
                return False
            if native_build_dependency_sources(source_id, native_build) is None:
                return False
            optional = native_build.get("optional")
            if optional is not None and not isinstance(optional, bool):
                warn(
                    "source {0} plugin.nativeBuild.optional must be a boolean".format(
                        source_id
                    )
                )
                return False
            minimum_cargo_version = native_build.get("minimumCargoVersion")
            if minimum_cargo_version is not None and (
                not isinstance(minimum_cargo_version, str)
                or parse_version_tuple(minimum_cargo_version) is None
            ):
                warn(
                    "source {0} plugin.nativeBuild.minimumCargoVersion must be a semantic version string".format(
                        source_id
                    )
                )
                return False

    return True


def source_sparse_checkout_paths(
    source: JSONMapping, source_id: str
) -> Optional[Sequence[str]]:
    value = source.get("files")
    if value is None:
        return None
    if not isinstance(value, list) or not value:
        warn(
            "source {0} files must be a non-empty list of repository-relative paths".format(
                source_id
            )
        )
        return []
    paths: list[str] = []
    for item in value:
        if not isinstance(item, str) or not item:
            warn(
                "source {0} files entries must be non-empty repository-relative paths".format(
                    source_id
                )
            )
            return []
        normalized = validated_relative_subpath(item)
        if normalized is None:
            warn(
                "source {0} files entries must not escape the repository".format(
                    source_id
                )
            )
            return []
        for existing_path in paths:
            existing_normalized = existing_path[1:]
            if normalized == existing_normalized:
                warn("source {0} files entries must not repeat paths".format(source_id))
                return []
            if normalized.startswith(
                existing_normalized + "/"
            ) or existing_normalized.startswith(normalized + "/"):
                warn("source {0} files entries must not overlap".format(source_id))
                return []
        paths.append("/" + normalized)
    return paths


def git_dir_command(git: str, git_dir: str, args: Sequence[str]) -> Sequence[str]:
    return [git, "--git-dir", git_dir, *args]


def ensure_bare_repository(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    git_dir: str,
) -> bool:
    url = source.get("url")
    if not isinstance(url, str) or not url:
        warn("source {0} url must be a non-empty string".format(source_id))
        return False

    remote = source_remote(source)

    if not os.path.isdir(git_dir):
        parent = os.path.dirname(git_dir)
        try:
            os.makedirs(parent, exist_ok=True)
        except OSError as exc:
            warn("unable to create {0}: {1}".format(parent, exc))
            return False
        filter_value = source_filter(source)
        command = [git, "clone", "--bare", "--origin", remote]
        if filter_value:
            command.append("--filter=" + filter_value)
        command.extend([url, git_dir])
        return run_logged_command(
            command, env, repository, show_success_output_on_stderr=False
        )

    completed = run_captured_command(
        git_dir_command(git, git_dir, ["remote", "get-url", remote]), env, repository
    )
    if completed is None or completed.returncode != 0:
        warn("unable to inspect remote {0} for source {1}".format(remote, source_id))
        if completed is not None:
            print_completed_output(completed)
        return False
    current_url = completed.stdout.strip()
    if current_url != url:
        warn(
            "source {0} remote {1} mismatch: expected {2}, found {3}".format(
                source_id, remote, url, current_url
            )
        )
        return False
    return True


def fetch_source_commit(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    git_dir: str,
) -> bool:
    commit = source.get("commit")
    if not isinstance(commit, str) or not commit:
        warn("source {0} commit must be a non-empty string".format(source_id))
        return False

    remote = source_remote(source)
    filter_value = source_filter(source)
    fetch_base = ["fetch"]
    if filter_value:
        fetch_base.append("--filter=" + filter_value)
    ref = source.get("ref")
    if (not isinstance(ref, str) or not ref) and commit_available(
        git, env, repository, git_dir, commit
    ):
        return True
    ref_fetched = False
    if isinstance(ref, str) and ref:
        if not run_logged_command(
            git_dir_command(git, git_dir, [*fetch_base, remote, ref]),
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False
        ref_fetched = True
    if ref_fetched and commit_available(git, env, repository, git_dir, commit):
        return True
    if not run_logged_command(
        git_dir_command(git, git_dir, [*fetch_base, remote, commit]),
        env,
        repository,
        show_success_output_on_stderr=False,
    ):
        return False
    return verify_commit(git, env, repository, source_id, git_dir, commit)


def commit_available(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    commit: str,
) -> bool:
    completed = run_captured_command(
        git_dir_command(
            git,
            git_dir,
            ["rev-parse", "--verify", "--end-of-options", commit + "^{commit}"],
        ),
        env,
        repository,
    )
    return completed is not None and completed.returncode == 0


def verify_commit(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    git_dir: str,
    commit: str,
) -> bool:
    completed = run_captured_command(
        git_dir_command(
            git,
            git_dir,
            ["rev-parse", "--verify", "--end-of-options", commit + "^{commit}"],
        ),
        env,
        repository,
    )
    if completed is None or completed.returncode != 0:
        warn("source {0} commit is not available: {1}".format(source_id, commit))
        if completed is not None:
            print_completed_output(completed)
        return False
    return True


def is_git_worktree(path: str) -> bool:
    return os.path.exists(os.path.join(path, ".git"))


def worktree_head(
    git: str, env: Mapping[str, str], repository: str, worktree: str
) -> Optional[str]:
    completed = run_captured_command(
        [git, "-C", worktree, "rev-parse", "HEAD"], env, repository
    )
    if completed is None or completed.returncode != 0:
        if completed is not None:
            print_completed_output(completed)
        return None
    return completed.stdout.strip()


def worktree_sparse_checkout_enabled(
    git: str, env: Mapping[str, str], repository: str, worktree: str
) -> Optional[bool]:
    completed = run_captured_command(
        [
            git,
            "-C",
            worktree,
            "config",
            "--worktree",
            "--get",
            "--bool",
            "core.sparseCheckout",
        ],
        env,
        repository,
    )
    if completed is None:
        return None
    if completed.returncode != 0:
        return False
    return completed.stdout.strip() == "true"


def worktree_sparse_checkout_list(
    git: str, env: Mapping[str, str], repository: str, worktree: str
) -> Optional[Sequence[str]]:
    completed = run_captured_command(
        [git, "-C", worktree, "sparse-checkout", "list"], env, repository
    )
    if completed is None or completed.returncode != 0:
        return None
    return [line for line in completed.stdout.splitlines() if line]


def configure_worktree_sparse_checkout(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    worktree: str,
    sparse_paths: Optional[Sequence[str]],
    initialize: bool,
) -> bool:
    if sparse_paths is None:
        enabled = worktree_sparse_checkout_enabled(git, env, repository, worktree)
        if enabled is None:
            warn("unable to inspect source {0} sparse checkout state".format(source_id))
            return False
        if not enabled:
            return True
        return run_logged_command(
            [git, "-C", worktree, "sparse-checkout", "disable"],
            env,
            repository,
            show_success_output_on_stderr=False,
        )

    if not run_logged_command(
        [git, "-C", worktree, "sparse-checkout", "set", "--no-cone", *sparse_paths],
        env,
        repository,
        show_success_output_on_stderr=False,
    ):
        return False

    if not initialize:
        return True

    return run_logged_command(
        [git, "-C", worktree, "read-tree", "-mu", "HEAD"],
        env,
        repository,
        show_success_output_on_stderr=False,
    )


def ensure_worktree(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    git_dir: str,
    worktree: str,
) -> bool:
    commit = source.get("commit")
    if not isinstance(commit, str) or not commit:
        warn("source {0} commit must be a non-empty string".format(source_id))
        return False

    sparse_paths = source_sparse_checkout_paths(source, source_id)
    if sparse_paths == []:
        return False

    if os.path.exists(worktree):
        if not is_git_worktree(worktree):
            warn(
                "source {0} worktree exists but is not a Git worktree: {1}".format(
                    source_id, worktree
                )
            )
            return False
        if not check_worktree_pristine(
            git,
            env,
            repository,
            source_id,
            worktree,
            source_allowed_dirty_paths(source),
        ):
            return False
        if not configure_worktree_sparse_checkout(
            git,
            env,
            repository,
            source_id,
            worktree,
            sparse_paths,
            initialize=False,
        ):
            return False
        if not run_logged_command(
            [git, "-C", worktree, "checkout", "--detach", commit],
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False
    else:
        if not remove_missing_worktree_registration(
            git, env, repository, git_dir, worktree
        ):
            return False
        try:
            os.makedirs(os.path.dirname(worktree), exist_ok=True)
        except OSError as exc:
            warn(
                "unable to create parent directory for source {0} worktree: {1}".format(
                    source_id, exc
                )
            )
            return False
        args = ["worktree", "add", "--detach"]
        if sparse_paths is not None:
            args.append("--no-checkout")
        if source_locked(source):
            args.extend(["--lock", "--reason", WORKTREE_LOCK_REASON])
        args.extend([worktree, commit])
        if not run_logged_command(
            git_dir_command(git, git_dir, args),
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False
        if not configure_worktree_sparse_checkout(
            git,
            env,
            repository,
            source_id,
            worktree,
            sparse_paths,
            initialize=sparse_paths is not None,
        ):
            return False

    if source_locked(source) and not worktree_is_locked(
        git, env, repository, git_dir, worktree
    ):
        if not run_logged_command(
            git_dir_command(
                git,
                git_dir,
                ["worktree", "lock", "--reason", WORKTREE_LOCK_REASON, worktree],
            ),
            env,
            repository,
            show_success_output_on_stderr=False,
        ) and not worktree_is_locked(git, env, repository, git_dir, worktree):
            return False
    return check_worktree_pristine(
        git, env, repository, source_id, worktree, source_allowed_dirty_paths(source)
    )


def status_path(line: str) -> str:
    value = line[3:] if len(line) > 3 else line
    if " -> " in value:
        value = value.rsplit(" -> ", 1)[1]
    return value


def path_allowed_by(path: str, allowed_paths: Sequence[str]) -> bool:
    normalized_path = normalize_worktree_path(path)
    for allowed_path in allowed_paths:
        if normalized_path == allowed_path or normalized_path.startswith(
            allowed_path + "/"
        ):
            return True
    return False


def unexpected_dirty_lines(
    output: str, allowed_paths: Sequence[str], status: bool
) -> Sequence[str]:
    lines = []
    for line in output.splitlines():
        path = status_path(line) if status else line
        if not path_allowed_by(path, allowed_paths):
            lines.append(line)
    return lines


def check_worktree_pristine(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    worktree: str,
    allowed_dirty_paths: Sequence[str] = (),
) -> bool:
    status = run_captured_command(
        [git, "-C", worktree, "status", "--porcelain", "--untracked-files=all"],
        env,
        repository,
    )
    if status is None or status.returncode != 0:
        warn("unable to inspect source {0} worktree status".format(source_id))
        if status is not None:
            print_completed_output(status)
        return False
    ignored = run_captured_command(
        [
            git,
            "-C",
            worktree,
            "ls-files",
            "--others",
            "--ignored",
            "--exclude-standard",
        ],
        env,
        repository,
    )
    if ignored is None or ignored.returncode != 0:
        warn("unable to inspect source {0} ignored files".format(source_id))
        if ignored is not None:
            print_completed_output(ignored)
        return False

    dirty = []
    status_dirty = unexpected_dirty_lines(
        status.stdout, allowed_dirty_paths, status=True
    )
    ignored_dirty = unexpected_dirty_lines(
        ignored.stdout, allowed_dirty_paths, status=False
    )
    if status_dirty:
        dirty.append("\n".join(status_dirty))
    if ignored_dirty:
        dirty.append("\n".join(ignored_dirty))
    if dirty:
        warn(
            "source {0} worktree is not pristine:\n{1}".format(
                source_id, "\n".join(dirty)
            )
        )
        return False
    return True


def worktree_record(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    worktree: str,
) -> Optional[list[str]]:
    completed = run_captured_command(
        git_dir_command(git, git_dir, ["worktree", "list", "--porcelain"]),
        env,
        repository,
    )
    if completed is None or completed.returncode != 0:
        if completed is not None:
            print_completed_output(completed)
        return None
    worktree_realpath = os.path.realpath(worktree)
    records = completed.stdout.split("\n\n")
    for record in records:
        lines = record.splitlines()
        if not lines or not lines[0].startswith("worktree "):
            continue
        listed_worktree = lines[0][len("worktree ") :]
        if listed_worktree == worktree:
            return lines
        if os.path.realpath(listed_worktree) == worktree_realpath:
            return lines
    return []


def worktree_is_locked(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    worktree: str,
) -> bool:
    lines = worktree_record(git, env, repository, git_dir, worktree)
    if lines is None:
        return False
    return any(line == "locked" or line.startswith("locked ") for line in lines)


def remove_missing_worktree_registration(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    worktree: str,
) -> bool:
    lines = worktree_record(git, env, repository, git_dir, worktree)
    if lines is None or not lines:
        return True
    return run_logged_command(
        git_dir_command(
            git, git_dir, ["worktree", "remove", "--force", "--force", worktree]
        ),
        env,
        repository,
        show_success_output_on_stderr=False,
    )


def materialize_git_sources(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    git = resolve_required("git", env)
    if git is None:
        return False
    ok = True
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        warn("lockfile sources must be an object")
        return False
    for source_id, source_value in sources.items():
        if not valid_source_id(source_id):
            warn("invalid source id: {0}".format(source_id))
            ok = False
            continue
        if not isinstance(source_value, dict):
            warn("source {0} must be an object".format(source_id))
            ok = False
            continue
        if not validate_source_settings(source_id, source_value):
            ok = False
            continue
        git_dir = source_repository_path(repository, lock, source_id, source_value)
        worktree = source_worktree_path(repository, lock, source_id, source_value)
        if git_dir is None or worktree is None:
            ok = False
            continue
        if not ensure_bare_repository(
            git, env, repository, source_id, source_value, git_dir
        ):
            ok = False
            continue
        if not fetch_source_commit(
            git, env, repository, source_id, source_value, git_dir
        ):
            ok = False
            continue
        if not ensure_worktree(
            git, env, repository, source_id, source_value, git_dir, worktree
        ):
            ok = False
    return ok


def check_worktree_sparse_checkout(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    worktree: str,
) -> bool:
    expected = source_sparse_checkout_paths(source, source_id)
    if expected == []:
        return False

    enabled = worktree_sparse_checkout_enabled(git, env, repository, worktree)
    if enabled is None:
        warn("unable to inspect source {0} sparse checkout state".format(source_id))
        return False
    if expected is None:
        if enabled:
            warn("source {0} sparse checkout is enabled unexpectedly".format(source_id))
            return False
        return True
    if not enabled:
        warn("source {0} sparse checkout is not enabled".format(source_id))
        return False
    actual = worktree_sparse_checkout_list(git, env, repository, worktree)
    if actual is None:
        warn("unable to inspect source {0} sparse checkout paths".format(source_id))
        return False
    if list(actual) != list(expected):
        warn(
            "source {0} sparse checkout mismatch: expected {1}, found {2}".format(
                source_id,
                ", ".join(expected),
                ", ".join(actual),
            )
        )
        return False
    return True


def check_git_sources(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    git = resolve_required("git", env)
    if git is None:
        return False
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        warn("lockfile sources must be an object")
        return False
    ok = True
    for source_id, source_value in sources.items():
        if not valid_source_id(source_id) or not isinstance(source_value, dict):
            warn("invalid source entry in lockfile")
            ok = False
            continue
        if not validate_source_settings(source_id, source_value):
            ok = False
            continue
        git_dir = source_repository_path(repository, lock, source_id, source_value)
        worktree = source_worktree_path(repository, lock, source_id, source_value)
        commit = source_value.get("commit")
        if git_dir is None or worktree is None or not isinstance(commit, str):
            ok = False
            continue
        if not os.path.isdir(git_dir):
            warn(
                "source {0} repository not found; run ./manage install".format(
                    source_id
                )
            )
            ok = False
            continue
        url = source_value.get("url")
        if not isinstance(url, str) or not url:
            warn("source {0} url must be a non-empty string".format(source_id))
            ok = False
            continue
        remote = source_remote(source_value)
        completed = run_captured_command(
            git_dir_command(git, git_dir, ["remote", "get-url", remote]),
            env,
            repository,
        )
        if completed is None or completed.returncode != 0:
            warn(
                "unable to inspect remote {0} for source {1}".format(remote, source_id)
            )
            if completed is not None:
                print_completed_output(completed)
            ok = False
            continue
        current_url = completed.stdout.strip()
        if current_url != url:
            warn(
                "source {0} remote {1} mismatch: expected {2}, found {3}".format(
                    source_id, remote, url, current_url
                )
            )
            ok = False
        if not commit_available(git, env, repository, git_dir, commit):
            warn(
                "source {0} commit is not available in bare repository: {1}".format(
                    source_id, commit
                )
            )
            ok = False
        if not os.path.exists(worktree):
            warn(
                "source {0} worktree not found; run ./manage install".format(source_id)
            )
            ok = False
            continue
        if not is_git_worktree(worktree):
            warn(
                "source {0} worktree exists but is not a Git worktree: {1}".format(
                    source_id, worktree
                )
            )
            ok = False
            continue
        head = worktree_head(git, env, repository, worktree)
        if head != commit:
            warn(
                "source {0} HEAD mismatch: expected {1}, found {2}".format(
                    source_id, commit, head
                )
            )
            ok = False
        if source_locked(source_value) and not worktree_is_locked(
            git, env, repository, git_dir, worktree
        ):
            warn("source {0} worktree is not locked".format(source_id))
            ok = False
        if not check_worktree_sparse_checkout(
            git, env, repository, source_id, source_value, worktree
        ):
            ok = False
        if not check_worktree_pristine(
            git,
            env,
            repository,
            source_id,
            worktree,
            source_allowed_dirty_paths(source_value),
        ):
            ok = False
    return ok


def parse_version_tuple(text: str) -> Optional[tuple[int, int, int]]:
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    if not match:
        return None
    return (int(match.group(1)), int(match.group(2)), int(match.group(3)))


def check_tree_sitter_cli(
    env: Mapping[str, str], repository: str, minimum: tuple[int, int, int]
) -> bool:
    tree_sitter = resolve_required("tree-sitter", env)
    if tree_sitter is None:
        return False
    completed = run_captured_command([tree_sitter, "--version"], env, repository)
    if completed is None or completed.returncode != 0:
        warn("unable to query tree-sitter version")
        if completed is not None:
            print_completed_output(completed)
        return False
    version = parse_version_tuple(completed.stdout)
    if version is None or version < minimum:
        warn(
            "tree-sitter-cli >= {0} is required; found {1}".format(
                ".".join(str(part) for part in minimum), completed.stdout.strip()
            )
        )
        return False
    return True


def parser_extension() -> str:
    return ".so"


def treesitter_languages(lock: JSONMapping) -> Dict[str, JSONObject]:
    languages: Dict[str, JSONObject] = {}
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        return languages
    for source_id, source_value in sources.items():
        if not isinstance(source_id, str) or not isinstance(source_value, dict):
            continue
        treesitter = source_treesitter(source_value)
        parsers = treesitter.get("parsers", {})
        if not isinstance(parsers, dict):
            continue
        for language, parser_data in parsers.items():
            if isinstance(language, str) and isinstance(parser_data, dict):
                data = dict(parser_data)
                data["source"] = source_id
                languages[language] = data
    return languages


def tree_sitter_runtime_site(repository: str, lock: JSONMapping) -> Optional[str]:
    treesitter = root_treesitter_metadata(lock)
    runtime_site_value = treesitter.get("runtimeSite", TREE_SITTER_RUNTIME_SITE)
    if not isinstance(runtime_site_value, str):
        warn("treesitter.runtimeSite must be a string")
        return None
    return repository_path(repository, runtime_site_value)


def source_worktree_by_id(
    repository: str, lock: JSONMapping, source_id: str
) -> Optional[str]:
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        return None
    source = sources.get(source_id)
    if not isinstance(source, dict):
        warn("unknown source id: {0}".format(source_id))
        return None
    return source_worktree_path(repository, lock, source_id, source)


def source_commit_by_id(lock: JSONMapping, source_id: str) -> Optional[str]:
    sources = lock.get("sources", {})
    if not isinstance(sources, dict):
        return None
    source = sources.get(source_id)
    if not isinstance(source, dict):
        return None
    commit = source.get("commit")
    return commit if isinstance(commit, str) else None


def treesitter_sources_root(repository: str, lock: JSONMapping) -> Optional[str]:
    runtime_site = tree_sitter_runtime_site(repository, lock)
    if runtime_site is None:
        return None
    return os.path.join(runtime_site, TREE_SITTER_RELEASED_SOURCES_DIR)


def treesitter_released_source_root_path(
    repository: str, lock: JSONMapping, source_id: str
) -> Optional[str]:
    root = treesitter_sources_root(repository, lock)
    if root is None:
        return None
    return os.path.join(root, source_id)


def treesitter_released_source_archive_path(
    repository: str, lock: JSONMapping, source_id: str
) -> Optional[str]:
    root = treesitter_released_source_root_path(repository, lock, source_id)
    if root is None:
