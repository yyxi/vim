def info(message: str) -> None:
    print(message, flush=True)


def warn(message: str) -> None:
    print("warning: {0}".format(message), file=sys.stderr)


def home_dir() -> str:
    home = os.environ.get("HOME") or os.path.expanduser("~")
    if not home or home == "~":
        raise RuntimeError("unable to determine HOME")
    return home


def repository_dir() -> str:
    return os.path.dirname(os.path.realpath(__file__))


def local_bin_directories(home: str) -> Sequence[str]:
    return [os.path.join(home, *parts) for parts in LOCAL_BIN_PARTS]


def prepend_existing_directories(path: str, directories: Sequence[str]) -> str:
    entries = [directory for directory in directories if os.path.isdir(directory)]
    if path:
        entries.append(path)
    return os.pathsep.join(entries)


def install_environment(home: str) -> Dict[str, str]:
    env = os.environ.copy()
    env["PATH"] = prepend_existing_directories(
        env.get("PATH", ""), local_bin_directories(home)
    )
    return env


def run_logged_probe(
    command: Sequence[str], env: Mapping[str, str], repository: str
) -> Optional[int]:
    print_command(command)
    completed = run_captured_command(command, env, repository)
    return completed.returncode if completed is not None else None


def uv_environment_synced(
    uv: str, env: Mapping[str, str], repository: str, include_dev: bool
) -> bool:
    command = [uv] + list(UV_SYNC_CHECK)
    if not include_dev:
        command.append("--no-dev")

    return run_logged_probe(command, env, repository) == 0


def sync_uv_production_if_needed(env: Mapping[str, str], repository: str) -> bool:
    uv = shutil.which("uv", path=env.get("PATH"))
    if not uv:
        return True

    if not os.path.exists(os.path.join(repository, "pyproject.toml")):
        return True

    if uv_environment_synced(uv, env, repository, include_dev=False):
        return True

    # A dev-synced environment is already usable; avoid removing dev tools unnecessarily.
    if uv_environment_synced(uv, env, repository, include_dev=True):
        return True

    return run_logged_command([uv, *UV_SYNC_PRODUCTION], env, repository)


def sync_pnpm_production(env: Mapping[str, str], repository: str) -> bool:
    pnpm = shutil.which("pnpm", path=env.get("PATH"))
    if not pnpm:
        return True

    if not os.path.exists(os.path.join(repository, "package.json")):
        return True

    # Let pnpm remain the single source of truth for production dependency state.
    return run_logged_command([pnpm, *PNPM_INSTALL_PRODUCTION], env, repository)


def neovim_config_path(home: str) -> str:
    return os.path.join(home, ".config", "nvim")


def check_neovim_config_link(
    home: str, repository: str, emit_warnings: bool = True
) -> bool:
    nvim_config = neovim_config_path(home)
    if not os.path.lexists(nvim_config):
        if emit_warnings:
            warn("{0} is missing; run ./manage install".format(nvim_config))
        return False
    try:
        if os.path.realpath(nvim_config) == os.path.realpath(repository):
            return True
    except OSError as exc:
        if emit_warnings:
            warn("unable to inspect {0}: {1}".format(nvim_config, exc))
        return False
    if emit_warnings:
        warn("{0} exists and does not point to {1}".format(nvim_config, repository))
    return False


def link_neovim_config(home: str, repository: str) -> bool:
    config_dir = os.path.join(home, ".config")
    try:
        os.makedirs(config_dir, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(config_dir, exc))
        return False

    if check_neovim_config_link(home, repository, emit_warnings=False):
        return True

    nvim_config = neovim_config_path(home)
    if os.path.lexists(nvim_config):
        return check_neovim_config_link(home, repository, emit_warnings=True)

    try:
        os.symlink(repository, nvim_config)
    except FileExistsError:
        return os.path.realpath(nvim_config) == os.path.realpath(repository)
    except OSError as exc:
        warn("unable to link {0} to {1}: {2}".format(nvim_config, repository, exc))
        return False

    return True


def run_captured_command(
    command: Sequence[str], env: Mapping[str, str], repository: str
) -> Optional[subprocess.CompletedProcess[str]]:
    try:
        return subprocess.run(
            command,
            env=env,
            cwd=repository,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        warn("unable to run {0}: {1}".format(command[0], exc))
        return None


def download_retry_delay(headers: object, body: str, attempt: int) -> Optional[int]:
    get = getattr(headers, "get", None)
    if not callable(get):
        return None

    retry_after = get("Retry-After")
    if isinstance(retry_after, str) and retry_after.isdigit():
        return max(1, int(retry_after))

    reset = get("X-RateLimit-Reset")
    remaining = get("X-RateLimit-Remaining")
    rate_limited = remaining == "0" or "rate limit" in body.lower()
    if isinstance(reset, str) and reset.isdigit() and rate_limited:
        return max(1, int(reset) - int(time.time()) + 2)
    if rate_limited:
        return min(60, 5 * (2**attempt))
    return None


def urlopen_with_retries(request: urllib.request.Request, timeout: int, purpose: str):
    max_attempts = 4
    for attempt in range(max_attempts):
        try:
            return urllib.request.urlopen(request, timeout=timeout)
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", errors="replace")
            delay = download_retry_delay(exc.headers, body, attempt)
            if (
                exc.code in (403, 429)
                and delay is not None
                and attempt < max_attempts - 1
            ):
                if delay > MAX_AUTOMATIC_DOWNLOAD_RETRY_DELAY_SECONDS:
                    warn(
                        "{0} is rate-limited for {1} seconds; try again after the reset".format(
                            purpose, delay
                        )
                    )
                    return None
                warn(
                    "{0} is rate-limited; waiting {1} seconds before retrying".format(
                        purpose, delay
                    )
                )
                time.sleep(delay)
                continue
            warn(
                "{0} failed for {1}: HTTP {2}: {3}".format(
                    purpose, request.full_url, exc.code, body
                )
            )
            return None
        except OSError as exc:
            if attempt < max_attempts - 1:
                delay = min(30, 2 * (attempt + 1))
                warn(
                    "{0} failed for {1}: {2}; retrying in {3} seconds".format(
                        purpose, request.full_url, exc, delay
                    )
                )
                time.sleep(delay)
                continue
            warn("{0} failed for {1}: {2}".format(purpose, request.full_url, exc))
            return None
    warn("{0} failed for {1}".format(purpose, request.full_url))
    return None


def download_url(url: str, destination: str) -> bool:
    request = urllib.request.Request(url, headers={"User-Agent": DOWNLOAD_USER_AGENT})
    response = urlopen_with_retries(request, timeout=60, purpose="download")
    if response is None:
        return False
    try:
        with response:
            with open(destination, "wb") as output:
                shutil.copyfileobj(response, output)
    except OSError as exc:
        warn("unable to write {0}: {1}".format(destination, exc))
        return False
    return True


def path_within_repository(repository: str, path: str) -> bool:
    try:
        repository_realpath = os.path.realpath(repository)
        path_realpath = os.path.realpath(path)
        common = os.path.commonpath([repository_realpath, path_realpath])
    except ValueError:
        return False
    return common == repository_realpath


