# Mechanisms
# ==========
# Packages; paths/manifest; Git; Tree-sitter; schemas; orchestration/export;
# native builds; development checks/scan. No source-name dispatch below.


def info(message: str) -> None:
    print(message, flush=True)


def warn(message: str) -> None:
    print("warning: {0}".format(message), file=sys.stderr)


def home_dir() -> str:
    home = os.environ.get("HOME") or os.path.expanduser("~")
    if not home or home == "~":
        raise RuntimeError("unable to determine HOME")
    return home


def repository_dir() -> str:
    return os.path.dirname(os.path.realpath(__file__))


def local_bin_directories(home: str) -> Sequence[str]:
    return [os.path.join(home, *parts) for parts in LOCAL_BIN_PARTS]


def prepend_existing_directories(path: str, directories: Sequence[str]) -> str:
    entries = [directory for directory in directories if os.path.isdir(directory)]
    if path:
        entries.append(path)
    return os.pathsep.join(entries)


def install_environment(home: str) -> Dict[str, str]:
    env = os.environ.copy()
    env["PATH"] = prepend_existing_directories(
        env.get("PATH", ""), local_bin_directories(home)
    )
    return env


def run_logged_probe(
    command: Sequence[str], env: Mapping[str, str], repository: str
) -> Optional[int]:
    print_command(command)
    completed = run_captured_command(command, env, repository)
    return completed.returncode if completed is not None else None


def uv_environment_synced(
    uv: str, env: Mapping[str, str], repository: str, include_dev: bool
) -> bool:
    command = [uv] + list(UV_SYNC_CHECK)
    if not include_dev:
        command.append("--no-dev")

    return run_logged_probe(command, env, repository) == 0


def sync_uv_production_if_needed(env: Mapping[str, str], repository: str) -> bool:
    if not os.path.exists(os.path.join(repository, "pyproject.toml")):
        return True
    current = python_state_ok(env, repository, False)
    cache = python_cache_state(repository) if current else None
    minor = str(sys.version_info.major) + "." + str(sys.version_info.minor)
    if (
        current
        and cache is not None
        and minor in cast(list[JSONValue], cache.get("pythonMinors", []))
    ):
        return True
    uv = resolve_required("uv", env)
    if uv is None:
        return current
    if not current:
        production = uv_environment_synced(uv, env, repository, include_dev=False)
        development = (
            False
            if production
            else uv_environment_synced(uv, env, repository, include_dev=True)
        )
        files = python_environment_inventory(repository)
        if not production and not development:
            if not run_logged_command([uv, *UV_SYNC_PRODUCTION], env, repository):
                return False
        elif files is None:
            # Re-materialize unsafe cache symlinks, preserving a dev-synced graph.
            command = [uv, "sync", "--locked", "--link-mode=clone", "--reinstall"]
            if not development:
                command.append("--no-dev")
            if not run_logged_command(command, env, repository):
                return False
    if not prepare_python_cache(uv, env, repository):
        return False
    cache = python_cache_state(repository)
    if cache is None or not stamp_python_environment(
        env, repository, str(cache["requirements"])
    ):
        return False
    return python_state_ok(env, repository)


def component_inputs(repository: str, names: Sequence[str]) -> Optional[JSONObject]:
    return output_hashes(repository, names)


def read_component_state(path: str, version: int) -> Optional[JSONObject]:
    """Read regular owned metadata of the expected component schema."""
    if os.path.islink(path) or not os.path.isfile(path):
        return None
    state = read_json_object_file(path, False)
    if (
        state is None
        or type(state.get("version")) is not int
        or state["version"] != version
    ):
        return None
    return state


def write_component_state(path: str, state: JSONMapping) -> bool:
    temporary = None
    try:
        fd, temporary = tempfile.mkstemp(
            prefix=os.path.basename(path) + ".tmp-",
            dir=os.path.dirname(os.path.abspath(path)),
        )
        with os.fdopen(fd, "w", encoding="utf-8") as file:
            json.dump(state, file, sort_keys=True, indent=2)
            file.write("\n")
        os.replace(temporary, path)
        return True
    except OSError as exc:
        warn("unable to publish component metadata: " + str(exc))
        if temporary is not None and not remove_path(temporary):
            warn("component metadata scratch retained: " + temporary)
        return False


def raise_walk_error(error: OSError) -> None:
    raise error


def package_inventory(root: str, exclude: Sequence[str] = ()) -> Optional[JSONObject]:
    """Record bytes/modes and contained links, without following linked trees."""
    result: JSONObject = {}
    try:
        if not os.path.isdir(root) or os.path.islink(root):
            return None
        for directory, children, files in os.walk(
            root, followlinks=False, onerror=raise_walk_error
        ):
            children[:] = [name for name in children if name != "__pycache__"]
            for name in children + files:
                path = os.path.join(directory, name)
                relative = os.path.relpath(path, root).replace(os.sep, "/")
                if relative in exclude or name.endswith(".pyc"):
                    continue
                if os.path.islink(path):
                    target = os.path.realpath(path)
                    if not os.path.exists(target) or not path_within_repository(
                        root, target
                    ):
                        warn("escaping/broken package link: " + path)
                        return None
                    result[relative] = {"link": os.readlink(path)}
                elif os.path.isfile(path):
                    digest = sha256_file(path)
                    if digest is None:
                        return None
                    result[relative] = {
                        "sha256": digest,
                        "executable": bool(os.stat(path).st_mode & 0o111),
                    }
                elif not os.path.isdir(path):
                    warn("unexpected package entry: " + path)
                    return None
        return result
    except OSError as exc:
        warn("unable to inspect package inventory: " + str(exc))
        return None


def node_runtime_ok(env: Mapping[str, str], repository: str) -> bool:
    node = resolve_required("node", env)
    if node is None:
        return False
    result = run_captured_command([node, "--version"], env, repository)
    version = parse_version_tuple(result.stdout) if result is not None else None
    if (
        result is None
        or result.returncode != 0
        or version is None
        or version < NODE_MINIMUM_VERSION
    ):
        warn(
            "locked Node production packages require Node >="
            + ".".join(map(str, NODE_MINIMUM_VERSION))
        )
        return False
    return True


def node_state_ok(
    env: Mapping[str, str], repository: str, emit_warnings: bool = True
) -> bool:
    if not os.path.isfile(os.path.join(repository, "package.json")):
        return True
    root = os.path.join(repository, "node_modules")
    state = read_component_state(
        os.path.join(root, COMPONENT_STATE_NAME), NODE_STATE_VERSION
    )
    if state is None:
        if emit_warnings:
            warn(
                "Node production metadata missing/stale; run ./manage install with pnpm"
            )
        return False
    inputs = component_inputs(repository, NODE_PACKAGE_INPUTS)
    inventory = package_inventory(root, (COMPONENT_STATE_NAME,))
    built = state.get("platform")
    valid = (
        inputs is not None
        and bool(inventory)
        and state.get("inputs") == inputs
        and state.get("inventory") == inventory
        and isinstance(built, dict)
        and platform_state_ok(built)
    )
    if not valid:
        if emit_warnings:
            warn(
                "Node production state missing/stale/corrupt; run ./manage install with pnpm"
            )
        return False
    return node_runtime_ok(env, repository)


def sync_pnpm_production(env: Mapping[str, str], repository: str) -> bool:
    if not os.path.exists(os.path.join(repository, "package.json")):
        return True
    if node_state_ok(env, repository, False):
        return True
    pnpm = resolve_required("pnpm", env)
    if pnpm is None or not node_runtime_ok(env, repository):
        return False
    inputs = component_inputs(repository, NODE_PACKAGE_INPUTS)
    if inputs is None:
        return False
    root = os.path.join(repository, "node_modules")
    state_path = os.path.join(root, COMPONENT_STATE_NAME)
    if os.path.islink(root):
        warn("refusing conflicting Node component link: " + root)
        return False
    old = read_component_state(state_path, NODE_STATE_VERSION)
    # A known owned component may be reconstructed by pnpm. Never edit its
    # internal store metadata or delete an unknown/conflicting directory.
    backup = None
    if old is not None:
        backup = root + ".backup-" + str(time.time_ns())
        try:
            os.rename(root, backup)
        except OSError as exc:
            warn("unable to back up Node component: " + str(exc))
            return False
    success = False
    try:
        if not run_logged_command([pnpm, *PNPM_INSTALL_PRODUCTION], env, repository):
            return False
        inventory = package_inventory(root, (COMPONENT_STATE_NAME,))
        if not inventory or component_inputs(repository, NODE_PACKAGE_INPUTS) != inputs:
            warn("pnpm produced invalid state or changed frozen inputs")
            return False
        for name, *arguments in NODE_RUNTIME_PROBES:
            if not run_logged_command(
                [os.path.join(root, ".bin", name), *arguments], env, repository
            ):
                warn("required Node runtime command is unavailable: " + name)
                return False
        state: JSONObject = {
            "version": NODE_STATE_VERSION,
            "inputs": inputs,
            "inventory": inventory,
            "platform": dict(
                current_platform_signature(), requirements=runtime_requirements()
            ),
        }
        success = write_component_state(state_path, state) and node_state_ok(
            env, repository
        )
        if success and backup is not None and not remove_path(backup):
            warn("Node backup retained: " + backup)
            return False
        return success
    finally:
        if backup is not None and not success:
            if not remove_path(root):
                warn("failed Node tree retained; recovery remains at " + backup)
            else:
                try:
                    os.rename(backup, root)
                except OSError as exc:
                    warn("Node recovery failed: " + str(exc) + "; retained: " + backup)


def python_package_environment(
    env: Mapping[str, str], bootstrap: Optional[str] = None
) -> Dict[str, str]:
    result = {
        k: v for k, v in env.items() if not k.startswith(("PIP_", "PYTHON", "UV_"))
    }
    result.update(
        PIP_CONFIG_FILE=os.devnull, PYTHONNOUSERSITE="1", PYTHONDONTWRITEBYTECODE="1"
    )
    if bootstrap is not None:
        result["PYTHONPATH"] = bootstrap
    return result


def python_driver() -> str:
    return os.path.realpath(str(getattr(sys, "_base_executable", sys.executable)))


def python_runtime_identity(
    python: str, env: Mapping[str, str], repository: str
) -> Optional[JSONObject]:
    result = run_captured_command(
        [
            python,
            "-I",
            "-S",
            "-c",
            "import json,sys,sysconfig,platform; print(json.dumps({'minor':str(sys.version_info.major)+'.'+str(sys.version_info.minor),'implementation':platform.python_implementation(),'abi':sysconfig.get_config_var('SOABI')}))",
        ],
        python_package_environment(env),
        repository,
    )
    if result is None or result.returncode != 0:
        return None
    try:
        value = json.loads(result.stdout)
        if (
            not isinstance(value, dict)
            or value.get("implementation") != "CPython"
            or value.get("minor") not in PYTHON_SUPPORTED_MINORS
            or "t-" in str(value.get("abi"))
        ):
            warn("Python production state requires " + PYTHON_RUNTIME_DESCRIPTION)
            return None
        return cast(JSONObject, value)
    except ValueError as exc:
        warn("invalid Python runtime identity: " + str(exc))
        return None


def production_requirements(text: str) -> Optional[Dict[str, set[str]]]:
    """Accept only uv's pinned, hashed registry interoperability format."""
    lines = "\n".join(
        line for line in text.splitlines() if not line.lstrip().startswith("#")
    )
    result: Dict[str, set[str]] = {}
    for line in lines.replace("\\\n", " ").splitlines():
        if not line.strip():
            continue
        match = re.fullmatch(
            r"\s*([A-Za-z0-9_.-]+)==[A-Za-z0-9_.!+-]+(?:\s*;\s*[A-Za-z0-9_'\" .!=<>():-]+?)?\s+((?:--hash=sha256:[a-f0-9]{64}\s*)+)\s*",
            line,
        )
        if match is None:
            warn("unsupported/unhashed production requirement: " + line[:160])
            return None
        name = re.sub(r"[-_.]+", "-", match[1]).lower()
        result.setdefault(name, set()).update(
            re.findall(r"--hash=sha256:([a-f0-9]{64})", match[2])
        )
    if not result or "pip" not in result:
        warn("production requirements must include the locked pip bootstrap")
        return None
    return result


def python_environment_inventory(repository: str) -> Optional[JSONObject]:
    root = os.path.join(repository, ".venv")
    if os.path.islink(root):
        return None
    configuration_path = os.path.join(root, "pyvenv.cfg")
    if not os.path.isfile(configuration_path) or os.path.islink(configuration_path):
        return None
    configuration = sha256_file(configuration_path)
    if configuration is None:
        return None
    result: JSONObject = {"configuration": configuration}
    lib = os.path.join(root, "lib")
    if not path_within_repository(root, lib):
        return None
    try:
        sites = [
            os.path.join(lib, name, "site-packages")
            for name in os.listdir(lib)
            if name.startswith("python")
        ]
        if len(sites) != 1 or not path_within_repository(root, sites[0]):
            return None
        inventory = package_inventory(sites[0])
        if inventory is None or not inventory:
            return None
        result["packages"] = inventory
        bin_dir = os.path.join(root, "bin")
        if not path_within_repository(root, bin_dir):
            return None
        scripts: JSONObject = {}
        interpreter = os.path.realpath(os.path.join(bin_dir, "python"))
        for name in os.listdir(bin_dir):
            if name.startswith(("activate", "Activate")):
                continue
            path = os.path.join(bin_dir, name)
            if os.path.islink(path):
                # CPython 3.14 also creates a Unicode 𝜋thon alias. Interpreter
                # aliases may reference the retained base runtime; packages
                # and entry-point scripts may not depend on external caches.
                if os.path.realpath(path) == interpreter:
                    continue
                return None
            if not os.path.isfile(path):
                return None
            digest = sha256_file(path)
            if digest is None:
                return None
            scripts[name] = {
                "sha256": digest,
                "executable": bool(os.stat(path).st_mode & 0o111),
            }
        result["scripts"] = scripts
        return result
    except OSError:
        return None


def stamp_python_environment(
    env: Mapping[str, str], repository: str, requirements: str
) -> bool:
    inputs = component_inputs(repository, PYTHON_PACKAGE_INPUTS)
    files = python_environment_inventory(repository)
    identity = python_runtime_identity(
        os.path.join(repository, ".venv", "bin", "python"), env, repository
    )
    if (
        inputs is None
        or files is None
        or identity is None
        or production_requirements(requirements) is None
    ):
        warn("cannot establish Python component state")
        return False
    # uv/pip own closure validation; this record binds their successful result
    # to declarations, runtime ABI, location-dependent launchers, and bytes.
    state: JSONObject = {
        "version": PYTHON_ENV_STATE_VERSION,
        "inputs": inputs,
        "requirements": requirements,
        "inventory": files,
        "runtime": identity,
        "root": os.path.realpath(os.path.join(repository, ".venv")),
        "platform": dict(
            current_platform_signature(), requirements=runtime_requirements()
        ),
    }
    return write_component_state(
        os.path.join(repository, ".venv", COMPONENT_STATE_NAME), state
    )


def python_state_ok(
    env: Mapping[str, str], repository: str, emit_warnings: bool = True
) -> bool:
    if not os.path.isfile(os.path.join(repository, "pyproject.toml")):
        return True
    root = os.path.join(repository, ".venv")
    state = read_component_state(
        os.path.join(root, COMPONENT_STATE_NAME), PYTHON_ENV_STATE_VERSION
    )
    if state is None:
        if emit_warnings:
            warn(
                "Python production metadata missing/stale; prepare with uv or local wheels"
            )
        return False
    inputs = component_inputs(repository, PYTHON_PACKAGE_INPUTS)
    inventory = python_environment_inventory(repository)
    built = state.get("platform")
    valid = (
        inputs is not None
        and state.get("inputs") == inputs
        and inventory is not None
        and state.get("inventory") == inventory
        and state.get("root") == os.path.realpath(root)
        and isinstance(built, dict)
        and platform_state_ok(built)
    )
    if not valid:
        if emit_warnings:
            warn(
                "Python production state missing/stale/corrupt; local wheels or online uv preparation required"
            )
        return False
    # Inspect the interpreter only after the owned package bytes pass checks.
    return python_runtime_identity(
        os.path.join(root, "bin", "python"), env, repository
    ) == state.get("runtime")


def python_cache_path(repository: str) -> str:
    return os.path.join(repository, "vendor", "python", "wheels")


def python_cache_state(repository: str) -> Optional[JSONObject]:
    root = python_cache_path(repository)
    state = read_component_state(
        os.path.join(root, "state.json"), PYTHON_WHEEL_STATE_VERSION
    )
    if state is None or state.get("inputs") != component_inputs(
        repository, PYTHON_PACKAGE_INPUTS
    ):
        return None
    minors = state.get("pythonMinors")
    if (
        not isinstance(minors, list)
        or not minors
        or any(
            not isinstance(minor, str) or minor not in PYTHON_SUPPORTED_MINORS
            for minor in minors
        )
    ):
        return None
    if (
        len(set(minors)) != len(minors)
        or repository_path(repository, "vendor/python/wheels") is None
        or os.path.islink(root)
    ):
        return None
    text = state.get("requirements")
    hashes = production_requirements(text) if isinstance(text, str) else None
    built = state.get("platform")
    files = state.get("wheels")
    if (
        hashes is None
        or not isinstance(built, dict)
        or not platform_state_ok(built)
        or not isinstance(files, dict)
        or not files
    ):
        return None
    allowed = set().union(*hashes.values())
    for name, digest in files.items():
        if (
            validated_relative_subpath(name) != name
            or "/" in name
            or not name.endswith(".whl")
            or not isinstance(digest, str)
            or digest not in allowed
        ):
            return None
        path = os.path.join(root, name)
        if os.path.islink(path) or not verify_file_sha256(path, digest):
            return None
    pip_wheels = [
        name
        for name, digest in files.items()
        if name.startswith("pip-") and digest in hashes["pip"]
    ]
    if len(pip_wheels) != 1:
        return None
    return state


def pip_bootstrap(root: str, state: JSONMapping, scratch: str) -> Optional[str]:
    files = state.get("wheels")
    requirements = state.get("requirements")
    if not isinstance(files, dict) or not isinstance(requirements, str):
        return None
    policy = production_requirements(requirements)
    if policy is None:
        return None
    candidates = [
        name
        for name, digest in files.items()
        if name.startswith("pip-") and digest in policy["pip"]
    ]
    if len(candidates) != 1:
        return None
    wheel = os.path.join(root, candidates[0])
    digest = files[candidates[0]]
    if not isinstance(digest, str) or not verify_file_sha256(wheel, digest):
        return None
    try:
        with zipfile.ZipFile(wheel) as archive:
            for entry in archive.infolist():
                name = entry.filename.rstrip("/")
                if validated_relative_subpath(name) != name or (
                    entry.external_attr >> 16
                ) & 0o170000 not in (0, 0o100000, 0o040000):
                    warn("invalid bootstrap wheel member: " + entry.filename)
                    return None
            archive.extractall(scratch)
        return scratch
    except (OSError, zipfile.BadZipFile) as exc:
        warn("invalid pip bootstrap: " + str(exc))
        return None


def prepare_python_cache(uv: str, env: Mapping[str, str], repository: str) -> bool:
    root = python_cache_path(repository)
    if not path_within_repository(repository, root) or os.path.islink(root):
        warn("refusing linked/escaping Python wheel cache: " + root)
        return False
    identity = python_runtime_identity(python_driver(), env, repository)
    inputs = component_inputs(repository, PYTHON_PACKAGE_INPUTS)
    if identity is None or inputs is None:
        return False
    old = python_cache_state(repository)
    if old is not None and identity["minor"] in cast(
        list[JSONValue], old.get("pythonMinors", [])
    ):
        return True
    try:
        os.makedirs(os.path.dirname(root), exist_ok=True)
        with tempfile.TemporaryDirectory(
            prefix="python-wheels-", dir=os.path.dirname(root)
        ) as temporary:
            staged = os.path.join(temporary, "wheels")
            os.mkdir(staged)
            requirements = os.path.join(temporary, "requirements.txt")
            if not run_logged_command(
                [
                    uv,
                    "export",
                    "--locked",
                    "--no-dev",
                    "--no-emit-project",
                    "--format",
                    "requirements.txt",
                    "--no-python-downloads",
                    "--output-file",
                    requirements,
                ],
                env,
                repository,
            ):
                return False
            exported = read_text_file(requirements)
            # uv's header embeds the disposable output path, not resolution.
            text = (
                "\n".join(
                    line
                    for line in exported.splitlines()
                    if not line.lstrip().startswith("#")
                ).strip()
                if exported is not None
                else None
            )
            policy = production_requirements(text) if text is not None else None
            if policy is None or text is None:
                return False
            # Read the existing locked pip artifact, not another resolution.
            with open(os.path.join(repository, "uv.lock"), "rb") as file:
                locked = tomllib.load(file)
            package = next(item for item in locked["package"] if item["name"] == "pip")
            wheel = next(
                item
                for item in package["wheels"]
                if item["url"].endswith("-py3-none-any.whl")
            )
            filename = str(wheel["url"]).rsplit("/", 1)[-1]
            digest = str(wheel["hash"]).removeprefix("sha256:")
            if (
                digest not in policy["pip"]
                or validated_relative_subpath(filename) != filename
            ):
                warn("locked pip artifact disagrees with uv export")
                return False
            destination = os.path.join(staged, filename)
            if not download_url(
                str(wheel["url"]), destination
            ) or not verify_file_sha256(destination, digest):
                return False
            bootstrap_state: JSONObject = {
                "requirements": text,
                "wheels": {filename: digest},
            }
            bootstrap = pip_bootstrap(
                staged, bootstrap_state, os.path.join(temporary, "bootstrap")
            )
            if bootstrap is None:
                return False
            if not run_logged_command(
                [
                    python_driver(),
                    "-m",
                    "pip",
                    "download",
                    "--require-hashes",
                    "--only-binary=:all:",
                    "--no-deps",
                    "--no-cache-dir",
                    "-r",
                    requirements,
                    "-d",
                    staged,
                ],
                python_package_environment(env, bootstrap),
                repository,
            ):
                return False
            if old is not None and old.get("requirements") == text:
                for name in cast(dict[str, JSONValue], old["wheels"]):
                    if not os.path.exists(os.path.join(staged, name)):
                        shutil.copy2(
                            os.path.join(root, name), os.path.join(staged, name)
                        )
            names = os.listdir(staged)
            hashes = output_hashes(staged, names)
            allowed = set().union(*policy.values())
            if hashes is None or any(
                not name.endswith(".whl") or digest not in allowed
                for name, digest in hashes.items()
            ):
                warn("pip downloaded unexpected or unhashed files")
                return False
            minors = (
                cast(list[JSONValue], old.get("pythonMinors", []))
                if old is not None and old.get("requirements") == text
                else []
            )
            state: JSONObject = {
                "version": PYTHON_WHEEL_STATE_VERSION,
                "inputs": inputs,
                "requirements": text,
                "wheels": hashes,
                "pythonMinors": sorted(
                    set(cast(list[str], minors)) | {str(identity["minor"])}
                ),
                "platform": dict(
                    current_platform_signature(), requirements=runtime_requirements()
                ),
            }
            if component_inputs(
                repository, PYTHON_PACKAGE_INPUTS
            ) != inputs or not write_component_state(
                os.path.join(staged, "state.json"), state
            ):
                return False
            return replace_directory(root, staged)
    except (OSError, ValueError, KeyError, StopIteration) as exc:
        warn("unable to prepare locked Python wheels: " + str(exc))
        return False


def complete_python_offline(env: Mapping[str, str], repository: str) -> bool:
    if python_state_ok(env, repository, False):
        return True
    cache = python_cache_state(repository)
    if cache is None:
        warn("no valid Python environment or lock-bound local wheel cache")
        return False
    root = os.path.join(repository, ".venv")
    if os.path.lexists(root) and (
        os.path.islink(root)
        or read_component_state(
            os.path.join(root, COMPONENT_STATE_NAME), PYTHON_ENV_STATE_VERSION
        )
        is None
    ):
        warn("refusing to replace unknown Python environment: " + root)
        return False
    backup = None
    success = False
    fresh_owned = False
    try:
        if os.path.lexists(root):
            candidate = root + ".backup-" + str(time.time_ns())
            os.rename(root, candidate)
            backup = candidate
        fresh_owned = True
        with tempfile.TemporaryDirectory(prefix="python-bootstrap-") as temporary:
            bootstrap = pip_bootstrap(
                python_cache_path(repository), cache, os.path.join(temporary, "pip")
            )
            if (
                bootstrap is None
                or python_runtime_identity(python_driver(), env, repository) is None
            ):
                return False
            if not run_logged_command(
                [python_driver(), "-m", "venv", "--without-pip", root],
                python_package_environment(env),
                repository,
            ):
                return False
            requirements = os.path.join(temporary, "requirements.txt")
            with open(requirements, "w", encoding="utf-8") as file:
                file.write(str(cache["requirements"]))
            python = os.path.join(root, "bin", "python")
            if not run_logged_command(
                [
                    python_driver(),
                    "-m",
                    "pip",
                    "--python",
                    python,
                    "install",
                    "--ignore-installed",
                    "--no-index",
                    "--find-links",
                    python_cache_path(repository),
                    "--require-hashes",
                    "--only-binary=:all:",
                    "--no-deps",
                    "--no-cache-dir",
                    "-r",
                    requirements,
                ],
                python_package_environment(env, bootstrap),
                repository,
            ):
                return False
            if not run_logged_command(
                [python, "-m", "pip", "check"],
                python_package_environment(env),
                repository,
            ):
                return False
            success = stamp_python_environment(
                env, repository, str(cache["requirements"])
            ) and python_state_ok(env, repository)
            if success and backup is not None and not remove_path(backup):
                warn("Python recovery backup retained: " + backup)
                return False
            return success
    except OSError as exc:
        warn("Python reconstruction failed: " + str(exc))
        return False
    finally:
        if not success and fresh_owned:
            if not remove_path(root):
                warn("failed Python environment retained: " + root)
            if backup is not None:
                try:
                    os.rename(backup, root)
                except OSError as exc:
                    warn(
                        "Python recovery failed: " + str(exc) + "; retained: " + backup
                    )


def neovim_config_path(home: str) -> str:
    return os.path.join(home, ".config", "nvim")


def check_neovim_config_link(
    home: str, repository: str, emit_warnings: bool = True
) -> bool:
    nvim_config = neovim_config_path(home)
    if not os.path.lexists(nvim_config):
        if emit_warnings:
            warn("{0} is missing; run ./manage install".format(nvim_config))
        return False
    try:
        if os.path.realpath(nvim_config) == os.path.realpath(repository):
            return True
    except OSError as exc:
        if emit_warnings:
            warn("unable to inspect {0}: {1}".format(nvim_config, exc))
        return False
    if emit_warnings:
        warn("{0} exists and does not point to {1}".format(nvim_config, repository))
    return False


def link_neovim_config(home: str, repository: str) -> bool:
    config_dir = os.path.join(home, ".config")
    try:
        os.makedirs(config_dir, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(config_dir, exc))
        return False

    if check_neovim_config_link(home, repository, emit_warnings=False):
        return True

    nvim_config = neovim_config_path(home)
    if os.path.lexists(nvim_config):
        return check_neovim_config_link(home, repository, emit_warnings=True)

    try:
        os.symlink(repository, nvim_config)
    except FileExistsError:
        return os.path.realpath(nvim_config) == os.path.realpath(repository)
    except OSError as exc:
        warn("unable to link {0} to {1}: {2}".format(nvim_config, repository, exc))
        return False

    return True


def run_captured_command(
    command: Sequence[str], env: Mapping[str, str], repository: str
) -> Optional[subprocess.CompletedProcess[str]]:
    try:
        return subprocess.run(
            command,
            env=env,
            cwd=repository,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
    except OSError as exc:
        warn("unable to run {0}: {1}".format(command[0], exc))
        return None


def download_retry_delay(headers: object, body: str, attempt: int) -> Optional[int]:
    get = getattr(headers, "get", None)
    if not callable(get):
        return None

    retry_after = get("Retry-After")
    if isinstance(retry_after, str) and retry_after.isdigit():
        return max(1, int(retry_after))

    reset = get("X-RateLimit-Reset")
    remaining = get("X-RateLimit-Remaining")
    rate_limited = remaining == "0" or "rate limit" in body.lower()
    if isinstance(reset, str) and reset.isdigit() and rate_limited:
        return max(1, int(reset) - int(time.time()) + 2)
    if rate_limited:
        return min(60, 5 * (2**attempt))
    return None


def urlopen_with_retries(request: urllib.request.Request, timeout: int, purpose: str):
    max_attempts = DOWNLOAD_MAX_ATTEMPTS
    for attempt in range(max_attempts):
        try:
            return urllib.request.urlopen(request, timeout=timeout)
        except urllib.error.HTTPError as exc:
            body = exc.read().decode("utf-8", errors="replace")
            delay = download_retry_delay(exc.headers, body, attempt)
            if (
                exc.code in (403, 429)
                and delay is not None
                and attempt < max_attempts - 1
            ):
                if delay > MAX_AUTOMATIC_DOWNLOAD_RETRY_DELAY_SECONDS:
                    warn(
                        "{0} is rate-limited for {1} seconds; try again after the reset".format(
                            purpose, delay
                        )
                    )
                    return None
                warn(
                    "{0} is rate-limited; waiting {1} seconds before retrying".format(
                        purpose, delay
                    )
                )
                time.sleep(delay)
                continue
            warn(
                "{0} failed for {1}: HTTP {2}: {3}".format(
                    purpose, request.full_url, exc.code, body
                )
            )
            return None
        except OSError as exc:
            if attempt < max_attempts - 1:
                delay = min(30, 2 * (attempt + 1))
                warn(
                    "{0} failed for {1}: {2}; retrying in {3} seconds".format(
                        purpose, request.full_url, exc, delay
                    )
                )
                time.sleep(delay)
                continue
            warn("{0} failed for {1}: {2}".format(purpose, request.full_url, exc))
            return None
    warn("{0} failed for {1}".format(purpose, request.full_url))
    return None


def download_url(url: str, destination: str) -> bool:
    request = urllib.request.Request(url, headers={"User-Agent": DOWNLOAD_USER_AGENT})
    response = urlopen_with_retries(
        request, timeout=DOWNLOAD_TIMEOUT_SECONDS, purpose="download"
    )
    if response is None:
        return False
    try:
        with response:
            with open(destination, "wb") as output:
                shutil.copyfileobj(response, output)
    except OSError as exc:
        warn("unable to write {0}: {1}".format(destination, exc))
        return False
    return True


def path_within_repository(repository: str, path: str) -> bool:
    try:
        repository_realpath = os.path.realpath(repository)
        path_realpath = os.path.realpath(path)
        common = os.path.commonpath([repository_realpath, path_realpath])
    except ValueError:
        return False
    return common == repository_realpath


def repository_path(repository: str, relative_path: str) -> Optional[str]:
    return source_subpath(repository, relative_path)


def load_git_worktrees_lock(repository: str) -> Optional[JSONObject]:
    lock = read_json_object_file(
        os.path.join(repository, SOURCE_MANIFEST_NAME), emit_warnings=True
    )
    return lock if lock is not None and validate_manifest(repository, lock) else None


def validate_manifest(repository: str, lock: JSONMapping) -> bool:
    """Validate once before any source acquisition, build, or runtime consumer."""
    sources = lock.get("sources")
    if not isinstance(sources, dict):
        warn("manifest sources must be an object")
        return False
    for field in ("roots", "treesitter"):
        if field in lock and not isinstance(lock[field], dict):
            warn("manifest {0} must be an object".format(field))
            return False
    metadata = root_treesitter_metadata(lock)
    defaults = metadata.get("defaults", {})
    if not isinstance(defaults, dict):
        warn("treesitter.defaults must be an object")
        return False
    minimum = metadata.get(
        "minimumCliVersion", ".".join(str(part) for part in TREE_SITTER_MINIMUM_VERSION)
    )
    if not isinstance(minimum, str) or re.fullmatch(r"\d+\.\d+\.\d+", minimum) is None:
        warn("treesitter.minimumCliVersion must be a semantic version")
        return False
    for field in ("repositories", "worktrees"):
        roots = lock_roots(lock)
        root = roots.get(field)
        if field in roots and (
            not isinstance(root, str) or source_subpath(repository, root) is None
        ):
            return False
    site = metadata.get("runtimeSite", TREE_SITTER_RUNTIME_SITE)
    runtime_path = source_subpath(repository, site) if isinstance(site, str) else None
    catalog_path = repository_path(repository, SCHEMA_CATALOG_DIR)
    if runtime_path is None or catalog_path is None:
        return False
    owners = [os.path.realpath(runtime_path), os.path.realpath(catalog_path)]
    parser_names: set[str] = set()
    languages: set[str] = set()
    for source_id, source in sources.items():
        if not valid_source_id(source_id) or not isinstance(source, dict):
            warn("invalid manifest source: {0}".format(source_id))
            return False
        if not validate_source_settings(source_id, source):
            return False
        if source_sparse_checkout_paths(source, source_id) == []:
            return False
        for path in (
            source_repository_path(repository, lock, source_id, source),
            source_worktree_path(repository, lock, source_id, source),
        ):
            if path is None or os.path.realpath(path) == os.path.realpath(repository):
                return False
            real = os.path.realpath(path)
            if any(
                real == owner
                or real.startswith(owner + os.sep)
                or owner.startswith(real + os.sep)
                for owner in owners
            ):
                warn("managed paths overlap: {0}".format(path))
                return False
            owners.append(real)
        parsers = source_treesitter(source).get("parsers", {})
        if not isinstance(parsers, dict):
            warn("source {0} treesitter.parsers must be an object".format(source_id))
            return False
        for language, data in parsers.items():
            if (
                not valid_source_id(language)
                or not isinstance(data, dict)
                or language in languages
            ):
                warn("invalid or duplicate parser language: {0}".format(language))
                return False
            name = data.get("parser", language)
            if not valid_source_id(name) or name in parser_names:
                warn("invalid or duplicate parser output: {0}".format(name))
                return False
            parser_names.add(name)
            languages.add(language)
            location = data.get("location", ".")
            if (
                not isinstance(location, str)
                or validated_relative_subpath_or_current(location) is None
            ):
                warn("invalid parser location for {0}".format(language))
                return False
            if not validate_query_settings(data, "parser " + language):
                return False
    if not validate_query_settings(defaults, "treesitter.defaults"):
        return False
    for source_id, source in sources.items():
        if not isinstance(source, dict):
            return False
        dependencies = native_build_dependency_sources(
            source_id, source_native_build(source)
        )
        if dependencies is None or any(
            dependency not in sources or dependency == source_id
            for dependency in dependencies.values()
        ):
            warn(
                "unknown or self-referencing native dependency for {0}".format(
                    source_id
                )
            )
            return False
    for language, data in treesitter_languages(lock).items():
        query_source = data.get(
            "querySource", defaults.get("querySource", TREE_SITTER_QUERY_SOURCE)
        )
        if query_source not in sources:
            warn("unknown query source for {0}: {1}".format(language, query_source))
            return False
        if any(
            dependency not in languages
            for dependency in sequence_strings(data.get("dependencies"))
        ):
            warn("unknown parser dependency for {0}".format(language))
            return False
    groups = defaults.get("supplementalQueryGroups", [])
    if not isinstance(groups, list):
        warn("supplementalQueryGroups must be a list")
        return False
    group_outputs: set[tuple[str, str]] = set()
    for group in groups:
        if (
            not isinstance(group, dict)
            or not valid_source_id(group.get("name"))
            or not valid_source_id(group.get("source"))
            or group.get("source") not in sources
        ):
            warn("invalid supplemental query group")
            return False
        if not valid_string_list(group.get("languages")):
            warn("supplemental query languages must be distinct non-empty strings")
            return False
        for language in sequence_strings(group.get("languages")):
            key = (language, str(group["name"]))
            if (
                not valid_source_id(language)
                or key in group_outputs
                or supplemental_query_source_path(repository, lock, group, language)
                is None
            ):
                warn("invalid or duplicate supplemental query output: {0}".format(key))
                return False
            group_outputs.add(key)
    return True


def valid_string_list(value: object) -> bool:
    return (
        isinstance(value, list)
        and all(isinstance(item, str) and bool(item) for item in value)
        and len(set(value)) == len(value)
    )


def validate_query_settings(data: JSONMapping, context: str) -> bool:
    if "generate" in data and not isinstance(data["generate"], bool):
        warn(context + " generate must be a boolean")
        return False
    for field in ("requiredQueries", "dependencies", "queryDependencies"):
        if field in data and (
            not valid_string_list(data[field])
            or any(not valid_source_id(name) for name in sequence_strings(data[field]))
        ):
            warn(context + " " + field + " must be distinct valid names")
            return False
    if "querySource" in data and not valid_source_id(data["querySource"]):
        warn(context + " querySource must be a source id")
        return False
    for field in ("queryPath", "queryPathTemplate"):
        if field in data:
            value = data[field]
            if (
                not isinstance(value, str)
                or validated_relative_subpath(value.replace("{language}", "language"))
                is None
            ):
                warn(context + " " + field + " must stay within its source")
                return False
    return True


def manifest_sources(lock: JSONMapping) -> Mapping[str, JSONObject]:
    # Only load_git_worktrees_lock accepts external manifests; consumers use its validated result.
    return cast(Mapping[str, JSONObject], lock["sources"])


def lock_roots(lock: JSONMapping) -> JSONMapping:
    return cast(JSONMapping, lock.get("roots", {}))


def source_treesitter(source: JSONMapping) -> JSONMapping:
    return cast(JSONMapping, source.get("treesitter", {}))


def source_treesitter_released_source(source: JSONMapping) -> JSONMapping:
    return cast(JSONMapping, source_treesitter(source).get("releasedSource", {}))


def normalize_relative_subpath(path: str) -> str:
    return path.replace("\\", "/")


def validated_relative_subpath_or_current(path: str) -> Optional[str]:
    normalized = normalize_relative_subpath(path)
    if (
        normalized.startswith("/")
        or ntpath.splitdrive(normalized)[0]
        or "\0" in normalized
    ):
        return None
    normalized = posixpath.normpath(normalized)
    if normalized == ".." or normalized.startswith("../"):
        return None
    return normalized


def validated_relative_subpath(path: str) -> Optional[str]:
    normalized = validated_relative_subpath_or_current(path)
    return normalized if normalized != "." else None


def source_subpath(
    root: str, relative_path: str, allow_current: bool = False
) -> Optional[str]:
    normalized = (
        validated_relative_subpath_or_current(relative_path)
        if allow_current
        else validated_relative_subpath(relative_path)
    )
    if normalized is not None:
        path = os.path.join(root, normalized)
        if path_within_repository(root, path) and (
            allow_current or os.path.realpath(path) != os.path.realpath(root)
        ):
            return path
    warn("path must stay within {0}: {1}".format(root, relative_path))
    return None


def has_native_library_extension(path: str) -> bool:
    return path.endswith((".so", *NATIVE_LIBRARY_EXTENSIONS.values()))


def treesitter_released_source_files(released_source: JSONMapping) -> Sequence[str]:
    value = released_source.get("files", [])
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        return [cast(str, validated_relative_subpath(item)) for item in value]
    return []


def relative_path_collection(value: object, context: str) -> Optional[list[str]]:
    if not isinstance(value, list) or not value:
        warn(context + " must be a non-empty list of relative paths")
        return None
    paths: list[str] = []
    for item in value:
        normalized = validated_relative_subpath(item) if isinstance(item, str) else None
        if normalized is None:
            warn(context + " must contain paths within the source")
            return None
        if any(
            normalized == existing
            or normalized.startswith(existing + "/")
            or existing.startswith(normalized + "/")
            for existing in paths
        ):
            warn(context + " must not repeat or overlap paths")
            return None
        paths.append(normalized)
    return paths


def validate_treesitter_released_source(
    source_id: str, released_source: JSONMapping
) -> bool:
    context = "source " + source_id + " treesitter.releasedSource"
    url = released_source.get("url")
    sha256 = released_source.get("sha256")
    if (
        not isinstance(url, str)
        or not url
        or not isinstance(sha256, str)
        or SHA256_PATTERN.fullmatch(sha256) is None
    ):
        warn(context + " requires a URL and lowercase SHA-256 digest")
        return False
    return (
        relative_path_collection(released_source.get("files"), context + ".files")
        is not None
    )


def source_plugin_metadata(source: JSONMapping) -> JSONMapping:
    return cast(JSONMapping, source.get("plugin", {}))


def native_build_dependency_sources(
    source_id: str, native_build: JSONMapping
) -> Optional[dict[str, str]]:
    value = native_build.get("dependencySources", {})
    context = "source " + source_id + " plugin.nativeBuild.dependencySources"
    if not isinstance(value, dict) or any(
        not valid_source_id(item) for item in value.values()
    ):
        warn(context + " must map relative paths to valid source ids")
        return None
    if not value:
        return {}
    paths = relative_path_collection(list(value), context)
    if paths is None:
        return None
    return dict(zip(paths, cast(Sequence[str], list(value.values()))))


def valid_source_id(source_id: object) -> bool:
    return (
        isinstance(source_id, str)
        and source_id not in (".", "..")
        and SOURCE_ID_PATTERN.fullmatch(source_id) is not None
    )


def root_treesitter_metadata(lock: JSONMapping) -> JSONMapping:
    return cast(JSONMapping, lock.get("treesitter", {}))


def treesitter_minimum_cli_version(
    lock: JSONMapping,
) -> tuple[int, int, int]:
    minimum = TREE_SITTER_MINIMUM_VERSION
    minimum_value = root_treesitter_metadata(lock).get("minimumCliVersion")
    if isinstance(minimum_value, str):
        parsed = parse_version_tuple(minimum_value)
        if parsed is not None:
            return parsed
    return minimum


def source_managed_path(
    repository: str,
    lock: JSONMapping,
    source_id: str,
    source: JSONMapping,
    role: Literal["repository", "worktree"],
) -> Optional[str]:
    relative = source.get(role)
    if relative is None:
        root_key = "repositories" if role == "repository" else "worktrees"
        root = cast(
            str, lock_roots(lock).get(root_key, os.path.join("vendor", "git", root_key))
        )
        relative = posixpath.join(
            normalize_relative_subpath(root),
            source_id + (".git" if role == "repository" else ""),
        )
    return repository_path(repository, cast(str, relative))


def source_repository_path(
    repository: str, lock: JSONMapping, source_id: str, source: JSONMapping
) -> Optional[str]:
    return source_managed_path(repository, lock, source_id, source, "repository")


def source_worktree_path(
    repository: str, lock: JSONMapping, source_id: str, source: JSONMapping
) -> Optional[str]:
    return source_managed_path(repository, lock, source_id, source, "worktree")


def source_remote(source: JSONMapping) -> str:
    remote = source.get("remote", DEFAULT_GIT_REMOTE)
    return remote if isinstance(remote, str) and remote else DEFAULT_GIT_REMOTE


def source_filter(source: JSONMapping) -> Optional[str]:
    value = source.get("filter", DEFAULT_GIT_FILTER)
    return value if isinstance(value, str) and value else None


def source_locked(source: JSONMapping) -> bool:
    value = source.get("locked", DEFAULT_WORKTREE_LOCKED)
    return bool(value)


def normalize_worktree_path(path: str) -> str:
    return posixpath.normpath(normalize_relative_subpath(path))


def source_allowed_dirty_paths(source: JSONMapping) -> Sequence[str]:
    value = source.get("allowedDirtyPaths", [])
    if isinstance(value, list) and all(isinstance(item, str) for item in value):
        paths: list[str] = []
        for item in value:
            normalized = validated_relative_subpath(str(item))
            if normalized is not None:
                paths.append(normalize_worktree_path(normalized))
        return paths
    return []


def validate_source_settings(source_id: str, source: JSONMapping) -> bool:
    context = "source " + source_id
    for field in ("url", "commit", "ref", "remote", "repository", "worktree"):
        if field in ("url", "commit") or field in source:
            value = source.get(field)
            if not isinstance(value, str) or not value:
                warn(context + " " + field + " must be a non-empty string")
                return False
    if re.fullmatch(r"[a-f0-9]{40}", str(source.get("commit"))) is None:
        warn(context + " commit must be a full lowercase Git commit id")
        return False
    if any(str(source.get(field, "")).startswith("-") for field in ("ref", "remote")):
        warn(context + " ref and remote must not be Git options")
        return False
    for field in ("repository", "worktree"):
        if field in source and validated_relative_subpath(str(source[field])) is None:
            warn(context + " " + field + " must be a relative managed directory")
            return False
    filter_value = source.get("filter")
    if filter_value is not None and (
        not isinstance(filter_value, str) or not filter_value
    ):
        warn(context + " filter must be null or a non-empty string")
        return False
    if "locked" in source and not isinstance(source["locked"], bool):
        warn(context + " locked must be a boolean")
        return False
    dirty = source.get("allowedDirtyPaths", [])
    if not valid_string_list(dirty) or any(
        validated_relative_subpath(path) is None for path in sequence_strings(dirty)
    ):
        warn(context + " allowedDirtyPaths must be distinct paths within the worktree")
        return False
    for field in ("treesitter", "plugin"):
        if field in source and not isinstance(source[field], dict):
            warn(context + " " + field + " must be an object")
            return False
    treesitter = source_treesitter(source)
    if "releasedSource" in treesitter:
        released = treesitter["releasedSource"]
        if not isinstance(released, dict) or not validate_treesitter_released_source(
            source_id, released
        ):
            return False
    plugin = source_plugin_metadata(source)
    if "nativeBuild" not in plugin:
        return True
    native = plugin["nativeBuild"]
    if not isinstance(native, dict):
        warn(context + " plugin.nativeBuild must be an object")
        return False
    kind = native.get("kind")
    policy = NATIVE_BUILD_POLICIES.get(kind) if isinstance(kind, str) else None
    if policy is None or set(native) - policy.fields:
        warn(context + " unsupported native build kind or field combination")
        return False
    if "optional" in native and not isinstance(native["optional"], bool):
        warn(context + " nativeBuild.optional must be a boolean")
        return False
    if (
        "minimumCargoVersion" in native
        and re.fullmatch(r"\d+\.\d+\.\d+", str(native["minimumCargoVersion"])) is None
    ):
        warn(context + " nativeBuild.minimumCargoVersion must be a semantic version")
        return False
    if "package" in native and (
        not isinstance(native["package"], str) or not native["package"]
    ):
        warn(context + " nativeBuild.package must be a non-empty string")
        return False
    if not valid_string_list(native.get("features", [])):
        warn(context + " nativeBuild.features must be distinct non-empty strings")
        return False
    return native_build_paths_ok(None, source_id, source)


def native_build_paths_ok(
    worktree: Optional[str], source_id: str, source: JSONMapping
) -> bool:
    native_build = source_native_build(source)
    if not native_build:
        return True
    policy = NATIVE_BUILD_POLICIES.get(str(native_build.get("kind")))
    if policy is None:
        warn("unsupported native build kind for source " + source_id)
        return False
    paths = list(policy.outputs)
    dependencies = native_build_dependency_sources(source_id, native_build)
    if dependencies is None:
        return False
    paths.extend(dependencies)
    artifact = native_plugin_artifact_path("", native_build)
    revision = native_build_revision_path("", native_build)
    if artifact is None or revision is None:
        warn("unable to resolve native output paths for source {0}".format(source_id))
        return False
    paths.extend(native_runtime_files(native_build))
    paths.append(revision.replace(os.sep, "/"))
    allowed = source_allowed_dirty_paths(source)
    for path in paths:
        if not path_allowed_by(path, allowed):
            warn(
                "source {0} native build path is not covered by allowedDirtyPaths: {1}".format(
                    source_id, path
                )
            )
            return False
        if worktree is not None:
            destination = source_subpath(worktree, path)
            if destination is None:
                return False
            resolved_relative = os.path.relpath(
                os.path.realpath(destination), os.path.realpath(worktree)
            ).replace(os.sep, "/")
            if not path_allowed_by(resolved_relative, allowed):
                warn(
                    "source {0} native build path resolves outside allowedDirtyPaths: {1}".format(
                        source_id, path
                    )
                )
                return False
    return True


def source_sparse_checkout_paths(
    source: JSONMapping, source_id: str
) -> Optional[Sequence[str]]:
    if "files" not in source:
        return None
    paths = relative_path_collection(source["files"], "source " + source_id + " files")
    return ["/" + path for path in paths] if paths is not None else []


def git_dir_command(git: str, git_dir: str, args: Sequence[str]) -> Sequence[str]:
    return [git, "--git-dir", git_dir, *args]


def ensure_bare_repository(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    git_dir: str,
) -> bool:
    url = source.get("url")
    if not isinstance(url, str) or not url:
        warn("source {0} url must be a non-empty string".format(source_id))
        return False

    remote = source_remote(source)

    if not os.path.isdir(git_dir):
        parent = os.path.dirname(git_dir)
        try:
            os.makedirs(parent, exist_ok=True)
        except OSError as exc:
            warn("unable to create {0}: {1}".format(parent, exc))
            return False
        filter_value = source_filter(source)
        command = [git, "clone", "--bare", "--origin", remote]
        if filter_value:
            command.append("--filter=" + filter_value)
        command.extend(["--", url, git_dir])
        return run_logged_command(
            command, env, repository, show_success_output_on_stderr=False
        )

    # Ownership binds the stored declaration, not caller-specific transport rewrites.
    completed = run_captured_command(
        git_dir_command(
            git,
            git_dir,
            ["config", "--local", "--get-all", "remote." + remote + ".url"],
        ),
        env,
        repository,
    )
    if completed is None or completed.returncode != 0:
        warn("unable to inspect remote {0} for source {1}".format(remote, source_id))
        if completed is not None:
            print_completed_output(completed)
        return False
    current_urls = completed.stdout.splitlines()
    if current_urls != [url]:
        warn(
            "source {0} remote {1} mismatch: expected {2}, found {3}".format(
                source_id, remote, url, current_urls
            )
        )
        return False
    return True


def fetch_source_commit(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    git_dir: str,
    refresh: bool,
) -> bool:
    commit = source.get("commit")
    if not isinstance(commit, str) or not commit:
        warn("source {0} commit must be a non-empty string".format(source_id))
        return False

    remote = source_remote(source)
    filter_value = source_filter(source)
    fetch_base = ["fetch"]
    if filter_value:
        fetch_base.append("--filter=" + filter_value)
    ref = source.get("ref")
    commit_is_available = commit_available(git, env, repository, git_dir, commit)
    if commit_is_available and not refresh:
        return True
    if isinstance(ref, str) and ref:
        if not run_logged_command(
            git_dir_command(git, git_dir, [*fetch_base, remote, ref]),
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False
        if commit_available(git, env, repository, git_dir, commit):
            return True
    if commit_is_available and (not isinstance(ref, str) or not ref):
        return True
    if not run_logged_command(
        git_dir_command(git, git_dir, [*fetch_base, remote, commit]),
        env,
        repository,
        show_success_output_on_stderr=False,
    ):
        return False
    return verify_commit(git, env, repository, source_id, git_dir, commit)


def commit_available(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    commit: str,
) -> bool:
    completed = run_captured_command(
        git_dir_command(
            git,
            git_dir,
            ["rev-parse", "--verify", "--end-of-options", commit + "^{commit}"],
        ),
        env,
        repository,
    )
    return completed is not None and completed.returncode == 0


def verify_commit(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    git_dir: str,
    commit: str,
) -> bool:
    completed = run_captured_command(
        git_dir_command(
            git,
            git_dir,
            ["rev-parse", "--verify", "--end-of-options", commit + "^{commit}"],
        ),
        env,
        repository,
    )
    if completed is None or completed.returncode != 0:
        warn("source {0} commit is not available: {1}".format(source_id, commit))
        if completed is not None:
            print_completed_output(completed)
        return False
    return True


def is_git_worktree(path: str) -> bool:
    return os.path.exists(os.path.join(path, ".git"))


def worktree_head(
    git: str, env: Mapping[str, str], repository: str, worktree: str
) -> Optional[str]:
    completed = run_captured_command(
        [git, "-C", worktree, "rev-parse", "HEAD"], env, repository
    )
    if completed is None or completed.returncode != 0:
        if completed is not None:
            print_completed_output(completed)
        return None
    return completed.stdout.strip()


def worktree_sparse_checkout_enabled(
    git: str, env: Mapping[str, str], repository: str, worktree: str
) -> Optional[bool]:
    # --worktree rejects full checkouts without extensions.worktreeConfig.
    # Effective config includes worktree settings when that extension is enabled.
    completed = run_captured_command(
        [
            git,
            "-C",
            worktree,
            "config",
            "--get",
            "--bool",
            "core.sparseCheckout",
        ],
        env,
        repository,
    )
    if completed is None:
        return None
    if completed.returncode == 1:
        return False  # git config reports an absent key with exit status 1.
    if completed.returncode != 0:
        print_completed_output(completed)
        return None
    return completed.stdout.strip() == "true"


def worktree_sparse_checkout_list(
    git: str, env: Mapping[str, str], repository: str, worktree: str
) -> Optional[Sequence[str]]:
    completed = run_captured_command(
        [git, "-C", worktree, "sparse-checkout", "list"], env, repository
    )
    if completed is None or completed.returncode != 0:
        return None
    return [line for line in completed.stdout.splitlines() if line]


def configure_worktree_sparse_checkout(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    worktree: str,
    sparse_paths: Optional[Sequence[str]],
    initialize: bool,
) -> bool:
    enabled = worktree_sparse_checkout_enabled(git, env, repository, worktree)
    if enabled is None:
        warn("unable to inspect source {0} sparse checkout state".format(source_id))
        return False

    if sparse_paths is None:
        if not enabled:
            return True
        return run_logged_command(
            [git, "-C", worktree, "sparse-checkout", "disable"],
            env,
            repository,
            show_success_output_on_stderr=False,
        )

    if not initialize and enabled:
        actual = worktree_sparse_checkout_list(git, env, repository, worktree)
        if actual is None:
            warn("unable to inspect source {0} sparse checkout paths".format(source_id))
            return False
        if list(actual) == list(sparse_paths):
            return True

    if not run_logged_command(
        [git, "-C", worktree, "sparse-checkout", "set", "--no-cone", *sparse_paths],
        env,
        repository,
        show_success_output_on_stderr=False,
    ):
        return False

    if not initialize:
        return True

    return run_logged_command(
        [git, "-C", worktree, "read-tree", "-mu", "HEAD"],
        env,
        repository,
        show_success_output_on_stderr=False,
    )


def local_git_environment(env: Mapping[str, str]) -> Dict[str, str]:
    return dict(
        env,
        GIT_NO_LAZY_FETCH="1",
        GIT_OPTIONAL_LOCKS="0",
        GIT_CONFIG_GLOBAL=os.devnull,
        GIT_CONFIG_NOSYSTEM="1",
        GIT_CONFIG_COUNT="3",
        GIT_CONFIG_KEY_0="protocol.allow",
        GIT_CONFIG_VALUE_0="never",
        GIT_CONFIG_KEY_1="core.fsmonitor",
        GIT_CONFIG_VALUE_1="false",
        GIT_CONFIG_KEY_2="core.hooksPath",
        GIT_CONFIG_VALUE_2=os.devnull,
        GIT_TERMINAL_PROMPT="0",
    )


def managed_git(git: str, env: Mapping[str, str], repository: str) -> bool:
    completed = run_captured_command([git, "--version"], env, repository)
    version = parse_version_tuple(completed.stdout) if completed is not None else None
    if (
        completed is None
        or completed.returncode != 0
        or version is None
        or version < GIT_MINIMUM_VERSION
    ):
        warn(
            "managed relative worktrees require Git >="
            + ".".join(map(str, GIT_MINIMUM_VERSION))
        )
        return False
    return True


def worktree_registration_ok(
    git_dir: str, worktree: str, relative: bool = True
) -> bool:
    """Establish both directions of owned registration before Git or repair."""
    try:
        pointer = os.path.join(worktree, ".git")
        if (
            os.path.islink(git_dir)
            or os.path.islink(worktree)
            or os.path.islink(pointer)
        ):
            return False
        text = read_text_file(pointer)
        if text is None or not text.startswith("gitdir: "):
            return False
        target = text.removeprefix("gitdir: ")
        admin = os.path.realpath(os.path.join(worktree, target))
        root = os.path.join(os.path.realpath(git_dir), "worktrees")
        if os.path.dirname(admin) != root or not os.path.isdir(admin):
            return False
        back = read_text_file(os.path.join(admin, "gitdir"))
        common = read_text_file(os.path.join(admin, "commondir"))
        if back is None or common is None:
            return False
        if relative and any(os.path.isabs(p) for p in (target, back, common)):
            return False
        if os.path.realpath(os.path.join(admin, back)) != os.path.realpath(pointer):
            return False
        if os.path.realpath(os.path.join(admin, common)) != os.path.realpath(git_dir):
            return False
        return not os.path.lexists(
            os.path.join(git_dir, "objects", "info", "alternates")
        )
    except OSError as exc:
        warn("unable to inspect Git registration: " + str(exc))
        return False


def retained_git_objects_ok(
    git: str, env: Mapping[str, str], repository: str, worktree: str
) -> bool:
    """Prove retained blobs are local, with lazy acquisition prohibited."""
    env = local_git_environment(env)
    listing = run_captured_command(
        [git, "-C", worktree, "ls-files", "-t", "--stage", "-z"], env, repository
    )
    if listing is None or listing.returncode != 0:
        return False
    objects = []
    for entry in listing.stdout.split("\0"):
        if not entry or entry.startswith("S "):
            continue
        fields = entry.split(" ", 3)
        if len(fields) != 4 or fields[3].split("\t", 1)[0] != "0":
            return False
        if fields[1] == "160000":
            continue
        if fields[1] not in ("100644", "100755", "120000"):
            return False
        objects.append(fields[2])
    if not objects:
        return True
    try:
        result = subprocess.run(
            [git, "-C", worktree, "cat-file", "--batch-check"],
            cwd=repository,
            env=env,
            input="\n".join(objects) + "\n",
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        warn("unable to inspect retained Git objects: " + str(exc))
        return False
    lines = result.stdout.splitlines()
    if (
        result.returncode != 0
        or len(lines) != len(objects)
        or any(len(line.split()) != 3 or line.split()[1] != "blob" for line in lines)
    ):
        print_completed_output(result)
        warn("retained Git blobs are unavailable: " + worktree)
        return False
    return True


def ensure_worktree(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    git_dir: str,
    worktree: str,
) -> bool:
    commit = source.get("commit")
    if not isinstance(commit, str) or not commit:
        warn("source {0} commit must be a non-empty string".format(source_id))
        return False

    sparse_paths = source_sparse_checkout_paths(source, source_id)
    if sparse_paths == []:
        return False

    if os.path.exists(worktree):
        if not is_git_worktree(worktree):
            warn(
                "source {0} worktree exists but is not a Git worktree: {1}".format(
                    source_id, worktree
                )
            )
            return False
        if not worktree_registration_ok(git_dir, worktree, relative=False):
            warn("refusing foreign/invalid worktree registration: " + source_id)
            return False
        if not check_worktree_pristine(
            git,
            env,
            repository,
            source_id,
            worktree,
            source_allowed_dirty_paths(source),
        ):
            return False
        if not configure_worktree_sparse_checkout(
            git,
            env,
            repository,
            source_id,
            worktree,
            sparse_paths,
            initialize=False,
        ):
            return False
        if not worktree_registration_ok(git_dir, worktree):
            if not run_logged_command(
                git_dir_command(
                    git, git_dir, ["worktree", "repair", "--relative-paths", worktree]
                ),
                env,
                repository,
            ):
                return False
            if not worktree_registration_ok(git_dir, worktree):
                warn("relative registration repair failed: " + source_id)
                return False
        head = worktree_head(git, env, repository, worktree)
        if head is None:
            warn("unable to inspect source {0} HEAD".format(source_id))
            return False
        if head != commit and not run_logged_command(
            [git, "-C", worktree, "checkout", "--detach", commit],
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False
    else:
        if not remove_missing_worktree_registration(
            git, env, repository, git_dir, worktree
        ):
            return False
        try:
            os.makedirs(os.path.dirname(worktree), exist_ok=True)
        except OSError as exc:
            warn(
                "unable to create parent directory for source {0} worktree: {1}".format(
                    source_id, exc
                )
            )
            return False
        args = ["worktree", "add", "--detach", "--relative-paths"]
        if sparse_paths is not None:
            args.append("--no-checkout")
        if source_locked(source):
            args.extend(["--lock", "--reason", WORKTREE_LOCK_REASON])
        args.extend([worktree, commit])
        if not run_logged_command(
            git_dir_command(git, git_dir, args),
            env,
            repository,
            show_success_output_on_stderr=False,
        ):
            return False
        if not configure_worktree_sparse_checkout(
            git,
            env,
            repository,
            source_id,
            worktree,
            sparse_paths,
            initialize=sparse_paths is not None,
        ):
            return False

    if not ensure_worktree_lock_state(
        git,
        env,
        repository,
        git_dir,
        worktree,
        source_locked(source),
    ):
        return False
    return check_worktree_pristine(
        git, env, repository, source_id, worktree, source_allowed_dirty_paths(source)
    )


def path_allowed_by(path: str, allowed_paths: Sequence[str]) -> bool:
    normalized_path = normalize_worktree_path(path)
    for allowed_path in allowed_paths:
        if normalized_path == allowed_path or normalized_path.startswith(
            allowed_path + "/"
        ):
            return True
    return False


def unexpected_dirty_lines(
    output: str, allowed_paths: Sequence[str], status: bool
) -> Sequence[str]:
    unexpected = []
    records = iter(output.split("\0"))
    for record in records:
        if not record:
            continue
        paths = [record[3:]] if status else [record]
        if status and any(code in record[:2] for code in "RC"):
            original = next(records, "")
            if not original:
                unexpected.append("malformed Git rename/copy record: " + repr(record))
                continue
            paths.append(original)
        if any(not path_allowed_by(path, allowed_paths) for path in paths):
            unexpected.append(repr(record))
    return unexpected


def check_worktree_pristine(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    worktree: str,
    allowed_dirty_paths: Sequence[str] = (),
    emit_warnings: bool = True,
) -> bool:
    status = run_captured_command(
        [
            git,
            "-C",
            worktree,
            "status",
            "--porcelain=v1",
            "-z",
            "--untracked-files=all",
        ],
        env,
        repository,
    )
    if status is None or status.returncode != 0:
        if emit_warnings:
            warn("unable to inspect source {0} worktree status".format(source_id))
            if status is not None:
                print_completed_output(status)
        return False
    ignored = run_captured_command(
        [
            git,
            "-C",
            worktree,
            "ls-files",
            "-z",
            "--others",
            "--ignored",
            "--exclude-standard",
        ],
        env,
        repository,
    )
    if ignored is None or ignored.returncode != 0:
        if emit_warnings:
            warn("unable to inspect source {0} ignored files".format(source_id))
            if ignored is not None:
                print_completed_output(ignored)
        return False

    dirty = []
    status_dirty = unexpected_dirty_lines(
        status.stdout, allowed_dirty_paths, status=True
    )
    ignored_dirty = unexpected_dirty_lines(
        ignored.stdout, allowed_dirty_paths, status=False
    )
    if status_dirty:
        dirty.append("\n".join(status_dirty))
    if ignored_dirty:
        dirty.append("\n".join(ignored_dirty))
    if dirty:
        if emit_warnings:
            warn(
                "source {0} worktree is not pristine:\n{1}".format(
                    source_id, "\n".join(dirty)
                )
            )
        return False
    return True


def worktree_record(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    worktree: str,
) -> Optional[list[str]]:
    completed = run_captured_command(
        git_dir_command(git, git_dir, ["worktree", "list", "--porcelain"]),
        env,
        repository,
    )
    if completed is None or completed.returncode != 0:
        if completed is not None:
            print_completed_output(completed)
        return None
    worktree_realpath = os.path.realpath(worktree)
    records = completed.stdout.split("\n\n")
    for record in records:
        lines = record.splitlines()
        if not lines or not lines[0].startswith("worktree "):
            continue
        listed_worktree = lines[0][len("worktree ") :]
        if listed_worktree == worktree:
            return lines
        if os.path.realpath(listed_worktree) == worktree_realpath:
            return lines
    return []


def worktree_lock_state(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    worktree: str,
) -> Optional[bool]:
    lines = worktree_record(git, env, repository, git_dir, worktree)
    if lines is None:
        return None
    return any(line == "locked" or line.startswith("locked ") for line in lines)


def ensure_worktree_lock_state(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    worktree: str,
    locked: bool,
) -> bool:
    current = worktree_lock_state(git, env, repository, git_dir, worktree)
    if current is None:
        warn("unable to inspect Git worktree lock state: {0}".format(worktree))
        return False
    if current == locked:
        return True
    args = (
        ["worktree", "lock", "--reason", WORKTREE_LOCK_REASON, worktree]
        if locked
        else ["worktree", "unlock", worktree]
    )
    if not run_logged_command(
        git_dir_command(git, git_dir, args),
        env,
        repository,
        show_success_output_on_stderr=False,
    ):
        return False
    updated = worktree_lock_state(git, env, repository, git_dir, worktree)
    return updated == locked


def check_worktree_lock_state(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    git_dir: str,
    worktree: str,
    locked: bool,
    emit_warnings: bool = True,
) -> bool:
    current = worktree_lock_state(git, env, repository, git_dir, worktree)
    if current is None:
        if emit_warnings:
            warn("unable to inspect source {0} worktree lock state".format(source_id))
        return False
    if current == locked:
        return True
    if emit_warnings:
        warn(
            "source {0} worktree lock mismatch: expected {1}, found {2}".format(
                source_id,
                "locked" if locked else "unlocked",
                "locked" if current else "unlocked",
            )
        )
    return False


def remove_missing_worktree_registration(
    git: str,
    env: Mapping[str, str],
    repository: str,
    git_dir: str,
    worktree: str,
) -> bool:
    lines = worktree_record(git, env, repository, git_dir, worktree)
    if lines is None:
        return False
    if not lines:
        return True
    return run_logged_command(
        git_dir_command(
            git, git_dir, ["worktree", "remove", "--force", "--force", worktree]
        ),
        env,
        repository,
        show_success_output_on_stderr=False,
    )


def materialize_git_sources(
    env: Mapping[str, str], repository: str, lock: JSONMapping, refresh: bool
) -> bool:
    git = resolve_required("git", env)
    if git is None or not managed_git(git, env, repository):
        return False
    ok = True
    for source_id, source_value in manifest_sources(lock).items():
        git_dir = source_repository_path(repository, lock, source_id, source_value)
        worktree = source_worktree_path(repository, lock, source_id, source_value)
        if git_dir is None or worktree is None:
            ok = False
            continue
        if not ensure_bare_repository(
            git, env, repository, source_id, source_value, git_dir
        ):
            ok = False
            continue
        if not fetch_source_commit(
            git, env, repository, source_id, source_value, git_dir, refresh
        ):
            ok = False
            continue
        if not ensure_worktree(
            git, env, repository, source_id, source_value, git_dir, worktree
        ):
            ok = False
    return ok


def check_worktree_sparse_checkout(
    git: str,
    env: Mapping[str, str],
    repository: str,
    source_id: str,
    source: JSONMapping,
    worktree: str,
    emit_warnings: bool = True,
) -> bool:
    expected = source_sparse_checkout_paths(source, source_id)
    if expected == []:
        return False

    enabled = worktree_sparse_checkout_enabled(git, env, repository, worktree)
    if enabled is None:
        if emit_warnings:
            warn("unable to inspect source {0} sparse checkout state".format(source_id))
        return False
    if expected is None:
        if enabled:
            if emit_warnings:
                warn(
                    "source {0} sparse checkout is enabled unexpectedly".format(
                        source_id
                    )
                )
            return False
        return True
    if not enabled:
        if emit_warnings:
            warn("source {0} sparse checkout is not enabled".format(source_id))
        return False
    actual = worktree_sparse_checkout_list(git, env, repository, worktree)
    if actual is None:
        if emit_warnings:
            warn("unable to inspect source {0} sparse checkout paths".format(source_id))
        return False
    if list(actual) != list(expected):
        if emit_warnings:
            warn(
                "source {0} sparse checkout mismatch: expected {1}, found {2}".format(
                    source_id,
                    ", ".join(expected),
                    ", ".join(actual),
                )
            )
        return False
    return True


def git_sources_state_ok(
    env: Mapping[str, str],
    repository: str,
    lock: JSONMapping,
    emit_warnings: bool,
) -> bool:
    env = local_git_environment(env)
    git = resolve_required("git", env)
    if git is None or not managed_git(git, env, repository):
        return False
    ok = True
    for source_id, source_value in manifest_sources(lock).items():
        git_dir = source_repository_path(repository, lock, source_id, source_value)
        worktree = source_worktree_path(repository, lock, source_id, source_value)
        commit = source_value.get("commit")
        if git_dir is None or worktree is None or not isinstance(commit, str):
            ok = False
            continue
        if not os.path.isdir(git_dir):
            if emit_warnings:
                warn(
                    "source {0} repository not found; run ./manage install".format(
                        source_id
                    )
                )
            ok = False
            continue
        url = source_value.get("url")
        if not isinstance(url, str) or not url:
            if emit_warnings:
                warn("source {0} url must be a non-empty string".format(source_id))
            ok = False
            continue
        remote = source_remote(source_value)
        completed = run_captured_command(
            git_dir_command(
                git,
                git_dir,
                ["config", "--local", "--get-all", "remote." + remote + ".url"],
            ),
            env,
            repository,
        )
        if completed is None or completed.returncode != 0:
            if emit_warnings:
                warn(
                    "unable to inspect remote {0} for source {1}".format(
                        remote, source_id
                    )
                )
                if completed is not None:
                    print_completed_output(completed)
            ok = False
            continue
        current_urls = completed.stdout.splitlines()
        if current_urls != [url]:
            if emit_warnings:
                warn(
                    "source {0} remote {1} mismatch: expected {2}, found {3}".format(
                        source_id, remote, url, current_urls
                    )
                )
            ok = False
        if not commit_available(git, env, repository, git_dir, commit):
            if emit_warnings:
                warn(
                    "source {0} commit is not available in bare repository: {1}".format(
                        source_id, commit
                    )
                )
            ok = False
        if not os.path.exists(worktree):
            if emit_warnings:
                warn(
                    "source {0} worktree not found; run ./manage install".format(
                        source_id
                    )
                )
            ok = False
            continue
        if not is_git_worktree(worktree):
            if emit_warnings:
                warn(
                    "source {0} worktree exists but is not a Git worktree: {1}".format(
                        source_id, worktree
                    )
                )
            ok = False
            continue
        if not worktree_registration_ok(git_dir, worktree):
            if emit_warnings:
                warn(
                    "invalid/absolute managed Git registration: "
                    + source_id
                    + "; run ./manage install"
                )
            ok = False
            continue
        if not retained_git_objects_ok(git, env, repository, worktree):
            ok = False
        head = worktree_head(git, env, repository, worktree)
        if head != commit:
            if emit_warnings:
                warn(
                    "source {0} HEAD mismatch: expected {1}, found {2}".format(
                        source_id, commit, head
                    )
                )
            ok = False
        if not check_worktree_lock_state(
            git,
            env,
            repository,
            source_id,
            git_dir,
            worktree,
            source_locked(source_value),
            emit_warnings=emit_warnings,
        ):
            ok = False
        if not check_worktree_sparse_checkout(
            git,
            env,
            repository,
            source_id,
            source_value,
            worktree,
            emit_warnings=emit_warnings,
        ):
            ok = False
        if not check_worktree_pristine(
            git,
            env,
            repository,
            source_id,
            worktree,
            source_allowed_dirty_paths(source_value),
            emit_warnings=emit_warnings,
        ):
            ok = False
    return ok


def check_git_sources(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    return git_sources_state_ok(env, repository, lock, emit_warnings=True)


def parse_version_tuple(text: str) -> Optional[tuple[int, int, int]]:
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    if not match:
        return None
    return (int(match.group(1)), int(match.group(2)), int(match.group(3)))


def check_tree_sitter_cli(
    env: Mapping[str, str], repository: str, minimum: tuple[int, int, int]
) -> bool:
    tree_sitter = resolve_required("tree-sitter", env)
    if tree_sitter is None:
        return False
    completed = run_captured_command([tree_sitter, "--version"], env, repository)
    if completed is None or completed.returncode != 0:
        warn("unable to query tree-sitter version")
        if completed is not None:
            print_completed_output(completed)
        return False
    version = parse_version_tuple(completed.stdout)
    if version is None or version < minimum:
        warn(
            "tree-sitter-cli >= {0} is required; found {1}".format(
                ".".join(str(part) for part in minimum), completed.stdout.strip()
            )
        )
        return False
    return True


def parser_extension() -> str:
    return ".so"


def current_platform_signature() -> JSONObject:
    signature: JSONObject = {
        "osName": os.name,
        "sysPlatform": sys.platform,
    }
    machine = platform.machine().lower()
    if machine:
        signature["machine"] = MACHINE_ALIASES.get(machine, machine)
    return signature


def runtime_requirements() -> JSONObject:
    if sys.platform == "linux":
        name, version = platform.libc_ver()
        return {"libc": name, "minimumVersion": version}
    if sys.platform == "darwin":
        return {
            "minimumVersion": os.environ.get("MACOSX_DEPLOYMENT_TARGET")
            or platform.mac_ver()[0]
        }
    return {}


def numeric_version(text: str) -> tuple[int, ...]:
    """Compare already validated numeric versions, ignoring trailing zeros."""
    parts = list(map(int, text.split(".")))
    while parts and parts[-1] == 0:
        parts.pop()
    return tuple(parts)


def platform_state_ok(state: JSONMapping) -> bool:
    if any(state.get(k) != v for k, v in current_platform_signature().items()):
        return False
    requirements = state.get("requirements")
    if not isinstance(requirements, dict):
        return False
    host = runtime_requirements()
    if sys.platform == "darwin":
        host = {"minimumVersion": platform.mac_ver()[0]}
    if requirements.get("libc") != host.get("libc"):
        return False
    required = str(requirements.get("minimumVersion", ""))
    available = str(host.get("minimumVersion", ""))
    if required or available:
        if not re.fullmatch(r"\d+(?:\.\d+)*", required) or not re.fullmatch(
            r"\d+(?:\.\d+)*", available
        ):
            return False
        return numeric_version(required) <= numeric_version(available)
    return True


def output_hashes(root: str, paths: Sequence[str]) -> Optional[JSONObject]:
    result: JSONObject = {}
    for relative in sorted(paths):
        path = source_subpath(root, relative)
        if path is None or not os.path.isfile(path) or os.path.islink(path):
            return None
        digest = sha256_file(path)
        if digest is None:
            return None
        result[relative] = digest
    return result


def treesitter_runtime_signature(
    configuration_sha256: str, tree_sitter_version: Optional[str]
) -> JSONObject:
    signature = dict(current_platform_signature())
    signature["parserExtension"] = parser_extension()
    signature["generatorVersion"] = TREE_SITTER_RUNTIME_GENERATOR_VERSION
    signature["configurationSha256"] = configuration_sha256
    signature["requirements"] = runtime_requirements()
    if tree_sitter_version:
        signature["treeSitterCliVersion"] = tree_sitter_version
    return signature


def treesitter_languages(lock: JSONMapping) -> Dict[str, JSONObject]:
    languages: Dict[str, JSONObject] = {}
    for source_id, source in manifest_sources(lock).items():
        parsers = cast(
            Mapping[str, JSONMapping], source_treesitter(source).get("parsers", {})
        )
        for language, parser_data in parsers.items():
            data = dict(parser_data)
            data["source"] = source_id
            languages[language] = data
    return languages


