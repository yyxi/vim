def tree_sitter_cli_version_text(
    tree_sitter: str, env: Mapping[str, str], repository: str
) -> Optional[str]:
    completed = run_captured_command([tree_sitter, "--version"], env, repository)
    if completed is None or completed.returncode != 0:
        return None
    version = completed.stdout.strip()
