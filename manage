def treesitter_runtime_signature_ok(
    runtime_site: str,
    env: Optional[Mapping[str, str]],
    repository: str,
    emit_warnings: bool,
) -> bool:
    path = treesitter_runtime_signature_path(runtime_site)
    signature = read_json_object_file(path, emit_warnings=emit_warnings)
    if signature is None:
        if emit_warnings and not os.path.exists(path):
            warn(
                "Treesitter runtime signature missing: {0}; run ./manage install".format(
                    path
                )
            )
        return False
    tree_sitter_version = None
    if env is not None:
        tree_sitter = shutil.which("tree-sitter", path=env.get("PATH"))
        if tree_sitter:
            tree_sitter_version = tree_sitter_cli_version_text(
                tree_sitter, env, repository
            )
    expected = treesitter_runtime_signature(parser_extension(), tree_sitter_version)
    for key, value in expected.items():
        if signature.get(key) != value:
            if emit_warnings:
                warn(
                    "Treesitter runtime signature mismatch for {0}: expected {1}={2}, found {3}; run ./manage install".format(
                        path, key, value, signature.get(key)
                    )
                )
            return False
    return True


