def copy_source_for_build(
    repository: str,
    lock: JSONMapping,
    scratch_root: str,
    source_id: str,
    copied_sources: set[str],
) -> Optional[str]:
    destination = os.path.join(scratch_root, "sources", source_id)
    if source_id in copied_sources:
        return destination
    source_root = treesitter_source_root_by_id(repository, lock, source_id)
    if source_root is None:
        return None
    try:
        if os.path.exists(destination):
            shutil.rmtree(destination)
        shutil.copytree(source_root, destination, ignore=shutil.ignore_patterns(".git"))
    except OSError as exc:
        warn("unable to stage Treesitter build source {0}: {1}".format(source_id, exc))
        return None
    copied_sources.add(source_id)
    return destination


def query_dependency_data(parser_data: JSONMapping) -> JSONObject:
    query_data: JSONObject = {}
    query_source = parser_data.get("querySource")
    if isinstance(query_source, str):
        query_data["querySource"] = query_source
    query_path = parser_data.get("queryPath")
    if isinstance(query_path, str):
        query_data["queryPath"] = query_path
    return query_data


def install_treesitter_runtime(
    env: Mapping[str, str], repository: str, lock: JSONMapping
) -> bool:
    if treesitter_runtime_state_ok(repository, lock, emit_warnings=False):
        return True
    if not check_tree_sitter_cli(env, repository, treesitter_minimum_cli_version(lock)):
        return False

    runtime_site = tree_sitter_runtime_site(repository, lock)
    if runtime_site is None:
        return False
    languages = treesitter_languages(lock)
    if not languages:
        warn("no Treesitter parsers configured in {0}".format(SOURCE_MANIFEST_NAME))
        return False

    tree_sitter = resolve_required("tree-sitter", env)
    if tree_sitter is None:
        return False

    runtime_parent = os.path.dirname(runtime_site)
    try:
        os.makedirs(runtime_parent, exist_ok=True)
    except OSError as exc:
        warn("unable to create {0}: {1}".format(runtime_parent, exc))
        return False

    with tempfile.TemporaryDirectory(
        prefix="treesitter-runtime-", dir=runtime_parent
    ) as staging_root:
        staged_runtime_site = os.path.join(staging_root, "site")
        try:
            for child in ("parser", "queries", "state"):
                os.makedirs(os.path.join(staged_runtime_site, child), exist_ok=True)
        except OSError as exc:
            warn(
                "unable to create staged Treesitter runtime directories: {0}".format(
                    exc
                )
            )
            return False

        ok = True
        with tempfile.TemporaryDirectory(prefix="treesitter-build-") as scratch_root:
            copied_sources: set[str] = set()
            for language, parser_data in sorted(languages.items()):
                source_id = parser_data.get("source")
                location = parser_data.get("location", ".")
                parser_name = parser_data.get("parser", language)
                if (
                    not isinstance(source_id, str)
                    or not isinstance(location, str)
                    or not isinstance(parser_name, str)
                ):
                    warn("invalid Treesitter parser metadata for {0}".format(language))
                    ok = False
                    continue
                build_source = copy_source_for_build(
                    repository, lock, scratch_root, source_id, copied_sources
                )
                if build_source is None:
                    ok = False
                    continue
                normalized_location = validated_relative_subpath_or_current(location)
                if normalized_location is None:
                    warn(
                        "parser location for {0} must be a relative path within the source".format(
                            language
                        )
                    )
                    ok = False
                    continue
                build_dir = os.path.abspath(
                    os.path.join(build_source, normalized_location)
                )
                if not os.path.isdir(build_dir):
                    warn(
                        "parser source not found for {0}: {1}".format(
                            language, build_dir
                        )
                    )
                    ok = False
                    continue
                if bool(parser_data.get("generate", False)):
                    if not run_logged_command(
                        [tree_sitter, "generate"],
                        env,
                        build_dir,
                        show_success_output_on_stderr=False,
                    ):
                        ok = False
                        continue
                output = os.path.join(
                    staged_runtime_site, "parser", parser_name + parser_extension()
                )
                if not run_logged_command(
                    [tree_sitter, "build", "-o", output],
                    env,
                    build_dir,
                    show_success_output_on_stderr=False,
                ):
                    ok = False
                    continue
                commit = source_commit_by_id(lock, source_id)
                if commit and not write_revision_file(
                    staged_runtime_site, language, commit
                ):
                    ok = False
                    continue
                if not install_query_language(
                    repository,
                    lock,
                    staged_runtime_site,
                    language,
                    parser_data,
                    revision_name=None,
                ):
                    ok = False
                query_data = query_dependency_data(parser_data)
                for query_language in sequence_strings(
                    parser_data.get("queryDependencies")
                ):
                    if not install_query_language(
                        repository,
                        lock,
                        staged_runtime_site,
                        query_language,
                        query_data,
                        revision_name=query_language,
                    ):
                        ok = False

        if not install_supplemental_query_groups(repository, lock, staged_runtime_site):
            ok = False
        signature = treesitter_runtime_signature(
            parser_extension(),
            tree_sitter_cli_version_text(tree_sitter, env, repository),
        )
        if not write_treesitter_runtime_signature(staged_runtime_site, signature):
            ok = False
        if not ok:
            return False

        if not publish_runtime_subdirectories(
            runtime_site, staged_runtime_site, ("parser", "queries", "state")
        ):
            return False

    return True


def install_query_language(
    repository: str,
    lock: JSONMapping,
    runtime_site: str,
    language: str,
    parser_data: JSONMapping,
    revision_name: Optional[str],
) -> bool:
    resolved = query_source_path(repository, lock, language, parser_data)
    if resolved is None:
        return False
    source_id, source_dir = resolved
    destination = os.path.join(runtime_site, "queries", language)
    if not copy_query_dir(source_dir, destination):
        return False
    if not normalize_installed_query_dir(source_id, language, destination):
        return False
    commit = source_commit_by_id(lock, source_id)
    if (
        revision_name is not None
        and commit
        and not write_revision_file(runtime_site, revision_name, commit)
    ):
        return False
    parser_source_id = parser_data.get("source")
    if (
        isinstance(parser_source_id, str)
        and parser_source_id != source_id
        and commit
        and not write_revision_file(runtime_site, language + ".query", commit)
    ):
        return False
    return True


def treesitter_runtime_state_ok(
    repository: str,
    lock: JSONMapping,
    emit_warnings: bool,
    env: Optional[Mapping[str, str]] = None,
) -> bool:
    runtime_site = tree_sitter_runtime_site(repository, lock)
    if runtime_site is None:
        return False
    ok = treesitter_runtime_signature_ok(
        runtime_site, env, repository, emit_warnings=emit_warnings
    )
    languages = treesitter_languages(lock)
    for language, parser_data in sorted(languages.items()):
        parser_name = parser_data.get("parser", language)
        if not isinstance(parser_name, str):
            if emit_warnings:
                warn("invalid parser name for {0}".format(language))
            ok = False
            continue
        parser_path = os.path.join(
            runtime_site, "parser", parser_name + parser_extension()
        )
        if not os.path.isfile(parser_path):
            if emit_warnings:
                warn(
                    "Treesitter parser missing: {0}; run ./manage install".format(
                        parser_path
                    )
                )
            ok = False
        for query in required_queries(lock, parser_data):
            query_file = os.path.join(runtime_site, "queries", language, query + ".scm")
            if not os.path.isfile(query_file):
                if emit_warnings:
                    warn(
                        "Treesitter query missing: {0}; run ./manage install".format(
                            query_file
                        )
                    )
                ok = False
        source_id = parser_data.get("source")
        commit = (
            source_commit_by_id(lock, source_id) if isinstance(source_id, str) else None
        )
        revision = revision_file_path(runtime_site, language)
        if commit and read_text_file(revision) != commit:
            if emit_warnings:
                warn(
                    "Treesitter revision mismatch for {0}; run ./manage install".format(
                        language
                    )
                )
            ok = False
        resolved_query_source = query_source_path(
            repository, lock, language, parser_data
        )
        if resolved_query_source is None:
            ok = False
        else:
            query_source_id, _ = resolved_query_source
            query_commit = source_commit_by_id(lock, query_source_id)
            if (
                query_commit
                and isinstance(source_id, str)
                and query_source_id != source_id
                and read_text_file(
                    revision_file_path(runtime_site, language + ".query")
                )
                != query_commit
            ):
                if emit_warnings:
                    warn(
                        "Treesitter query revision mismatch for {0}; run ./manage install".format(
                            language
                        )
                    )
                ok = False
        query_data = query_dependency_data(parser_data)
        for query_language in sequence_strings(parser_data.get("queryDependencies")):
            query_dir = os.path.join(runtime_site, "queries", query_language)
            if not os.path.isdir(query_dir):
                if emit_warnings:
                    warn(
                        "Treesitter query dependency missing: {0}; run ./manage install".format(
                            query_dir
                        )
                    )
                ok = False
                continue
            resolved_dependency_source = query_source_path(
                repository, lock, query_language, query_data
            )
            if resolved_dependency_source is None:
                ok = False
                continue
            query_source_id, _ = resolved_dependency_source
            query_commit = source_commit_by_id(lock, query_source_id)
            if (
                query_commit
                and read_text_file(revision_file_path(runtime_site, query_language))
                != query_commit
            ):
                if emit_warnings:
                    warn(
                        "Treesitter query dependency revision mismatch for {0}; run ./manage install".format(
                            query_language
                        )
                    )
                ok = False

    for group in supplemental_query_groups(lock):
        for language in supplemental_query_languages(group):
            resolved = supplemental_query_source_path(repository, lock, group, language)
            if resolved is None:
                ok = False
                continue
            source_id, group_name, _ = resolved
            query_file = os.path.join(
                runtime_site, "queries", language, group_name + ".scm"
            )
            if not os.path.isfile(query_file):
                if emit_warnings:
                    warn(
                        "supplemental Treesitter query missing: {0}; run ./manage install".format(
                            query_file
                        )
                    )
                ok = False
            commit = source_commit_by_id(lock, source_id)
            revision = revision_file_path(runtime_site, language + "." + group_name)
            if commit and read_text_file(revision) != commit:
                if emit_warnings:
                    warn(
                        "supplemental Treesitter query revision mismatch for {0}/{1}; run ./manage install".format(
                            language, group_name
                        )
                    )
                ok = False
    return ok


