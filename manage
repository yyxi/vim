    path = source_subpath(source_root, normalized_query_path)
    return (source_id, group_name, path) if path is not None else None


def remove_path(path: str) -> bool:
    try:
        if os.path.islink(path) or os.path.isfile(path):
            os.unlink(path)
        elif os.path.isdir(path):
            shutil.rmtree(path)
    except OSError as exc:
        warn("unable to remove {0}: {1}".format(path, exc))
        return False
    return True


def publish_directories(pairs: Sequence[tuple[str, str]]) -> bool:
    """Publish an owned set of directories, retaining backups if recovery fails."""
    for target, staged in pairs:
        if not os.path.isdir(staged) or path_within_repository(target, staged):
            warn("invalid publication staging directory: {0}".format(staged))
            return False
    backups: list[tuple[str, str]] = []
    published: list[str] = []
    try:
        for target, _ in pairs:
            if os.path.lexists(target):
                backup = target + ".previous.{0}.{1}".format(
                    os.getpid(), time.time_ns()
                )
                os.rename(target, backup)
                backups.append((target, backup))
        for target, staged in pairs:
            os.rename(staged, target)
            published.append(target)
    except OSError as exc:
        warn("unable to publish directories: {0}".format(exc))
        for target in reversed(published):
            if not remove_path(target):
                warn("unable to clear published path during recovery: " + target)
        for target, backup in reversed(backups):
            try:
                os.rename(backup, target)
            except OSError as restore_error:
                warn(
                    "recovery failed for {0}: {1}; previous contents remain at {2}".format(
                        target, restore_error, backup
                    )
                )
        return False
    cleaned = [remove_path(backup) for _, backup in backups]
    return all(cleaned)


def replace_directory(destination: str, staged: str) -> bool:
    return publish_directories([(destination, staged)])


